+
+// fast CSV scan of the two graph files: only the named columns are kept
+namespace {
+struct Cols
+{
+  std::vector<int> want;   // column index per requested name
+  int maxc = 0;
+};
+Cols header_cols(const std::string& hdr, const std::vector<std::string>& names, const std::string& path)
+{
+  auto h = split_csv_line(hdr, ',');
+  Cols c;
+  for (auto& n : names) {
+    auto it = std::find(h.begin(), h.end(), n);
+    if (it == h.end()) fail("missing column " + n + " in " + path);
+    c.want.push_back((int) (it - h.begin()));
+    c.maxc = std::max(c.maxc, (int) (it - h.begin()));
+  }
+  return c;
+}
+// split a line into fields up to column maxc (pointers); returns the field count found
+int split_fields(char* line, std::vector<std::pair<const char*, const char*>>& f, int maxc)
+{
+  f.clear();
+  char* p = line;
+  while ((int) f.size() <= maxc) {
+    char* c = std::strchr(p, ',');
+    f.emplace_back(p, c ? c : p + std::strlen(p));
+    if (!c) break;
+    p = c + 1;
+  }
+  return (int) f.size();
+}
+double num_field(const std::pair<const char*, const char*>& f)
+{
+  std::string s(f.first, f.second);
+  return to_double(strip(s));
+}
+int intern(Graph& g, const std::pair<const char*, const char*>& f)
+{
+  std::string s(f.first, f.second);
+  auto it = g.id.find(s);
+  if (it != g.id.end()) return it->second;
+  int k = (int) g.names.size();
+  g.id.emplace(s, k);
+  g.names.push_back(std::move(s));
+  return k;
+}
