+      if (!(lv1 && sta_->isIdealClock(pin))) {
+        float capv;
+        sta_->checkCapacitance(pin, corner, sta::MinMax::max(), c1, rf, capv, limit, slack);
+        if (!sta::fuzzyInf(slack) && slack < 0.0) {
+          ++c[1];
+        }
+      }
+      if (!(dv1 && sta_->isIdealClock(pin))) {
+        float fanout;
+        sta_->checkFanout(pin, sta::MinMax::max(), fanout, limit, slack);
+        if (!sta::fuzzyInf(slack) && slack < 0.0) {
+          ++c[2];
+        }
+      }
+    }
+    delete it;
+    return c;
+  }
+  // Compare every vertex slew with the snapshot; return the nets of the pins
+  // that changed and refresh the snapshot.
+  void slewDirty(std::unordered_set<odb::dbNet*>& dirty)
+  {
+    sta::Graph* graph = sta_->graph();
+    const size_t sc = graph->slewCount();
+    sta::VertexIterator vi(graph);
+    while (vi.hasNext()) {
+      sta::Vertex* v = vi.next();
+      const size_t id = graph->id(v);
+      if ((id + 1) * sc > slewSnap_.size()) {
+        slewSnap_.resize((id + 1) * sc + 1024 * sc, std::numeric_limits<float>::quiet_NaN());
+      }
+      const sta::Slew* s = v->slews();
+      float* snap = &slewSnap_[id * sc];
+      bool same = s != nullptr;
+      if (s != nullptr) {
+        same = std::memcmp(s, snap, sc * sizeof(float)) == 0;
+        if (!same) {
+          std::memcpy(snap, s, sc * sizeof(float));
+        }
+      } else {
+        for (size_t i = 0; i < sc; ++i) {
+          snap[i] = std::numeric_limits<float>::quiet_NaN();
+        }
+      }
+      if (!same) {
+        odb::dbNet* net = netOfPin(v->pin());
+        if (net != nullptr) {
+          dirty.insert(net);
+        }
+      }
+    }
+  }
+  void initLimits(int slew, int cap, int fo)
+  {
+    netCnt_.clear();
+    tot_ = {0, 0, 0};
+    for (odb::dbNet* net : block_->getNets()) {
+      if (net->getSigType().isSupply()) {
+        continue;
+      }
+      const std::array<int, 3> c = netCounts(net);
+      if (c[0] || c[1] || c[2]) {
+        netCnt_[net] = c;
+      }
+      for (int k = 0; k < 3; ++k) {
+        tot_[k] += c[k];
+      }
+    }
+    const std::array<int, 3> p = portCounts();
+    std::unordered_set<odb::dbNet*> dummy;
+    slewDirty(dummy);
+    limDirty_.clear();
+    limInit_ = true;
+    if (tot_[0] + p[0] != slew || tot_[1] + p[1] != cap || tot_[2] + p[2] != fo) {
+      limBroken_ = true;
+      logger_->warn(utl::CTS, 999,
+                    "SelEval: per-net violator counts {}/{}/{} (+ports {}/{}/{}) do not add up "
+                    "to the whole-design counts {}/{}/{}; fast counts disabled",
+                    tot_[0], tot_[1], tot_[2], p[0], p[1], p[2], slew, cap, fo);
+    }
+  }
+  void fastLimits(int& slew, int& cap, int& fo)
+  {
+    // Bring timing up to date exactly as the whole-design checks would.
+    sta_->checkSlewLimitPreamble();
+    std::unordered_set<odb::dbNet*> dirty;
+    slewDirty(dirty);
+    t.slewDirtyNets += dirty.size();
+    dirty.insert(limDirty_.begin(), limDirty_.end());
+    limDirty_.clear();
+    for (odb::dbNet* net : dirty) {
+      std::array<int, 3> old{0, 0, 0};
+      auto it = netCnt_.find(net);
+      if (it != netCnt_.end()) {
+        old = it->second;
+      }
+      const std::array<int, 3> c = netCounts(net);
+      for (int k = 0; k < 3; ++k) {
+        tot_[k] += c[k] - old[k];
+      }
+      if (c[0] || c[1] || c[2]) {
+        netCnt_[net] = c;
+      } else if (it != netCnt_.end()) {
+        netCnt_.erase(it);
+      }
+    }
+    t.limitNets += dirty.size();
+    const std::array<int, 3> p = portCounts();
+    slew = tot_[0] + p[0];
+    cap = tot_[1] + p[1];
+    fo = tot_[2] + p[2];
+  }
+
+  sta::dbSta* sta_;
+  sta::dbNetwork* network_;
+  est::EstimateParasitics* est_;
+  utl::Logger* logger_;
+  odb::dbBlock* block_ = nullptr;
+  bool haveFull_ = false, enabledHere_ = false;
+  std::unordered_set<odb::dbNet*> touched_, limDirty_;
+  size_t lastTouched_ = 0;
+  std::string lastMode_ = "full", label_;
+  Timers t0_;
+  int evalId_ = 0;
+  std::ofstream evalCsv_;
+  bool limInit_ = false, limBroken_ = false;
+  std::unordered_map<odb::dbNet*, std::array<int, 3>> netCnt_;
+  std::array<int, 3> tot_{0, 0, 0};
+  std::vector<float> slewSnap_;
+};
+
+}  // namespace sel
+}  // namespace cts
