+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2019-2025, The OpenROAD Authors
+//
+// Tier data of a two-tier (face-to-face) design: tier of every instance
+// (from the master name suffix), tier-specific buffer masters, dominant tier
+// of a set of sinks, hybrid-bond parasitics and the LP skew targets.
+
+#include "Cts3DDatabase.h"
+
+#include <cmath>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#include "utl/Logger.h"
+
+namespace cts {
+
+using utl::CTS;
+
+// Returned for out-of-range tier queries.
+const std::vector<odb::dbInst*> Cts3DDatabase::emptyInstVec_;
+
+Cts3DDatabase::Cts3DDatabase(odb::dbDatabase* db, utl::Logger* logger)
+    : db_(db), logger_(logger)
+{
+}
+
+// Assigns a tier to every instance from its master name suffix.
+void Cts3DDatabase::populate()
+{
+  instTierMap_.clear();
+  instsPerTier_[0].clear();
+  instsPerTier_[1].clear();
+
+  odb::dbChip* chip = db_->getChip();
+  if (chip == nullptr) {
+    logger_->warn(CTS, 350, "Cts3DDatabase: no chip found, skipping populate");
+    return;
+  }
+  odb::dbBlock* block = chip->getBlock();
+  if (block == nullptr) {
+    logger_->warn(CTS, 351, "Cts3DDatabase: no block found, skipping populate");
+    return;
+  }
+
+  int upperCount = 0;
+  int bottomCount = 0;
+
+  // Instance count and first master name (log only).
+  int totalInsts = 0;
+  std::string firstMasterName = "(none)";
+  for (odb::dbInst* inst : block->getInsts()) {
+    ++totalInsts;
+    if (totalInsts == 1 && inst->getMaster() != nullptr) {
+      firstMasterName = inst->getMaster()->getName();
+    }
+  }
+  logger_->info(CTS, 357,
+                "Cts3DDatabase::populate debug: block has {} insts, first master='{}'",
+                totalInsts, firstMasterName);
+
+  for (odb::dbInst* inst : block->getInsts()) {
+    odb::dbMaster* master = inst->getMaster();
+    if (master == nullptr) {
+      continue;
+    }
+    const std::string masterName = master->getName();
+    int tier = tierFromMasterName(masterName);
+
+    // The tier is taken only from the master name; every cell of the 3D
+    // platforms (standard cells and macros) has an _upper or _bottom suffix.
+    if (tier < 0) {
+      debugPrint(logger_, CTS, "3DDB", 1,
+          "Instance '{}' master '{}' has no tier suffix, skipping",
+          inst->getName(), masterName);
+    }
+
+    if (tier >= 0) {
+      instTierMap_[inst] = tier;
+      instsPerTier_[tier].push_back(inst);
+      if (tier == 0) {
+        bottomCount++;
+      } else {
+        upperCount++;
+      }
+    }
+  }
+
+  logger_->info(CTS, 352,
+                "Cts3DDatabase populated: bottom={}, upper={}, total={}",
+                bottomCount, upperCount, bottomCount + upperCount);
+
+  loadHybridBondParasitics();
+}
+
+// Hybrid-bond parasitics from the technology.
+// R: hb_layer RESISTANCE (ohms per cut for a CUT layer); default 0.02 ohm.
+// C: LEF defines no capacitance for a CUT layer, so C = 0 and the via delay
+//    0.693 * R * C is 0.
+void Cts3DDatabase::loadHybridBondParasitics()
+{
+  const double DEFAULT_HB_RES = 0.02;       // ohms per cut
+  const double DEFAULT_HB_CAP = 0.0;        // F (no LEF capacitance for CUT layers)
+
+  odb::dbTech* tech = db_->getTech();
+  if (tech == nullptr) {
+    logger_->warn(CTS, 358,
+                  "No tech found. Using defaults: R={:.4f}Ω, C=0 (not in tech LEF)",
+                  DEFAULT_HB_RES);
+    hbtRes_ = DEFAULT_HB_RES;
+    hbtCap_ = DEFAULT_HB_CAP;
+    return;
+  }
+
+  // hb_layer (TYPE CUT) of the technology.
+  odb::dbTechLayer* hb_layer = nullptr;
+  for (odb::dbTechLayer* layer : tech->getLayers()) {
+    if (layer->getName() == "hb_layer") {
+      hb_layer = layer;
+      break;
+    }
+  }
+
+  if (hb_layer == nullptr) {
+    logger_->warn(CTS, 360,
+                  "HB layer 'hb_layer' not found in tech LEF. "
+                  "Using defaults: R={:.4f}Ω, C=0. "
+                  "Add 'LAYER hb_layer' with RESISTANCE to tech LEF.",
+                  DEFAULT_HB_RES);
+    hbtRes_ = DEFAULT_HB_RES;
+    hbtCap_ = DEFAULT_HB_CAP;
+    return;
+  }
+
+  // dbTechLayer::getResistance() is in ohms per cut for a CUT layer.
+  hbtRes_ = hb_layer->getResistance();
+  if (hbtRes_ <= 0.0) {
+    logger_->warn(CTS, 544,
+                  "hb_layer RESISTANCE={:.4f} invalid, using default {:.4f}Ω",
+                  hbtRes_, DEFAULT_HB_RES);
+    hbtRes_ = DEFAULT_HB_RES;
+  }
+
+  hbtCap_ = DEFAULT_HB_CAP;
+
+  // Elmore 50% delay: t_via = 0.693 * R * C
+  const double t_via_s = 0.693 * hbtRes_ * hbtCap_;
+  logger_->info(CTS, 359,
+                "HB parasitic loaded: R={:.4f}Ω (tech LEF), C=0F (not in LEF), "
+                "t_via={:.3e}s (0.693*R*C, negligible)",
+                hbtRes_, t_via_s);
+}
+
+int Cts3DDatabase::getInstTier(odb::dbInst* inst) const
+{
+  if (inst == nullptr) {
+    return -1;
+  }
+  auto it = instTierMap_.find(inst);
+  if (it != instTierMap_.end()) {
+    return it->second;
+  }
+  // Not in the map: tier unknown.
+  return -1;
+}
+
+const std::vector<odb::dbInst*>& Cts3DDatabase::getInstancesOnTier(
+    int tier) const
+{
+  if (tier < 0 || tier > 1) {
+    return emptyInstVec_;
+  }
+  return instsPerTier_[tier];
+}
+
+// Tier-specific variant of a buffer master (explicit pair first, then
+// _bottom/_upper suffix substitution; the base master if none exists).
+std::string Cts3DDatabase::getBufferForTier(const std::string& baseMaster,
+                                            int targetTier) const
+{
+  if (targetTier != 0 && targetTier != 1) {
+    return baseMaster;
+  }
+  if (db_ == nullptr || baseMaster.empty()) {
+    return baseMaster;
+  }
+
+  // Explicit bottom/upper pair first: needed when the two tiers use cells
+  // whose base names differ (two technologies).
+  if (!bottomBufName_.empty() && !upperBufName_.empty()) {
+    if (targetTier == 1 && baseMaster == bottomBufName_) {
+      return upperBufName_;
+    }
+    if (targetTier == 0 && baseMaster == upperBufName_) {
+      return bottomBufName_;
+    }
+  }
+
+  // Suffix-based substitution fallback (works for same-family cells).
+  std::string candidate = baseMaster;
+  if (targetTier == 1) {
+    if (hasSuffix(baseMaster, "_bottom")) {
+      candidate = baseMaster.substr(0, baseMaster.size() - 7) + "_upper";
+    } else if (!hasSuffix(baseMaster, "_upper")) {
+      candidate = baseMaster + "_upper";
+    }
+  } else {
+    if (hasSuffix(baseMaster, "_upper")) {
+      candidate = baseMaster.substr(0, baseMaster.size() - 6) + "_bottom";
+    } else if (!hasSuffix(baseMaster, "_bottom")) {
+      candidate = baseMaster + "_bottom";
+    }
+  }
+
+  if (candidate == baseMaster) {
+    return baseMaster;
+  }
+
+  // Verify the tier-specific master exists in the database
+  if (db_->findMaster(candidate.c_str()) != nullptr) {
+    return candidate;
+  }
+
+  return baseMaster;
+}
+
+// Registers an explicit bottom/upper buffer pair for getBufferForTier() (two
+// technologies whose cell base names differ).
+void Cts3DDatabase::setTierBufferPair(const std::string& bottomBuf,
+                                      const std::string& upperBuf)
+{
+  bottomBufName_ = bottomBuf;
+  upperBufName_  = upperBuf;
+  logger_->info(CTS, 370,
+                "3D CTS tier buffer pair registered: bottom='{}', upper='{}'",
+                bottomBufName_, upperBufName_);
+}
+
+// Majority tier of a set of clock instances (-1 if none has a tier).
+int Cts3DDatabase::getDominantTier(
+    const std::vector<ClockInst*>& insts) const
+{
+  int tier0 = 0;
+  int tier1 = 0;
+  for (const ClockInst* inst : insts) {
+    if (inst == nullptr) {
+      continue;
+    }
+    odb::dbInst* db_inst = inst->getDbInst();
+    if (db_inst == nullptr) {
+      continue;
+    }
+    const int tier = getInstTier(db_inst);
+    if (tier == 0) {
+      tier0++;
+    } else if (tier == 1) {
+      tier1++;
+    }
+  }
+  if (tier0 == 0 && tier1 == 0) {
+    return -1;
+  }
+  return (tier1 > tier0) ? 1 : 0;
+}
+
+// Majority tier of the sinks at a set of locations (-1 if none has a tier).
+int Cts3DDatabase::getDominantTier(
+    const std::vector<Point<double>>& locs,
+    const std::map<Point<double>, ClockInst*>& locToSink) const
+{
+  int tier0 = 0;
+  int tier1 = 0;
+  for (const Point<double>& loc : locs) {
+    // The location may differ from the key by float narrowing: search
+    // within eps.
+    auto it = locToSink.find(loc);
+    if (it == locToSink.end()) {
+      constexpr double eps = 1e-4;
+      auto hint = locToSink.lower_bound(
+          Point<double>(loc.getX() - eps, loc.getY() - eps));
+      for (auto scan = hint; scan != locToSink.end(); ++scan) {
+        if (scan->first.getX() > loc.getX() + eps) break;
+        if (std::abs(scan->first.getX() - loc.getX()) < eps
+            && std::abs(scan->first.getY() - loc.getY()) < eps) {
+          it = scan;
+          break;
+        }
+      }
+      if (it == locToSink.end()) {
+        continue;
+      }
+    }
+    ClockInst* inst = it->second;
+    if (inst == nullptr) {
+      continue;
+    }
+    int tier = -1;
+    odb::dbInst* db_inst = inst->getDbInst();
+    if (db_inst != nullptr) {
+      tier = getInstTier(db_inst);
+    } else {
+      // Buffer not yet in the database: tier of the ClockInst.
+      tier = inst->getTier();
+    }
+    if (tier == 0) {
+      tier0++;
+    } else if (tier == 1) {
+      tier1++;
+    }
+  }
+  if (tier0 == 0 && tier1 == 0) {
+    return -1;
+  }
+  return (tier1 > tier0) ? 1 : 0;
+}
+
+// Majority tier of all sinks of a clock (-1 if none has a tier).
+int Cts3DDatabase::getDominantTierFromClock(const Clock& clock) const
+{
+  int tier0 = 0;
+  int tier1 = 0;
+  clock.forEachSink([&](const ClockInst& inst) {
+    odb::dbInst* db_inst = inst.getDbInst();
+    if (db_inst == nullptr) {
+      return;
+    }
+    const int tier = getInstTier(db_inst);
+    if (tier == 0) {
+      tier0++;
+    } else if (tier == 1) {
+      tier1++;
+    }
+  });
+  if (tier0 == 0 && tier1 == 0) {
+    return -1;
+  }
+  return (tier1 > tier0) ? 1 : 0;
+}
+
+// Records the tier of a CTS-created clock instance.
+void Cts3DDatabase::setClockInstTier(ClockInst& inst, int tier)
+{
+  inst.setTier(tier);
+}
+
+double Cts3DDatabase::getResPerDBU(int tier) const
+{
+  if (tier < 0 || tier > 1) {
+    return resPerDBU_[0];  // default to bottom tier
+  }
+  return resPerDBU_[tier];
+}
+
+double Cts3DDatabase::getCapPerDBU(int tier) const
+{
+  if (tier < 0 || tier > 1) {
+    return capPerDBU_[0];
+  }
+  return capPerDBU_[tier];
+}
+
+void Cts3DDatabase::setWireRC(int tier, double resPerDBU, double capPerDBU)
+{
+  if (tier >= 0 && tier <= 1) {
+    resPerDBU_[tier] = resPerDBU;
+    capPerDBU_[tier] = capPerDBU;
+  }
+}
+
+// Wire length with the same delay as a hybrid-bond via (R*C over the wire
+// r*c), or with the same resistance when no capacitance is available.
+double Cts3DDatabase::getHbtEquivalentDistance(double wireResPerUnit,
+                                               double wireCapPerUnit) const
+{
+  if (wireResPerUnit <= 0.0 || hbtRes_ <= 0.0) {
+    return 0.0;
+  }
+
+  // delay_HB = R_HB * C_HB and delay_wire ~ r * c * L^2, so
+  // L = sqrt(R_HB * C_HB / (r * c)).
+  if (hbtCap_ > 0.0 && wireCapPerUnit > 0.0) {
+    const double delay_hb = hbtRes_ * hbtCap_;
+    const double delay_wire_per_unit = wireResPerUnit * wireCapPerUnit;
+
+    return std::sqrt(delay_hb / delay_wire_per_unit);
+  }
+
+  // Resistance only: R_HB = r * L, so L = R_HB / r.
+  return hbtRes_ / wireResPerUnit;
+}
+
+// --- Pre-CTS skew targets ---
+
+double Cts3DDatabase::getSkewTarget(const std::string& ff_name) const
+{
+  auto it = skewTargetMap_.find(ff_name);
+  return (it != skewTargetMap_.end()) ? it->second : 0.0;
+}
+
+double Cts3DDatabase::getSkewTarget(odb::dbInst* inst) const
+{
+  if (inst == nullptr || skewTargetMap_.empty()) {
+    return 0.0;
+  }
+  return getSkewTarget(inst->getName());
+}
+
+// --- Private helpers ---
+
+int Cts3DDatabase::tierFromMasterName(const std::string& name)
+{
+  if (name.find("_upper") != std::string::npos) {
+    return 1;
+  }
+  if (name.find("_bottom") != std::string::npos) {
+    return 0;
+  }
+  return -1;
+}
+
+bool Cts3DDatabase::hasSuffix(const std::string& name,
+                              const std::string& suffix)
+{
+  if (name.size() < suffix.size()) {
+    return false;
+  }
+  return name.compare(name.size() - suffix.size(), suffix.size(), suffix) == 0;
+}
+
+}  // namespace cts
diff --git a/src/cts/src/Cts3DDatabase.h b/src/cts/src/Cts3DDatabase.h
new file mode 100644
index 0000000000..543e31b1d3
--- /dev/null
+++ b/src/cts/src/Cts3DDatabase.h
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2019-2025, The OpenROAD Authors
+//
+// Tier data of a two-tier (face-to-face) design used by the 3D clock tree
+// construction: instance tiers, tier-specific buffer masters, hybrid-bond
+// parasitics and the LP skew targets.
+
+#pragma once
+
+#include <array>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "Clock.h"
+#include "Util.h"
+#include "odb/db.h"
+#include "utl/Logger.h"
+
+namespace cts {
+
+class Cts3DDatabase
+{
+ public:
+  Cts3DDatabase(odb::dbDatabase* db, utl::Logger* logger);
+
+  // Assigns a tier to every instance of the block from its master name
+  // (_upper: tier 1, _bottom: tier 0).  Call once after the design is loaded.
+  void populate();
+
+  // Reads the hybrid-bond via resistance of hb_layer from the technology
+  // (LEF RESISTANCE, or the value set by set_layer_rc -via hb_layer).
+  void loadHybridBondParasitics();
+
+  // --- Instance tier queries ---
+
+  // Tier of an instance (cached; -1 if unknown).
+  int getInstTier(odb::dbInst* inst) const;
+
+  // All instances on a given tier (0 or 1).
+  const std::vector<odb::dbInst*>& getInstancesOnTier(int tier) const;
+
+  // --- Buffer master mapping ---
+
+  // Tier-specific variant of a buffer master.  The explicit bottom/upper pair
+  // set by setTierBufferPair() is checked first, then the _bottom/_upper
+  // suffix is substituted.  Examples:
+  //   pair ("BUF_X4_bottom", "BUF_X4_upper"): "BUF_X4_bottom", tier 1
+  //     gives "BUF_X4_upper";
+  //   no pair: "BUFx4_ASAP7_75t_R_bottom", tier 1 gives
+  //     "BUFx4_ASAP7_75t_R_upper".
+  std::string getBufferForTier(const std::string& baseMaster,
+                               int targetTier) const;
+
+  // Registers an explicit bottom/upper buffer pair, used when the cell names
+  // of the two tiers differ (two technologies).  Call after populate() and
+  // before tree building, e.g. setTierBufferPair("BUF_X4_bottom",
+  // "BUF_X4_upper").
+  void setTierBufferPair(const std::string& bottomBuf,
+                         const std::string& upperBuf);
+
+  // --- Dominant tier computation ---
+
+  // Majority tier of a set of clock instances.
+  int getDominantTier(const std::vector<ClockInst*>& insts) const;
+
+  // Majority tier of the sinks at a set of locations (location-to-sink map).
+  int getDominantTier(
+      const std::vector<Point<double>>& locs,
+      const std::map<Point<double>, ClockInst*>& locToSink) const;
+
+  // Majority tier of all sinks of a clock.
+  int getDominantTierFromClock(const Clock& clock) const;
+
+  // --- ClockInst tier management ---
+  // Sets the tier of a clock instance created during tree building (before
+  // it is written to the database).
+  void setClockInstTier(ClockInst& inst, int tier);
+
+  // --- Per-tier wire parasitics ---
+
+  double getResPerDBU(int tier) const;
+  double getCapPerDBU(int tier) const;
+  void setWireRC(int tier, double resPerDBU, double capPerDBU);
+
+  // --- Hybrid-bond (HBT) parasitics ---
+
+  double getHbtResistance() const { return hbtRes_; }
+  double getHbtCapacitance() const { return hbtCap_; }
+
+  // Wire length whose distributed RC delay equals the lumped RC delay of one
+  // hybrid-bond via: L = sqrt((R_HB * C_HB) / (r * c)); L = R_HB / r when no
+  // capacitance is available.  L is in the length unit of wireResPerUnit.
+  double getHbtEquivalentDistance(double wireResPerUnit,
+                                  double wireCapPerUnit) const;
+
+  // --- LP skew targets (set by the LP solver) ---
+  double getSkewTarget(const std::string& ff_name) const;
+  double getSkewTarget(odb::dbInst* inst) const;
+  bool hasSkewTargets() const { return !skewTargetMap_.empty(); }
+  int getSkewTargetCount() const
+  {
+    return static_cast<int>(skewTargetMap_.size());
+  }
+  const std::unordered_map<std::string, double>& getSkewTargetMap() const {
+    return skewTargetMap_;
+  }
+  void clearSkewTargets() { skewTargetMap_.clear(); }
+  void setSkewTarget(const std::string& ff_name, double arrival_ns)
+  {
+    skewTargetMap_[ff_name] = arrival_ns;
+  }
+
+ private:
+  // Tier from the master name (_upper: 1, _bottom: 0, else -1).
+  static int tierFromMasterName(const std::string& name);
+
+  static bool hasSuffix(const std::string& name, const std::string& suffix);
+
+  odb::dbDatabase* db_;
+  utl::Logger* logger_;
+
+  // Tier of every instance, filled by populate().
+  std::unordered_map<odb::dbInst*, int> instTierMap_;
+  std::array<std::vector<odb::dbInst*>, 2> instsPerTier_;
+  static const std::vector<odb::dbInst*> emptyInstVec_;
+
+  // Wire RC per tier.
+  std::array<double, 2> resPerDBU_ = {0.0, 0.0};
+  std::array<double, 2> capPerDBU_ = {0.0, 0.0};
+
+  // Explicit bottom/upper buffer pair (setTierBufferPair()); empty strings:
+  // suffix substitution only.
+  std::string bottomBufName_;
+  std::string upperBufName_;
+
+  // Face-to-face hybrid-bond via parasitics.
+  double hbtRes_ = 0.0;   // ohms
+  double hbtCap_ = 0.0;   // farads
+
+  // Pre-CTS skew targets: register instance name to target arrival offset (ns).
+  std::unordered_map<std::string, double> skewTargetMap_;
+};
+
+}  // namespace cts
diff --git a/src/cts/src/CtsSkewLpSolver.cpp b/src/cts/src/CtsSkewLpSolver.cpp
new file mode 100644
index 0000000000..b6e850359f
--- /dev/null
+++ b/src/cts/src/CtsSkewLpSolver.cpp
@@ -0,0 +1,974 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+// LP scheduling of per-register clock arrival targets with OR-Tools GLOP.
+// The formulation is described in CtsSkewLpSolver.h.
+
+#include "CtsSkewLpSolver.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <limits>
+#include <numeric>
+#include <sstream>
+#include <tuple>
+#include <unordered_set>
+
+#include "Cts3DDatabase.h"
+#include "odb/db.h"
+#include "ortools/linear_solver/linear_solver.h"
+#include "sta/Liberty.hh"
+#include "sta/Network.hh"
+#include "sta/Sta.hh"
+#include "utl/Logger.h"
+
+namespace cts {
+
+using operations_research::MPConstraint;
+using operations_research::MPObjective;
+using operations_research::MPSolver;
+using operations_research::MPVariable;
+
+// Log message IDs of the LP solver (CTS-600 series).
+constexpr int CTS_LP_START = 600;
+constexpr int CTS_LP_EDGES = 601;
+constexpr int CTS_LP_VARS = 602;
+constexpr int CTS_LP_RESULT = 603;
+constexpr int CTS_LP_TARGETS = 604;
+constexpr int CTS_LP_IO = 605;
+
+CtsSkewLpSolver::CtsSkewLpSolver(odb::dbBlock* block,
+                                 sta::dbSta* sta,
+                                 sta::dbNetwork* network,
+                                 utl::Logger* logger,
+                                 Cts3DDatabase* cts3dDb)
+    : block_(block),
+      sta_(sta),
+      network_(network),
+      logger_(logger),
+      cts3dDb_(cts3dDb)
+{
+}
+
+// Read the register -> register graph.  The extractor writes an admission
+// status file next to each graph; scheduling refuses a graph whose status is
+// missing or BLOCKED (unsupported timing relations were found).  A GUARDED
+// graph is accepted only together with an explicit STA guard manifest.
+void CtsSkewLpSolver::readTimingGraphCSV(const std::string& csv_path)
+{
+  logger_->info(utl::CTS,
+                CTS_LP_START,
+                "Skew LP: reading timing graph {}",
+                csv_path);
+
+  std::ifstream infile(csv_path);
+  if (!infile.is_open()) {
+    logger_->error(utl::CTS,
+                   CTS_LP_START + 1,
+                   "Skew LP: cannot open timing graph CSV: {}",
+                   csv_path);
+    return;
+  }
+
+  bool guarded_input = false;
+  for (const char* file : {"ff_admission.status", "io_admission.status"}) {
+    const auto slash = csv_path.find_last_of('/');
+    const std::string dir
+        = slash == std::string::npos ? "." : csv_path.substr(0, slash);
+    std::ifstream proof(dir + "/" + file);
+    std::string status;
+    std::getline(proof, status);
+    if (status == "GUARDED") {
+      guarded_input = true;
+    } else if (status != "VALID") {
+      logger_->error(utl::CTS,
+                     973,
+                     "Timing graph admission missing or blocked: {}/{}",
+                     dir,
+                     file);
+    }
+  }
+  if (guarded_input) {
+    const char* manifest = std::getenv("CTS_STA_GUARD_MANIFEST");
+    if (!manifest || !*manifest) {
+      logger_->error(utl::CTS,
+                     2023,
+                     "Guarded timing graph requires CTS_STA_GUARD_MANIFEST");
+    }
+    std::ifstream proof(manifest);
+    if (!proof.good() || proof.peek() == std::ifstream::traits_type::eof()) {
+      logger_->error(utl::CTS,
+                     2026,
+                     "STA guard manifest absent or empty: {}",
+                     manifest);
+    }
+    logger_->info(utl::CTS,
+                  2027,
+                  "STA-guarded constraints retained for physical admission: {}",
+                  manifest);
+  }
+  // Header: from_ff,to_ff,slack_max_ns,slack_min_ns,arrival_max_ns,
+  //         arrival_min_ns,required_max_ns,required_min_ns,from_x,from_y,
+  //         from_tier,to_x,to_y,to_tier[,from_clock_net,to_clock_net]
+  std::string header;
+  std::getline(infile, header);
+
+  struct RawEdge
+  {
+    std::string from_ff, to_ff;
+    float slack_max, slack_min, arrival_max, arrival_min;
+    int from_tier, to_tier;
+  };
+  std::vector<RawEdge> raw_edges;
+  std::unordered_set<std::string> ff_set;
+
+  // "inf" marks an unmeasured corner and is kept as infinity (the register
+  // stays in the LP universe, the corner yields no constraint).  Empty or NaN
+  // fields read as 0.
+  auto safe_stof = [](const std::string& s) -> float {
+    if (s.empty()) {
+      return 0.0f;
+    }
+    if (s == "inf" || s == "INF") {
+      return std::numeric_limits<float>::infinity();
+    }
+    if (s == "-inf" || s == "-INF") {
+      return -std::numeric_limits<float>::infinity();
+    }
+    if (s == "nan" || s == "NAN") {
+      return 0.0f;
+    }
+    try {
+      return std::stof(s);
+    } catch (...) {
+      return 0.0f;
+    }
+  };
+
+  std::string line;
+  while (std::getline(infile, line)) {
+    if (line.empty()) {
+      continue;
+    }
+    std::istringstream ss(line);
+    std::string token;
+    std::vector<std::string> fields;
+    while (std::getline(ss, token, ',')) {
+      fields.push_back(token);
+    }
+    if (fields.size() < 14) {
+      continue;
+    }
+    RawEdge e;
+    e.from_ff = fields[0];
+    e.to_ff = fields[1];
+    e.slack_max = safe_stof(fields[2]);
+    e.slack_min = safe_stof(fields[3]);
+    e.arrival_max = safe_stof(fields[4]);
+    e.arrival_min = safe_stof(fields[5]);
+    e.from_tier = std::stoi(fields[10]);
+    e.to_tier = std::stoi(fields[13]);
+    raw_edges.push_back(e);
+  }
+
+  // Every endpoint of every row (identity rows included) is an LP register.
+  edges_.clear();
+  for (const auto& e : raw_edges) {
+    ff_set.insert(e.from_ff);
+    ff_set.insert(e.to_ff);
+  }
+
+  ff_list_.assign(ff_set.begin(), ff_set.end());
+  std::sort(ff_list_.begin(), ff_list_.end());
+  ff_to_idx_.clear();
+  for (int i = 0; i < static_cast<int>(ff_list_.size()); ++i) {
+    ff_to_idx_[ff_list_[i]] = i;
+  }
+
+  ff_tiers_.resize(ff_list_.size(), 0);
+  for (const auto& e : raw_edges) {
+    auto it = ff_to_idx_.find(e.from_ff);
+    if (it != ff_to_idx_.end()) {
+      ff_tiers_[it->second] = e.from_tier;
+    }
+    it = ff_to_idx_.find(e.to_ff);
+    if (it != ff_to_idx_.end()) {
+      ff_tiers_[it->second] = e.to_tier;
+    }
+  }
+
+  // One LP edge per row.  An infinite corner was never measured; only that
+  // corner is skipped later (setup_ghost / hold_ghost), the other one is kept.
+  for (const auto& e : raw_edges) {
+    auto it_i = ff_to_idx_.find(e.from_ff);
+    auto it_j = ff_to_idx_.find(e.to_ff);
+    if (it_i == ff_to_idx_.end() || it_j == ff_to_idx_.end()) {
+      continue;
+    }
+    LpTimingEdge le;
+    le.from_idx = it_i->second;
+    le.to_idx = it_j->second;
+    le.slack_setup_ns = e.slack_max;
+    le.slack_hold_ns = e.slack_min;
+    le.cross_tier = (e.from_tier != e.to_tier);
+    le.hold_ghost = !std::isfinite(e.slack_min);
+    le.setup_ghost = !std::isfinite(e.slack_max);
+    edges_.push_back(le);
+  }
+
+  logger_->info(utl::CTS,
+                CTS_LP_EDGES,
+                "Skew LP: {} registers, {} edges ({} cross-tier)",
+                ff_list_.size(),
+                edges_.size(),
+                std::count_if(
+                    edges_.begin(), edges_.end(), [](const LpTimingEdge& e) {
+                      return e.cross_tier;
+                    }));
+}
+
+// Read the IO edges.  Header: edge_type,port_name,ff_name,slack_setup_ns,
+// slack_hold_ns[,ff_clock_net].  A row may carry only one of the two slacks.
+void CtsSkewLpSolver::readIOEdgesCSV(const std::string& io_csv_path)
+{
+  io_edges_.clear();
+
+  if (io_csv_path.empty()) {
+    logger_->info(utl::CTS, CTS_LP_IO, "Skew LP: IO edges: 0 (no IO CSV path)");
+    return;
+  }
+
+  std::ifstream infile(io_csv_path);
+  if (!infile.is_open()) {
+    logger_->warn(utl::CTS,
+                  CTS_LP_IO,
+                  "Skew LP: cannot open IO CSV {}; IO edges skipped",
+                  io_csv_path);
+    return;
+  }
+
+  std::string header;
+  std::getline(infile, header);
+
+  // Empty, infinite or NaN fields mean "no path for this corner".
+  auto safe_stof_io = [](const std::string& s) -> std::pair<bool, float> {
+    if (s.empty()) {
+      return {false, 0.0f};
+    }
+    if (s == "inf" || s == "INF" || s == "-inf" || s == "-INF" || s == "nan"
+        || s == "NAN") {
+      return {false, 0.0f};
+    }
+    try {
+      return {true, std::stof(s)};
+    } catch (...) {
+      return {false, 0.0f};
+    }
+  };
+
+  std::string line;
+  while (std::getline(infile, line)) {
+    if (line.empty()) {
+      continue;
+    }
+    std::istringstream ss(line);
+    std::string token;
+    std::vector<std::string> fields;
+    while (std::getline(ss, token, ',')) {
+      fields.push_back(token);
+    }
+    if (fields.size() < 5) {
+      continue;
+    }
+
+    const std::string& edge_type = fields[0];
+    const std::string& ff_name = fields[2];
+
+    auto [valid_setup, slack_setup] = safe_stof_io(fields[3]);
+    auto [valid_hold, slack_hold] = safe_stof_io(fields[4]);
+    if (!valid_setup && !valid_hold) {
+      continue;
+    }
+
+    auto it = ff_to_idx_.find(ff_name);
+    if (it == ff_to_idx_.end()) {
+      continue;
+    }
+
+    if (edge_type == "PI_TO_FF") {
+      if (valid_hold) {
+        LpIOEdge le;
+        le.ff_idx = it->second;
+        le.slack_ns = slack_hold;
+        le.type = LpIOEdge::PI_HOLD;
+        io_edges_.push_back(le);
+      }
+      if (valid_setup) {
+        LpIOEdge le2;
+        le2.ff_idx = it->second;
+        le2.slack_ns = slack_setup;
+        le2.type = LpIOEdge::PI_SETUP;
+        io_edges_.push_back(le2);
+      }
+    } else if (edge_type == "FF_TO_PO") {
+      if (valid_setup) {
+        LpIOEdge le;
+        le.ff_idx = it->second;
+        le.slack_ns = slack_setup;
+        le.type = LpIOEdge::PO_SETUP;
+        io_edges_.push_back(le);
+      }
+      if (valid_hold) {
+        LpIOEdge le2;
+        le2.ff_idx = it->second;
+        le2.slack_ns = slack_hold;
+        le2.type = LpIOEdge::PO_HOLD;
+        io_edges_.push_back(le2);
+      }
+    }
+  }
+
+  int n_pi_hold = 0, n_pi_setup = 0, n_po_setup = 0, n_po_hold = 0;
+  for (const auto& io : io_edges_) {
+    switch (io.type) {
+      case LpIOEdge::PI_HOLD:
+        ++n_pi_hold;
+        break;
+      case LpIOEdge::PI_SETUP:
+        ++n_pi_setup;
+        break;
+      case LpIOEdge::PO_SETUP:
+        ++n_po_setup;
+        break;
+      case LpIOEdge::PO_HOLD:
+        ++n_po_hold;
+        break;
+    }
+  }
+  logger_->info(utl::CTS,
+                CTS_LP_IO,
+                "Skew LP: IO edges: {} total (pi_hold:{} pi_setup:{} "
+                "po_setup:{} po_hold:{})",
+                io_edges_.size(),
+                n_pi_hold,
+                n_pi_setup,
+                n_po_setup,
+                n_po_hold);
+}
+
+// t_max_i = max_skew.  CTS_LP_INCREMENTAL_BOUNDS_CSV (ff_name,bound_ns, one row
+// per LP register) tightens it further, e.g. to 0 for registers whose clock
+// cannot be delayed by the delivery structure.
+void CtsSkewLpSolver::computeBounds()
+{
+  const int n_ffs = static_cast<int>(ff_list_.size());
+  t_max_.resize(n_ffs, params_.max_skew);
+
+  if (const char* path = std::getenv("CTS_LP_INCREMENTAL_BOUNDS_CSV")) {
+    std::ifstream in(path);
+    if (!in) {
+      logger_->error(utl::CTS, 2014, "Cannot read incremental bounds {}", path);
+    }
+    std::unordered_map<std::string, float> bounds;
+    std::string line;
+    std::getline(in, line);
+    while (std::getline(in, line)) {
+      auto c = line.find(',');
+      if (c == std::string::npos) {
+        continue;
+      }
+      float val = std::stof(line.substr(c + 1));
+      if (!std::isfinite(val) || val < 0) {
+        logger_->error(utl::CTS, 2016, "Invalid incremental bound");
+      }
+      bounds[line.substr(0, c)] = val;
+    }
+    int movable = 0;
+    for (int i = 0; i < n_ffs; ++i) {
+      if (!bounds.count(ff_list_[i])) {
+        logger_->error(
+            utl::CTS, 2018, "Missing incremental bound for {}", ff_list_[i]);
+      }
+      t_max_[i] = std::min(t_max_[i], bounds.at(ff_list_[i]));
+      movable += t_max_[i] > 0;
+    }
+    logger_->info(utl::CTS,
+                  2019,
+                  "Skew LP: incremental bounds: {}/{} registers movable",
+                  movable,
+                  n_ffs);
+  }
+
+  logger_->info(utl::CTS,
+                CTS_LP_IO + 2,
+                "Skew LP: bounds: {} registers, t_max={:.1f}ps",
+                n_ffs,
+                params_.max_skew * 1e3);
+}
+
+// For every input port -> register hold (or removal) edge:
+//   slack <= 0 : t_max = 0 (the capture clock must not move later)
+//   slack  > 0 : t_max = min(t_max, slack - sigma_pi)
+void CtsSkewLpSolver::applyPiHoldClip()
+{
+  int n_zeroed = 0;
+  int n_clipped = 0;
+  for (const auto& io : io_edges_) {
+    if (io.type != LpIOEdge::PI_HOLD) {
+      continue;
+    }
+    int idx = io.ff_idx;
+    if (idx < 0 || idx >= static_cast<int>(t_max_.size())) {
+      continue;
+    }
+    float slack = io.slack_ns;
+    if (slack <= 0) {
+      t_max_[idx] = 0.0f;
+      ++n_zeroed;
+    } else {
+      float clipped = std::max(0.0f, slack - params_.sigma_pi);
+      if (clipped < t_max_[idx]) {
+        t_max_[idx] = clipped;
+        ++n_clipped;
+      }
+    }
+  }
+
+  if (n_zeroed > 0 || n_clipped > 0) {
+    logger_->info(utl::CTS,
+                  CTS_LP_IO + 1,
+                  "Skew LP: PI-hold-clip: {} zeroed, {} clipped "
+                  "(sigma_pi={:.1f}ps)",
+                  n_zeroed,
+                  n_clipped,
+                  params_.sigma_pi * 1e3);
+  }
+}
+
+LpResult CtsSkewLpSolver::solveTns()
+{
+  const int n_ffs = static_cast<int>(ff_list_.size());
+  if (n_ffs == 0) {
+    result_.status = "no_ffs";
+    return result_;
+  }
+
+  const float sigma = params_.sigma_local;
+
+  // Effective slacks (both registers contribute sigma).
+  struct SetupEdge
+  {
+    int i;
+    int j;
+    float eff_slack;
+  };
+  struct HoldEdge
+  {
+    int i;
+    int j;
+    float eff_slack;
+  };
+
+  std::vector<SetupEdge> setup_edges;
+  std::vector<HoldEdge> hold_edges;
+
+  int n_hold_ghost = 0;
+  int n_setup_ghost = 0;
+  for (const auto& e : edges_) {
+    // An unmeasured corner gives no constraint; the other corner is kept.
+    if (e.setup_ghost) {
+      ++n_setup_ghost;
+    } else {
+      float eff_setup = e.slack_setup_ns - 2.0f * sigma;
+      setup_edges.push_back({e.from_idx, e.to_idx, eff_setup});
+    }
+    if (e.hold_ghost) {
+      ++n_hold_ghost;
+      continue;
+    }
+    float eff_hold = e.slack_hold_ns - 2.0f * sigma;
+    hold_edges.push_back({e.from_idx, e.to_idx, eff_hold});
+  }
+
+  logger_->info(utl::CTS,
+                969,
+                "Skew LP: unmeasured corners / identity rows: setup {} hold "
+                "{}; coverage is governed by the admission status",
+                n_setup_ghost,
+                n_hold_ghost);
+
+  int n_neg_setup
+      = std::count_if(setup_edges.begin(),
+                      setup_edges.end(),
+                      [](const SetupEdge& e) { return e.eff_slack < 0; });
+
+  logger_->info(utl::CTS,
+                CTS_LP_VARS,
+                "Skew LP: {} setup edges ({} violating, {} with unmeasured "
+                "setup corner), {} hold edges",
+                setup_edges.size(),
+                n_neg_setup,
+                n_setup_ghost,
+                hold_edges.size());
+
+  if (n_neg_setup == 0) {
+    // No setup violation: every target is 0.
+    result_.status = "no_violations";
+    for (const auto& ff : ff_list_) {
+      result_.arrivals[ff] = 0.0;
+    }
+    result_.n_ffs = n_ffs;
+    return result_;
+  }
+
+  // A setup edge whose slack exceeds t_max_i + t_max_j can never be violated.
+  struct PrunedSetup
+  {
+    int i;
+    int j;
+    float eff_slack;
+  };
+  std::vector<PrunedSetup> pruned_setup;
+  for (const auto& e : setup_edges) {
+    if (e.eff_slack <= t_max_[e.i] + t_max_[e.j]) {
+      pruned_setup.push_back({e.i, e.j, e.eff_slack});
+    }
+  }
+
+  // Input-port hold edges are hard (with a bounded residual); every other IO
+  // edge is a soft constraint.
+  std::vector<std::tuple<int, float, LpIOEdge::Type>> hard_io;
+  std::vector<std::tuple<int, float, LpIOEdge::Type>> soft_io;
+  for (const auto& io : io_edges_) {
+    if (io.type == LpIOEdge::PI_HOLD) {
+      hard_io.emplace_back(io.ff_idx, io.slack_ns, io.type);
+    } else {
+      soft_io.emplace_back(io.ff_idx, io.slack_ns, io.type);
+    }
+  }
+  logger_->info(utl::CTS,
+                CTS_LP_IO,
+                "Skew LP: {} hard IO constraints, {} soft IO constraints",
+                static_cast<int>(hard_io.size()),
+                static_cast<int>(soft_io.size()));
+  const int n_io_soft = static_cast<int>(soft_io.size());
+
+  std::unique_ptr<MPSolver> solver(MPSolver::CreateSolver("GLOP"));
+  if (!solver) {
+    logger_->error(
+        utl::CTS, CTS_LP_RESULT, "Skew LP: failed to create GLOP solver");
+    result_.status = "solver_creation_failed";
+    return result_;
+  }
+
+  const double inf = solver->infinity();
+
+  // a_i in [0, t_max_i]
+  std::vector<MPVariable*> a_vars(n_ffs);
+  for (int i = 0; i < n_ffs; ++i) {
+    a_vars[i] = solver->MakeNumVar(0.0, t_max_[i], "a_" + std::to_string(i));
+  }
+
+  // w_m >= 0
+  std::vector<MPVariable*> w_vars(n_io_soft);
+  for (int m = 0; m < n_io_soft; ++m) {
+    w_vars[m] = solver->MakeNumVar(0.0, inf, "w_" + std::to_string(m));
+  }
+
+  // W >= 0
+  MPVariable* W_var = solver->MakeNumVar(0.0, inf, "W");
+
+  // Setup: a_i - a_j - V_j <= eff_slack (one V_j per capture endpoint).
+  std::unordered_map<int, MPVariable*> Vj_map;  // capture index -> V_j
+
+  int n_setup_ct = 0;
+  int n_wns_ct = 0;
+
+  for (const auto& ps : pruned_setup) {
+    if (Vj_map.find(ps.j) == Vj_map.end()) {
+      auto* Vj = solver->MakeNumVar(0.0, inf, "Vj_" + std::to_string(ps.j));
+      Vj_map[ps.j] = Vj;
+    }
+  }
+  for (const auto& ps : pruned_setup) {
+    MPConstraint* ct = solver->MakeRowConstraint(-inf, ps.eff_slack, "");
+    if (ps.i != ps.j) {
+      ct->SetCoefficient(a_vars[ps.i], 1.0);
+      ct->SetCoefficient(a_vars[ps.j], -1.0);
+    }
+    ct->SetCoefficient(Vj_map.at(ps.j), -1.0);
+    ++n_setup_ct;
+  }
+  // V_j - W <= 0
+  for (auto& [j, Vj] : Vj_map) {
+    MPConstraint* ct = solver->MakeRowConstraint(-inf, 0.0, "");
+    ct->SetCoefficient(Vj, 1.0);
+    ct->SetCoefficient(W_var, -1.0);
+    ++n_wns_ct;
+  }
+
+  constexpr double residual_weight = 1.0;  // weight of the hold residuals in both phases
+  logger_->info(utl::CTS,
+                2015,
+                "Hold residual objective weight {} in both phases",
+                residual_weight);
+  std::vector<MPVariable*> hold_residuals;
+
+  MPObjective* objective = solver->MutableObjective();
+  objective->SetMinimization();
+
+  auto setPhaseBObjective = [&]() {
+    for (int i = 0; i < n_ffs; ++i) {
+      objective->SetCoefficient(a_vars[i], params_.lambda_reg);
+    }
+    for (auto& [j, Vj] : Vj_map) {
+      objective->SetCoefficient(Vj, 1.0);
+    }
+    for (int m = 0; m < n_io_soft; ++m) {
+      objective->SetCoefficient(w_vars[m], params_.weight_io);
+    }
+    objective->SetCoefficient(W_var, params_.gamma_wns);
+    for (auto* v : hold_residuals) {
+      objective->SetCoefficient(v, residual_weight);
+    }
+  };
+
+  auto setPhaseAObjective = [&]() {
+    objective->SetCoefficient(W_var, 1.0);
+    for (auto* v : hold_residuals) {
+      objective->SetCoefficient(v, residual_weight);
+    }
+    for (int i = 0; i < n_ffs; ++i) {
+      objective->SetCoefficient(a_vars[i], params_.lambda_reg * 1e-4f);
+    }
+    for (auto& [j, Vj] : Vj_map) {
+      objective->SetCoefficient(Vj, 0.0);
+    }
+    for (int m = 0; m < n_io_soft; ++m) {
+      objective->SetCoefficient(w_vars[m], 0.0);
+    }
+  };
+
+  int n_hold_ct = 0;
+  int n_hard_ct = 0;
+  int n_io_ct = 0;
+
+  // Hold: a_j - a_i <= eff_hold - hold_margin.  An edge implied by the
+  // variable bounds (rhs >= t_max_j) is not added; no edge is dropped because
+  // its rhs is negative.
+  struct KeptHold
+  {
+    int i;
+    int j;
+    float rhs;
+  };
+  std::vector<KeptHold> hold_kept;
+  int n_hold_bound_implied = 0;
+  for (const auto& he : hold_edges) {
+    float rhs = he.eff_slack - params_.hold_margin;
+    if (rhs >= t_max_[he.j]) {
+      ++n_hold_bound_implied;
+      continue;
+    }
+    hold_kept.push_back({he.i, he.j, rhs});
+  }
+
+  // Non-regression: a negative rhs gets a residual r in [0, -rhs], i.e. the
+  // existing deficit may remain but never grows; the identity is feasible.
+  for (const auto& h : hold_kept) {
+    MPConstraint* ct = solver->MakeRowConstraint(-inf, h.rhs, "");
+    if (h.i != h.j) {
+      ct->SetCoefficient(a_vars[h.j], 1.0);
+      ct->SetCoefficient(a_vars[h.i], -1.0);
+    }
+    if (h.rhs < 0) {
+      auto* r = solver->MakeNumVar(
+          0.0, -h.rhs, "hold_residual_" + std::to_string(n_hold_ct));
+      ct->SetCoefficient(r, -1.0);
+      hold_residuals.push_back(r);
+    }
+    ++n_hold_ct;
+  }
+  logger_->info(utl::CTS,
+                882,
+                "Skew LP hold policy nonregression: {} edges retained, {} "
+                "bounded residuals, no infeasible-edge pruning",
+                n_hold_ct,
+                hold_residuals.size());
+  logger_->info(utl::CTS,
+                2013,
+                "Skew LP: {} other hold edges are implied by variable bounds",
+                n_hold_bound_implied);
+
+  // Input-port hold: a_j <= slack (residual for a negative slack).
+  for (const auto& [ff_idx, slack, etype] : hard_io) {
+    MPConstraint* ct = solver->MakeRowConstraint(-inf, slack, "");
+    ct->SetCoefficient(a_vars[ff_idx], 1.0);
+    if (slack < 0) {
+      auto* r = solver->MakeNumVar(
+          0.0, -slack, "io_hold_residual_" + std::to_string(n_hard_ct));
+      ct->SetCoefficient(r, -1.0);
+      hold_residuals.push_back(r);
+    }
+    ++n_hard_ct;
+  }
+
+  // IO soft constraints with penalty w_m.
+  for (int m = 0; m < n_io_soft; ++m) {
+    const auto& [ff_idx, slack, etype] = soft_io[m];
+    MPConstraint* ct = solver->MakeRowConstraint(-inf, slack, "");
+
+    switch (etype) {
+      case LpIOEdge::PI_HOLD:
+        // a_j - w_m <= slack
+        ct->SetCoefficient(a_vars[ff_idx], 1.0);
+        ct->SetCoefficient(w_vars[m], -1.0);
+        break;
+      case LpIOEdge::PI_SETUP:
+        // -a_j - w_m <= slack
+        ct->SetCoefficient(a_vars[ff_idx], -1.0);
+        ct->SetCoefficient(w_vars[m], -1.0);
+        break;
+      case LpIOEdge::PO_SETUP:
+        // a_i - w_m <= slack
+        ct->SetCoefficient(a_vars[ff_idx], 1.0);
+        ct->SetCoefficient(w_vars[m], -1.0);
+        break;
+      case LpIOEdge::PO_HOLD:
+        // -a_i - w_m <= slack
+        ct->SetCoefficient(a_vars[ff_idx], -1.0);
+        ct->SetCoefficient(w_vars[m], -1.0);
+        break;
+    }
+    ++n_io_ct;
+  }
+
+  if (n_hold_ghost > 0) {
+    logger_->info(utl::CTS,
+                  CTS_LP_VARS + 2,
+                  "Skew LP: skipped {} hold edges with unmeasured hold corner",
+                  n_hold_ghost);
+  }
+
+  auto statusName = [](int s) -> const char* {
+    switch (s) {
+      case 0:
+        return "OPTIMAL";
+      case 1:
+        return "FEASIBLE";
+      case 2:
+        return "INFEASIBLE";
+      case 3:
+        return "UNBOUNDED";
+      case 4:
+        return "ABNORMAL";
+      default:
+        return "NOT_SOLVED";
+    }
+  };
+
+  double elapsed_s = 0.0;
+  MPSolver::ResultStatus status = MPSolver::NOT_SOLVED;
+
+  {
+    int n_ep_vars = static_cast<int>(Vj_map.size());
+    int total_ct = n_setup_ct + n_hold_ct + n_hard_ct + n_io_ct + n_wns_ct;
+    int total_vars = n_ffs + n_ep_vars + n_io_soft + 1;
+
+    logger_->info(utl::CTS,
+                  CTS_LP_VARS + 1,
+                  "Skew LP: {} vars (a:{} Vj:{} w:{} W:1), {} constraints "
+                  "(setup:{} hold:{} hard_pi:{} io:{} wns:{})",
+                  total_vars,
+                  n_ffs,
+                  n_ep_vars,
+                  n_io_soft,
+                  total_ct,
+                  n_setup_ct,
+                  n_hold_ct,
+                  n_hard_ct,
+                  n_io_ct,
+                  n_wns_ct);
+
+    // Phase A: best achievable W.
+    setPhaseAObjective();
+    auto t0 = std::chrono::high_resolution_clock::now();
+    const MPSolver::ResultStatus st_a = solver->Solve();
+    auto t1 = std::chrono::high_resolution_clock::now();
+    elapsed_s += std::chrono::duration<double>(t1 - t0).count();
+
+    double W_star = (st_a == MPSolver::OPTIMAL || st_a == MPSolver::FEASIBLE)
+                        ? W_var->solution_value()
+                        : 0.0;
+    logger_->info(utl::CTS,
+                  CTS_LP_RESULT,
+                  "Skew LP phase A: W*={:.1f}ps in {:.3f}s (status={})",
+                  W_star * 1e3,
+                  std::chrono::duration<double>(t1 - t0).count(),
+                  static_cast<int>(st_a));
+
+    double wns_bound = W_star * (1.0 + static_cast<double>(params_.wns_alpha));
+    MPConstraint* wbc = solver->MakeRowConstraint(-inf, wns_bound, "wns_bound");
+    wbc->SetCoefficient(W_var, 1.0);
+    logger_->info(utl::CTS,
+                  CTS_LP_RESULT,
+                  "Skew LP phase B: WNS bound W<={:.1f}ps (alpha={:.2f})",
+                  wns_bound * 1e3,
+                  params_.wns_alpha);
+
+    // Phase B: TNS objective under the WNS bound.
+    setPhaseBObjective();
+    auto t_start = std::chrono::high_resolution_clock::now();
+    status = solver->Solve();
+    auto t_end = std::chrono::high_resolution_clock::now();
+    elapsed_s += std::chrono::duration<double>(t_end - t_start).count();
+  }
+
+  result_.solve_time_s = elapsed_s;
+  result_.n_ffs = n_ffs;
+  result_.n_edges = static_cast<int>(edges_.size());
+
+  if (status != MPSolver::OPTIMAL && status != MPSolver::FEASIBLE) {
+    result_.status = "failed";
+    logger_->error(utl::CTS,
+                   CTS_LP_RESULT,
+                   "LP failed ({} {}); no fallback targets published",
+                   static_cast<int>(status),
+                   statusName(static_cast<int>(status)));
+    return result_;
+  }
+
+  // Solver feasibility is checked before any target is published.
+  if (!solver->VerifySolution(1e-7, true)) {
+    logger_->error(utl::CTS, 2024, "Skew LP solution verification failed");
+  }
+  const std::string audit_dir
+      = std::getenv("RESULTS_DIR") ? std::getenv("RESULTS_DIR") : ".";
+  std::ofstream av(audit_dir + "/lp_endpoint_solution.csv");
+  av << "ff_name,a_ns,upper_ns,Vj_ns\n" << std::setprecision(17);
+  for (int i = 0; i < n_ffs; ++i) {
+    av << ff_list_[i] << "," << a_vars[i]->solution_value() << ","
+       << t_max_[i] << ","
+       << (Vj_map.count(i) ? Vj_map.at(i)->solution_value() : 0.0) << "\n";
+  }
+  std::ofstream ai(audit_dir + "/lp_io_solution.csv");
+  ai << "ff_name,type,slack_ns,w_ns\n" << std::setprecision(17);
+  for (int k = 0; k < n_io_soft; ++k) {
+    const auto& [i, slack, type] = soft_io[k];
+    ai << ff_list_[i] << "," << static_cast<int>(type) << "," << slack << ","
+       << w_vars[k]->solution_value() << "\n";
+  }
+  result_.status = "optimal";
+  result_.objective = objective->Value();
+
+  int n_nonzero = 0;
+  double sum_arrivals = 0.0;
+  double max_arrival = 0.0;
+  for (int i = 0; i < n_ffs; ++i) {
+    double val = a_vars[i]->solution_value();
+    result_.arrivals[ff_list_[i]] = val;
+    if (val > 1e-6) {
+      ++n_nonzero;
+      sum_arrivals += val;
+      max_arrival = std::max(max_arrival, val);
+    }
+  }
+  result_.n_nonzero_targets = n_nonzero;
+
+  // Endpoint TNS (STA definition) before and after.
+  std::unordered_map<int, double> ep_worst_before_map;
+  for (const auto& ps : pruned_setup) {
+    auto it = ep_worst_before_map.find(ps.j);
+    if (it == ep_worst_before_map.end() || ps.eff_slack < it->second) {
+      ep_worst_before_map[ps.j] = ps.eff_slack;
+    }
+  }
+  double total_ep_viol_before = 0.0;
+  for (auto& [j, s] : ep_worst_before_map) {
+    total_ep_viol_before += std::max(0.0, -s);
+  }
+  double total_ep_viol_after = 0.0;
+  for (auto& [j, Vj] : Vj_map) {
+    total_ep_viol_after += Vj->solution_value();
+  }
+  double tns_reduction_pct = 0.0;
+  if (total_ep_viol_before > 1e-9) {
+    tns_reduction_pct
+        = (1.0 - total_ep_viol_after / total_ep_viol_before) * 100.0;
+  }
+
+  logger_->info(utl::CTS,
+                CTS_LP_RESULT + 1,
+                "Skew LP: solved in {:.2f}s total, obj={:.4f}",
+                elapsed_s,
+                result_.objective);
+  logger_->info(utl::CTS,
+                CTS_LP_TARGETS,
+                "Skew LP: {} non-zero targets (max={:.1f}ps, sum={:.1f}ps)",
+                n_nonzero,
+                max_arrival * 1e3,
+                sum_arrivals * 1e3);
+  logger_->info(utl::CTS,
+                CTS_LP_TARGETS,
+                "Skew LP: endpoint TNS (model): {:.1f}ps -> {:.1f}ps ({:.1f}% "
+                "reduction)",
+                total_ep_viol_before * 1e3,
+                total_ep_viol_after * 1e3,
+                tns_reduction_pct);
+
+  double W_val = W_var->solution_value();
+  double worst_Vj = 0.0;
+  for (auto& [j, Vj] : Vj_map) {
+    worst_Vj = std::max(worst_Vj, Vj->solution_value());
+  }
+  logger_->info(utl::CTS,
+                CTS_LP_TARGETS + 1,
+                "Skew LP: WNS minimax W={:.1f}ps, worst V_j={:.1f}ps (gamma={})",
+                W_val * 1e3,
+                worst_Vj * 1e3,
+                params_.gamma_wns);
+
+  return result_;
+}
+
+// Write ff_name,target_arrival_ns,tier for every LP register.
+void CtsSkewLpSolver::writeTargetsCSV(const std::string& csv_path) const
+{
+  std::ofstream outfile(csv_path);
+  if (!outfile.is_open()) {
+    logger_->warn(utl::CTS,
+                  CTS_LP_TARGETS + 2,
+                  "Skew LP: cannot write targets CSV {}",
+                  csv_path);
+    return;
+  }
+
+  outfile << "ff_name,target_arrival_ns,tier\n";
+  int n_written = 0;
+  int n_nonzero = 0;
+  for (int i = 0; i < static_cast<int>(ff_list_.size()); ++i) {
+    const std::string& ff_name = ff_list_[i];
+    auto it = result_.arrivals.find(ff_name);
+    double arrival = (it != result_.arrivals.end()) ? it->second : 0.0;
+    int tier = (i < static_cast<int>(ff_tiers_.size())) ? ff_tiers_[i] : 0;
+    outfile << ff_name << "," << std::fixed << std::setprecision(6) << arrival
+            << "," << tier << "\n";
+    ++n_written;
+    if (arrival > 1e-6) {
+      ++n_nonzero;
+    }
+  }
+
+  logger_->info(utl::CTS,
+                CTS_LP_TARGETS + 2,
+                "Skew LP: wrote {} targets ({} non-zero) to {}",
+                n_written,
+                n_nonzero,
+                csv_path);
+}
+
+}  // namespace cts
diff --git a/src/cts/src/CtsSkewLpSolver.h b/src/cts/src/CtsSkewLpSolver.h
new file mode 100644
index 0000000000..f8226bd821
--- /dev/null
+++ b/src/cts/src/CtsSkewLpSolver.h
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+// LP scheduling of per-register clock arrival targets (OR-Tools GLOP).
+//
+// Inputs are the propagated-clock sequential graph (register -> register setup
+// and hold slacks) and the IO edges (input port -> register, register ->
+// output port) written by the timing-graph extractor.
+//
+// Variables: a_i   clock arrival increment of register i, 0 <= a_i <= t_max_i
+//            V_j   worst setup violation at capture endpoint j
+//            w_m   penalty of IO soft constraint m
+//            W     worst endpoint violation (WNS minimax)
+//            r     bounded hold residuals (non-regression hold policy)
+// Constraints:
+//   setup  i->j : a_i - a_j - V_j <= setup_slack - 2 sigma          (soft via V_j)
+//   hold   i->j : a_j - a_i - r   <= hold_slack - 2 sigma - margin  (hard)
+//                 0 <= r <= max(0, -rhs): an existing hold deficit may stay,
+//                 it may never grow
+//   PI hold     : a_j - r <= slack, 0 <= r <= max(0, -slack)         (hard)
+//   IO soft     : +-a - w_m <= slack
+//   WNS         : V_j - W <= 0
+// Two-phase solve:
+//   phase A: minimize W (+ hold residuals, small regularization); optimum W*
+//   phase B: minimize sum V_j + lambda sum a_i + weight_io sum w_m + gamma W
+//            + residual weight sum r, subject to W <= W* (1 + alpha).
+
+#pragma once
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace odb {
+class dbBlock;
+}
+
+namespace sta {
+class dbSta;
+class dbNetwork;
+}
+
+namespace utl {
+class Logger;
+}
+
+namespace cts {
+
+class Cts3DDatabase;
+
+// Timing edge between two registers (from the extracted graph).
+struct LpTimingEdge
+{
+  int from_idx;
+  int to_idx;
+  float slack_setup_ns;  // max path slack (setup)
+  float slack_hold_ns;   // min path slack (hold)
+  bool cross_tier;
+  bool hold_ghost;   // hold corner not measured (inf in the graph)
+  bool setup_ghost;  // setup corner not measured (inf in the graph)
+};
+
+// IO edge (input port -> register or register -> output port).
+struct LpIOEdge
+{
+  int ff_idx;
+  float slack_ns;
+  enum Type
+  {
+    PI_HOLD,
+    PI_SETUP,
+    PO_SETUP,
+    PO_HOLD
+  } type;
+};
+
+// Default WNS relaxation of phase B (W <= W* (1 + alpha)).
+constexpr float kDefaultLpWnsAlpha = 0.05f;
+
+// LP solver parameters.
+struct LpParams
+{
+  float sigma_local = 0.005f;  // local clock uncertainty per register (ns)
+  float sigma_pi = 0.005f;     // input-port hold safety margin (ns)
+  float lambda_reg = 0.01f;    // regularization weight on sum a_i
+  float hold_margin = 0.010f;  // register hold margin (ns)
+  float gamma_wns = 10.0f;     // weight of W in phase B
+  float weight_io = 1.0f;      // IO soft constraint weight
+  float max_skew = 0.100f;     // upper bound of a_i (ns)
+  float wns_alpha = kDefaultLpWnsAlpha;  // phase-B WNS relaxation
+};
+
+// LP solver result.
+struct LpResult
+{
+  std::unordered_map<std::string, double> arrivals;  // ff_name -> arrival_ns
+  std::string status;
+  double objective = 0.0;
+  double solve_time_s = 0.0;
+  int n_ffs = 0;
+  int n_edges = 0;
+  int n_nonzero_targets = 0;
+};
+
+class CtsSkewLpSolver
+{
+ public:
+  CtsSkewLpSolver(odb::dbBlock* block,
+                  sta::dbSta* sta,
+                  sta::dbNetwork* network,
+                  utl::Logger* logger,
+                  Cts3DDatabase* cts3dDb);
+
+  void setParams(const LpParams& params) { params_ = params; }
+
+  // Register -> register timing graph (CSV written by the extractor).
+  void readTimingGraphCSV(const std::string& csv_path);
+
+  // IO edges (CSV written by the extractor).
+  void readIOEdgesCSV(const std::string& io_csv_path);
+
+  // Per-register upper bounds t_max (max_skew, optional external bounds).
+  void computeBounds();
+
+  // Reduce t_max of registers captured from an input port by the hold slack.
+  void applyPiHoldClip();
+
+  // Solve the two-phase LP.
+  LpResult solveTns();
+
+  const std::unordered_map<std::string, double>& getArrivals() const
+  {
+    return result_.arrivals;
+  }
+
+  int getNumFFs() const { return static_cast<int>(ff_list_.size()); }
+
+  // Write the targets CSV (ff_name,target_arrival_ns,tier).
+  void writeTargetsCSV(const std::string& csv_path) const;
+
+ private:
+  odb::dbBlock* block_;
+  sta::dbSta* sta_;
+  sta::dbNetwork* network_;
+  utl::Logger* logger_;
+  Cts3DDatabase* cts3dDb_;
+
+  LpParams params_;
+  LpResult result_;
+
+  // Register data
+  std::vector<std::string> ff_list_;  // sorted register names
+  std::unordered_map<std::string, int> ff_to_idx_;
+  std::vector<int> ff_tiers_;  // tier per register
+  std::vector<float> t_max_;   // per-register upper bound of a_i (ns)
+
+  std::vector<LpTimingEdge> edges_;
+  std::vector<LpIOEdge> io_edges_;
+};
+
+}  // namespace cts
diff --git a/src/cts/src/EarlyClockCalibration.cpp b/src/cts/src/EarlyClockCalibration.cpp
new file mode 100644
index 0000000000..c53b274adc
--- /dev/null
+++ b/src/cts/src/EarlyClockCalibration.cpp
@@ -0,0 +1,359 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+// Clock-shift calibration of the early-clock structures on the initial (reference) clock tree.
+// calibrate_structures writes the structures (<outdir>/cands); the probe session
+// evaluates them (early_probe.tcl); calibrate_fit fits the shift model from the probe reports.
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <functional>
+#include <map>
+#include <set>
+
+#include "EarlyClockReplay.h"
+#include "EarlyDecision.h"
+
+namespace cts::early {
+
+namespace {
+constexpr int N_CAP = 16;
+
+struct CalibData
+{
+  Tree tree;                                               // buffers
+  std::unordered_map<std::string, SinkRow> sinks;          // keyed by inst (last row wins)
+  std::vector<std::string> sink_order;
+  long long rx = 0, ry = 0;
+  std::vector<std::string> leaf_order;                     // leaves in first-appearance order
+  std::unordered_map<std::string, std::vector<std::string>> leaves;   // leaf -> sink insts
+  std::map<int, std::string> mtier;
+  std::vector<std::pair<std::string, std::vector<std::string>>> cfg;  // name -> leaves
+  std::set<std::string> hold;
+};
+
+std::string top_of(const Tree& tree, std::string b)
+{
+  while (tree.has(b) && !starts_with(tree.at(b).driver, "PORT:")) b = tree.at(b).driver;
+  return b;
+}
+
+CalibData load_calib(const std::string& dump, const std::string& root)
+{
+  CalibData C;
+  C.tree = load_tree(dump, true);
+  Sinks s = load_sinks(dump);
+  for (auto& k : s.order) {
+    auto& r = s.rows[k];
+    if (!C.sinks.count(r.inst)) C.sink_order.push_back(r.inst);
+    C.sinks[r.inst] = r;
+  }
+  C.rx = C.tree.at(root).x; C.ry = C.tree.at(root).y;
+  for (auto& inst : C.sink_order) {
+    auto& r = C.sinks[inst];
+    if (C.tree.has(r.driver) && starts_with(r.driver, "clkbuf_leaf") && top_of(C.tree, r.driver) == root) {
+      if (!C.leaves.count(r.driver)) C.leaf_order.push_back(r.driver);
+      C.leaves[r.driver].push_back(inst);
+    }
+  }
+  for (auto& b : C.leaf_order) C.mtier.emplace(C.tree.at(b).tier, C.tree.at(b).master);
+  auto dist_of = [&](const std::string& b) { return std::llabs(C.tree.at(b).x - C.rx) + std::llabs(C.tree.at(b).y - C.ry); };
+  std::map<int, std::vector<std::string>> pool;
+  for (int t : {0, 1}) {
+    std::vector<std::string> L;
+    for (auto& b : C.leaf_order) if (C.tree.at(b).tier == t) L.push_back(b);
+    std::stable_sort(L.begin(), L.end(), [&](const std::string& a, const std::string& b) { return dist_of(a) < dist_of(b); });
+    pool[t] = L;
+  }
+  auto spread = [](const std::vector<std::string>& L, int k, double off) {
+    std::vector<std::string> out;
+    if ((int) L.size() < k) return out;
+    for (int i = 0; i < k; ++i) out.push_back(L[std::min<long long>((long long) L.size() - 1, py_int(((double) i + off) * (double) L.size() / (double) k))]);
+    return out;
+  };
+  auto distinct = [](const std::vector<std::string>& v) { return std::set<std::string>(v.begin(), v.end()).size(); };
+  // Per tier, leaves sorted by distance to the root: single leaves (near / mid / far), evenly spread sets of 2, 4, 8
+  // and N_CAP leaves for the fit, and offset sets of 3, 6 and 12 leaves held out for validation.
+  for (int t : {0, 1}) {
+    auto& L = pool[t];
+    if (L.empty()) continue;
+    std::string pre = "t" + std::to_string(t);
+    C.cfg.emplace_back(pre + "_n1near", std::vector<std::string>{L[0]});
+    C.cfg.emplace_back(pre + "_n1mid", std::vector<std::string>{L[L.size() / 2]});
+    C.cfg.emplace_back(pre + "_n1far", std::vector<std::string>{L.back()});
+    for (int k : {2, 4, 8, N_CAP}) {
+      auto sel = spread(L, k, 0.0);
+      if (!sel.empty() && (int) distinct(sel) == k) C.cfg.emplace_back(pre + "_n" + std::to_string(k), sel);
+    }
+    for (int k : {3, 6, 12}) {
+      auto sel = spread(L, k, 0.5);
+      if (!sel.empty() && (int) distinct(sel) == k) { C.cfg.emplace_back(pre + "_h" + std::to_string(k), sel); C.hold.insert(pre + "_h" + std::to_string(k)); }
+    }
+  }
+  return C;
+}
+
+// {inst: pred_ps} of the mode == max rows, keys in first-insertion order
+struct Arr
+{
+  std::vector<std::string> order;
+  std::unordered_map<std::string, double> v;
+  bool has(const std::string& k) const { return v.count(k) > 0; }
+  double at(const std::string& k) const { return v.at(k); }
+};
+Arr read_arr(const std::string& path)
+{
+  Arr a;
+  Table t = read_table(path);
+  int cp = t.col("pin"), cm = t.col("mode"), cv = t.col("pred_ps");
+  for (auto& r : t.rows)
+    if (r[cm] == "max") {
+      std::string k = inst_of(r[cp]);
+      if (!a.v.count(k)) a.order.push_back(k);
+      a.v[k] = to_double(r[cv]);
+    }
+  return a;
+}
+
+// Gauss-Jordan elimination with partial pivoting; false when singular
+bool solve(std::vector<std::vector<double>> A, std::vector<double> B, std::vector<double>& out)
+{
+  int n = (int) B.size();
+  std::vector<std::vector<double>> M(n);
+  for (int i = 0; i < n; ++i) { M[i] = A[i]; M[i].push_back(B[i]); }
+  for (int i = 0; i < n; ++i) {
+    int p = i;
+    for (int r = i + 1; r < n; ++r) if (std::fabs(M[r][i]) > std::fabs(M[p][i])) p = r;   // ties: first maximal row
+    std::swap(M[i], M[p]);
+    if (std::fabs(M[i][i]) < 1e-12) return false;
+    for (int r = 0; r < n; ++r) {
+      if (r == i) continue;
+      double f = M[r][i] / M[i][i];
+      for (int c = i; c < n + 1; ++c) M[r][c] -= f * M[i][c];
+    }
+  }
+  out.resize(n);
+  for (int i = 0; i < n; ++i) out[i] = M[i][n] / M[i][i];
+  return true;
+}
+}  // namespace
+
+void calibrate_structures(const std::string&, const std::string&, const std::string&, const std::string& dump,
+                          const std::string& outdir, const std::string& root)
+{
+  CalibData C = load_calib(dump, root);
+  std::string cdir = join_path(outdir, "cands");
+  mkdirs(cdir);
+  std::string list;
+  for (auto& kv : C.cfg) {
+    list += kv.first + "\n";
+    std::string s = "gid\tmode\tmaster\tx\ty\tparent_driver\tleaf\tmembers\n";
+    for (size_t i = 0; i < kv.second.size(); ++i) {
+      const std::string& b = kv.second[i];
+      const TreeRow& r = C.tree.at(b);
+      std::vector<std::string> mem(C.leaves[b]);
+      std::sort(mem.begin(), mem.end());
+      std::string ml;
+      for (size_t j = 0; j < mem.size(); ++j) { if (j) ml += ";"; ml += mem[j] + "/" + C.sinks[mem[j]].pin; }
+      s += std::to_string(i) + "\treparent\t" + r.master + "\t" + std::to_string(r.x) + "\t" + std::to_string(r.y) + "\thub:" + root + ":" +
+           std::to_string(r.tier) + ":" + C.mtier.at(r.tier) + "\t" + b + "\t" + ml + "\n";
+    }
+    write_text(join_path(cdir, kv.first + ".tsv"), s);
+  }
+  write_text(join_path(cdir, "list.txt"), list);
+}
+
+void calibrate_fit(const std::string&, const std::string&, const std::string&, const std::string& dump,
+                   const std::string& outdir, const std::string& root, const std::string& rep)
+{
+  CalibData C = load_calib(dump, root);
+  const Tree& tree = C.tree;
+  Arr base = read_arr(join_path(rep, "arr_base.csv"));
+  std::vector<std::string> bout_order;
+  std::unordered_map<std::string, double> bout, pin_in;
+  {
+    Table raw = read_table(join_path(rep, "raw_base.csv"));
+    int cp = raw.col("pin"), ck = raw.col("kind"), cm = raw.col("mode"), cr = raw.col("rf"), cv = raw.col("pred_ps");
+    for (auto& r : raw.rows) {
+      if (r[ck] != "buffer" || r[cm] != "max" || r[cr] != "rise") continue;
+      std::string inst = inst_of(r[cp]);
+      if (ends_with(r[cp], "/A")) pin_in[inst] = to_double(r[cv]);
+      else { if (!bout.count(inst)) bout_order.push_back(inst); bout[inst] = to_double(r[cv]); }
+    }
+  }
+  std::function<void(const std::string&)> fill_out = [&](const std::string& b) {
+    if (bout.count(b)) return;
+    std::vector<std::string> kids;
+    for (auto& k : tree.order) if (tree.rows.at(k).driver == b && pin_in.count(k)) kids.push_back(k);
+    if (kids.empty()) {
+      std::vector<std::string> kids_out;
+      for (auto& k : tree.order) if (tree.rows.at(k).driver == b) kids_out.push_back(k);
+      for (auto& k : kids_out) fill_out(k);
+      std::vector<double> cand;
+      for (auto& k : kids_out) if (bout.count(k)) cand.push_back(bout[k]);
+      if (!cand.empty()) {
+        bout_order.push_back(b); bout[b] = *std::min_element(cand.begin(), cand.end());
+        std::printf("calib: %s output arrival from descendant outputs (fallback)\n", b.c_str());
+      }
+      return;
+    }
+    double m = pin_in[kids[0]];
+    for (auto& k : kids) m = std::min(m, pin_in[k]);
+    bout_order.push_back(b); bout[b] = m;
+    std::printf("calib: %s output arrival from child inputs (fallback)\n", b.c_str());
+  };
+  std::set<std::string> branches;
+  for (auto& l : C.leaf_order) branches.insert(tree.at(l).driver);
+  fill_out(root);
+  for (auto& b : branches) fill_out(b);
+  struct Pt { std::string cfg, leaf; int tier, n; double dist_um, base_term, shift, common; bool has_pred = false; double pred = 0; };
+  std::vector<Pt> pts;
+  std::vector<std::pair<std::string, std::pair<int, double>>> common;   // cfg -> (nh, median other shift)
+  std::map<std::string, Arr> arrs;
+  for (auto& kv : C.cfg) {
+    const std::string& k = kv.first;
+    const auto& sel = kv.second;
+    Arr a = read_arr(join_path(rep, "arr_" + k + ".csv"));
+    std::set<std::string> mem;
+    for (auto& b : sel) for (auto& s : C.leaves[b]) mem.insert(s);
+    std::set<int> tiers;
+    for (auto& b : sel) tiers.insert(tree.at(b).tier);
+    int nh = (int) tiers.size();
+    std::vector<double> oth;
+    for (auto& s : base.order) if (!mem.count(s) && a.has(s)) oth.push_back(a.at(s) - base.at(s));
+    std::sort(oth.begin(), oth.end());
+    double cmed = oth.at(oth.size() / 2);
+    common.emplace_back(k, std::make_pair(nh, cmed));
+    std::map<int, int> n;
+    for (auto& b : sel) n[tree.at(b).tier]++;
+    for (auto& b : sel) {
+      const TreeRow& r = tree.at(b);
+      std::vector<double> sh;
+      for (auto& s : C.leaves[b]) if (a.has(s)) sh.push_back(a.at(s) - base.at(s));
+      std::sort(sh.begin(), sh.end());
+      double shv = sh.at(C.leaves[b].size() / 2);
+      double d = (double) (std::llabs(r.x - C.rx) + std::llabs(r.y - C.ry)) / 1000.0;
+      pts.push_back({k, b, r.tier, n[r.tier], d, bout.at(root) - bout.at(r.driver), shv, cmed});
+    }
+    arrs.emplace(k, std::move(a));
+  }
+  double kh = 0.0;
+  for (auto& c : common) kh += c.second.second / (double) std::max(1, c.second.first);
+  kh = kh / (double) common.size();
+  // Member shift model per tier: shift = common + base_term + a + b * n + c * dist + d * dist^2 (n = leaves moved on
+  // that tier, dist = leaf-to-root Manhattan distance in um), least squares on the fit sets; valid when at least two
+  // held-out sets exist and their RMS error is <= 10 ps.
+  auto feat = [](const Pt& p) { return std::vector<double>{1.0, (double) p.n, p.dist_um, py_pow(p.dist_um, 2.0)}; };
+  J fit = J::Obj();
+  for (int t : {0, 1}) {
+    std::vector<Pt*> Pp, H;
+    for (auto& p : pts) {
+      if (p.tier != t) continue;
+      if (C.hold.count(p.cfg)) H.push_back(&p); else Pp.push_back(&p);
+    }
+    if (Pp.size() < 4) continue;
+    std::vector<std::vector<double>> X;
+    std::vector<double> y;
+    for (auto* p : Pp) { X.push_back(feat(*p)); y.push_back(p->shift - p->common - p->base_term); }
+    std::vector<std::vector<double>> A(4, std::vector<double>(4, 0.0));
+    std::vector<double> B(4, 0.0);
+    for (int r = 0; r < 4; ++r) {
+      for (int c = 0; c < 4; ++c) { double s = 0.0; for (size_t i = 0; i < X.size(); ++i) s += X[i][r] * X[i][c]; A[r][c] = s; }
+      double s = 0.0;
+      for (size_t i = 0; i < X.size(); ++i) s += X[i][r] * y[i];
+      B[r] = s;
+    }
+    std::vector<double> sv;
+    if (!solve(A, B, sv)) { double s = 0.0; for (double v : y) s += v; sv = {s / (double) y.size(), 0.0, 0.0, 0.0}; }
+    auto pred = [&](const Pt& p) {
+      auto f = feat(p);
+      double s = 0.0;
+      for (int i = 0; i < 4; ++i) s += sv[i] * f[i];
+      return p.common + p.base_term + s;
+    };
+    double se = 0.0;
+    for (auto* p : Pp) se += py_pow(p->shift - pred(*p), 2.0);
+    double rin = py_pow(se / (double) Pp.size(), 0.5);
+    bool has_rh = !H.empty();
+    double rh = 0.0;
+    if (has_rh) { double s = 0.0; for (auto* p : H) s += py_pow(p->shift - pred(*p), 2.0); rh = py_pow(s / (double) H.size(), 0.5); }
+    for (auto* p : Pp) { p->pred = pred(*p); p->has_pred = true; }
+    for (auto* p : H) { p->pred = pred(*p); p->has_pred = true; }
+    std::set<std::string> hcfg;
+    for (auto* p : H) hcfg.insert(p->cfg);
+    J f = J::Obj();
+    f.set("a", J::D(sv[0])); f.set("b", J::D(sv[1])); f.set("c", J::D(sv[2])); f.set("d", J::D(sv[3]));
+    f.set("rms", J::D(rin)); f.set("npts", J::I((long long) Pp.size()));
+    f.set("holdout_rms", has_rh ? J::D(rh) : J::Null()); f.set("holdout_npts", J::I((long long) H.size()));
+    f.set("holdout_cfgs", J::I((long long) hcfg.size()));
+    f.set("valid", J::B(has_rh && hcfg.size() >= 2 && rh <= 10.0));
+    fit.set(std::to_string(t), f);
+  }
+  J out = J::Obj();
+  out.set("model", J::S("v2")); out.set("n_cap", J::I(N_CAP));
+  J hc = J::Arr();
+  for (auto& h : C.hold) hc.push(J::S(h));
+  out.set("holdout_cfgs", hc);
+  out.set("root", J::S(root)); out.set("root_out", J::D(bout.at(root))); out.set("k_hub", J::D(kh));
+  out.set("fit", fit);
+  J cj = J::Obj();
+  for (auto& c : common) { J e = J::Arr(); e.push(J::I(c.second.first)); e.push(J::D(c.second.second)); cj.set(c.first, e); }
+  out.set("common", cj);
+  J bo = J::Obj();
+  for (auto& b : bout_order) if (branches.count(b)) bo.set(b, J::D(bout[b]));
+  out.set("branch_out", bo);
+  write_text(join_path(outdir, "calib.json"), out.dump(1));
+  {
+    std::vector<std::string> hdr = {"cfg", "leaf", "tier", "n", "dist_um", "base_term", "shift", "common"};
+    if (!pts.empty() && pts[0].has_pred) hdr.push_back("pred");
+    hdr.push_back("pred");
+    std::string s = csv_row(hdr);
+    for (auto& p : pts) {
+      std::vector<std::string> f = {p.cfg, p.leaf, std::to_string(p.tier), std::to_string(p.n), py_repr(p.dist_um), py_repr(p.base_term),
+                                    py_repr(p.shift), py_repr(p.common)};
+      std::string pr = p.has_pred ? py_repr(p.pred) : "";
+      for (size_t i = 8; i < hdr.size(); ++i) f.push_back(pr);
+      s += csv_row(f);
+    }
+    write_text(join_path(outdir, "calib_points.csv"), s);
+  }
+  // non-member shift: k1 * (#hubs) + u * (#leaves removed from the register's own branch)
+  std::vector<std::pair<long long, long long>> Xn;
+  std::vector<double> Yn;
+  for (auto& kv : C.cfg) {
+    const Arr& a = arrs.at(kv.first);
+    std::set<std::string> mem;
+    for (auto& b : kv.second) for (auto& s : C.leaves[b]) mem.insert(s);
+    std::set<int> tiers;
+    for (auto& b : kv.second) tiers.insert(tree.at(b).tier);
+    long long nh = (long long) tiers.size();
+    std::map<std::string, long long> rem;
+    for (auto& b : kv.second) rem[tree.at(b).driver]++;
+    for (auto& s : base.order) {
+      if (mem.count(s) || !a.has(s)) continue;
+      auto si = C.sinks.find(s);
+      if (si == C.sinks.end() || !tree.has(si->second.driver)) continue;
+      const std::string& br = tree.at(si->second.driver).driver;
+      auto ri = rem.find(br);
+      Xn.emplace_back(nh, ri == rem.end() ? 0 : ri->second);
+      Yn.push_back(a.at(s) - base.at(s));
+    }
+  }
+  long long s11 = 0, s12 = 0, s22 = 0;
+  double b1 = 0.0, b2 = 0.0;
+  for (size_t i = 0; i < Xn.size(); ++i) { s11 += Xn[i].first * Xn[i].first; s12 += Xn[i].first * Xn[i].second; s22 += Xn[i].second * Xn[i].second; }
+  for (size_t i = 0; i < Xn.size(); ++i) { b1 += (double) Xn[i].first * Yn[i]; b2 += (double) Xn[i].second * Yn[i]; }
+  double det = (double) (s11 * s22 - s12 * s12);
+  double k1 = (b1 * (double) s22 - b2 * (double) s12) / det;
+  double u = ((double) s11 * b2 - (double) s12 * b1) / det;
+  double se = 0.0;
+  for (size_t i = 0; i < Xn.size(); ++i) se += py_pow(Yn[i] - k1 * (double) Xn[i].first - u * (double) Xn[i].second, 2.0);
+  double rms = py_pow(se / (double) Yn.size(), 0.5);
+  J nm = J::Obj();
+  nm.set("k_per_hub", J::D(k1)); nm.set("u_per_removed_leaf", J::D(u)); nm.set("rms", J::D(rms)); nm.set("n", J::I((long long) Yn.size()));
+  out.set("nonmember", nm);
+  write_text(join_path(outdir, "calib.json"), out.dump(1));
+  std::printf("nonmember %s\n", nm.dump(1).c_str());
+}
+
+}  // namespace cts::early
