+      for (const auto& b : blk) {
+        const int g1 = std::min(b.first, r.x1);
+        const int lo = r.x0 + ((g0 - r.x0 + r.siteW - 1) / r.siteW) * r.siteW;
+        const int hi = r.x0 + ((g1 - w - r.x0) / r.siteW) * r.siteW;
