+Tree load_tree(const std::string& dump, bool buffers_only)
+{
+  Tree t;
+  Table tb = read_table(join_path(dump, "tree.csv"));
+  int ci = tb.col("inst"), cm = tb.col("master"), ct = tb.col("tier"), cx = tb.col("x"), cy = tb.col("y"), cw = tb.col("w"),
+      cin = tb.col("in_net"), cout = tb.col("out_net"), cd = tb.col("driver"), ck = tb.col("kind");
+  for (auto& r : tb.rows) {
+    if (buffers_only && r[ck] != "buffer") continue;
+    TreeRow tr;
+    tr.inst = r[ci]; tr.master = r[cm]; tr.tier = (int) to_int(r[ct]); tr.x = to_int(r[cx]); tr.y = to_int(r[cy]);
+    tr.w = to_int(r[cw]); tr.in_net = r[cin]; tr.out_net = r[cout]; tr.driver = r[cd]; tr.kind = r[ck];
+    if (!t.rows.count(tr.inst)) t.order.push_back(tr.inst);
+    t.rows[tr.inst] = tr;
+  }
+  return t;
+}
