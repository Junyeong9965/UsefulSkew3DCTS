+// ------------------------------------------------------------------------------------------------ replay
+namespace {
+// Stable bucket sort of positions by key into CSR form: order[ptr[k] .. ptr[k + 1]) lists the positions of key k
+void csr(const std::vector<int64_t>& key, int64_t nkeys, std::vector<int64_t>& order, std::vector<int64_t>& ptr)
+{
+  ptr.assign(nkeys + 1, 0);
+  for (int64_t k : key) ptr[k + 1]++;
+  for (int64_t i = 0; i < nkeys; ++i) ptr[i + 1] += ptr[i];
+  order.resize(key.size());
+  std::vector<int64_t> fill(ptr.begin(), ptr.end() - 1);
+  for (size_t i = 0; i < key.size(); ++i) order[fill[key[i]]++] = (int64_t) i;
+}
