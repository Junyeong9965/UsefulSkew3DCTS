+bool isNamedHardMacroMaster(const odb::dbMaster* master)
+{
+  if (master == nullptr) {
+    return false;
+  }
+  std::string name = master->getName();
+  std::transform(name.begin(), name.end(), name.begin(), [](unsigned char c) {
+    return std::tolower(c);
+  });
+  return name.rfind("fakeram", 0) == 0 || name.rfind("fakeregfile", 0) == 0
+         || name.rfind("sram_", 0) == 0;
+}
+
+bool isMacroBlockInst(const odb::dbInst* inst)
+{
+  if (inst == nullptr) {
+    return false;
+  }
+  if (inst->isBlock()) {
+    return true;
+  }
+  const odb::dbMaster* master = inst->getMaster();
+  return (master != nullptr && master->isBlock())
+         || isNamedHardMacroMaster(master);
+}
+
+// Only native constrained path ends may authorize a scheduling row.  SDC
+// exceptions, edge/cycle relations and CRPR are evaluated by the PathEnd.
+// Returns "" for an admitted end, otherwise the rejection reason.
+std::string admissionReason(
+    const sta::PathEnd* pe,
+    sta::dbSta* sta,
+    sta::dbNetwork* network,
+    std::unordered_map<const sta::Instance*, bool>& latch_cache)
+{
+  if (!pe || !pe->path() || pe->isUnconstrained()) {
+    return "inactive_unconstrained";
+  }
+  if (pe->isLatchCheck() || pe->isGatedClock() || pe->isDataCheck()
+      || pe->isPathDelay()) {
+    return "unsupported_check_relation";
+  }
+  if (!pe->sourceClkEdge(sta) || !pe->targetClkEdge(sta)) {
+    return "unsupported_missing_clock_relation";
+  }
+  sta::PathExpanded expanded(pe->path(), sta);
+  if (!expanded.startPath()) {
+    return "extraction_error_no_start";
+  }
+  for (size_t k = expanded.startIndex(); k < expanded.size(); ++k) {
+    auto* path = expanded.path(k);
+    if (!path) {
+      continue;
+    }
+    const auto* inst = network->instance(path->pin(sta));
+    if (!inst) {
+      continue;
+    }
+    auto found = latch_cache.find(inst);
+    bool latch = false;
+    if (found != latch_cache.end()) {
+      latch = found->second;
+    } else {
+      auto* cell = network->libertyCell(inst);
+      if (cell && cell->hasSequentials()) {
+        for (auto* seq : cell->sequentials()) {
+          if (seq && !seq->isRegister()) {
+            latch = true;
+          }
+        }
+      }
+      latch_cache[inst] = latch;
+    }
+    if (latch) {
+      return "unsupported_data_latch_borrowing";
+    }
+  }
+  return "";
+}
+
+// ----------------------------------------------------------------------------
+// Launch partitioning, EXTRACT_PARTITION="k/N" (active for N > 1 only).
+// Each of N processes handles the launch registers of its partition; the merge
+// step reassembles the single-process outputs from the
+// per-launch index files.  Membership depends only on the rank of the register
+// name in byte-wise sorted order and N, so every
+// process of a run computes the same disjoint cover.
+// ----------------------------------------------------------------------------
+struct LaunchPartition
+{
+  int id = 0;
+  int total = 1;
+};
+
+LaunchPartition launchPartition()
+{
+  LaunchPartition part;
+  if (const char* s = std::getenv("EXTRACT_PARTITION")) {
+    int id = 0, total = 1;
+    if (std::sscanf(s, "%d/%d", &id, &total) == 2 && total > 1 && id >= 0
+        && id < total) {
+      part.id = id;
+      part.total = total;
+    }
+  }
+  return part;
+}
+
+struct LaunchMember
+{
+  std::string name;
+  odb::dbInst* inst = nullptr;
+  int order = 0;  // position in the single-process launch order
+};
+
+// Registers that have an STA instance, numbered in odb_registers_ iteration
+// order (the single-process order); returns the members of `part` sorted by
+// name.  *n_total receives the size of the whole launch universe.
+// Partition 0, which also runs the input-port side of the IO pass, gets
+// kPartition0Weight percent of the launches of every other partition.  The
+// partition-0 launches are spread evenly over the name order (step w / M,
+// M = 100 (N - 1) + w); the remaining ranks go round-robin to 1..N-1.  With
+// N = 1 the single partition holds every launch.
+std::vector<LaunchMember> partitionMembers(
+    const std::unordered_map<std::string, odb::dbInst*>& regs,
+    sta::dbNetwork* network,
+    const LaunchPartition& part,
+    int* n_total)
+{
+  std::vector<LaunchMember> all;
+  all.reserve(regs.size());
+  int order = 0;
+  for (const auto& [name, inst] : regs) {
+    if (!network->dbToSta(inst)) {
+      continue;
+    }
+    all.push_back({name, inst, order++});
+  }
+  if (n_total) {
+    *n_total = static_cast<int>(all.size());
+  }
+  std::sort(all.begin(),
+            all.end(),
+            [](const LaunchMember& a, const LaunchMember& b) {
+              return a.name < b.name;
+            });
+  if (part.total <= 1) {
+    return all;
+  }
+  constexpr int kPartition0Weight = 50;
+  std::vector<LaunchMember> members;
+  const unsigned long long w = static_cast<unsigned long long>(kPartition0Weight);
+  const unsigned long long m = 100ULL * (part.total - 1) + w;
+  for (size_t rank = 0; rank < all.size(); ++rank) {
+    // Number of partition-0 launches among ranks [0, rank) and [0, rank].
+    const unsigned long long before = rank * w / m;
+    const unsigned long long after = (rank + 1) * w / m;
+    const int owner
+        = (after > before)
+              ? 0
+              : 1 + static_cast<int>((rank - before) % (part.total - 1));
+    if (owner == part.id) {
+      members.push_back(std::move(all[rank]));
+    }
+  }
+  return members;
+}
+
+// Plain-value image of one register -> output-port PathEnd.  PathEnds are
+// owned by the search's path groups and die at the next findPathEnds, so the
+// register pass keeps these records for the IO pass.
+struct PoEndRecord
+{
+  std::string why;       // admissionReason(); empty = admitted
+  std::string endpoint;  // pathName of the path end pin ("NULL" without path)
+  std::string ff;        // launch register name (expanded start pin)
+  bool has_path = false;
+  bool expanded_empty = false;
+  float slack_ns = 0.0f;
+};
+
+struct PoStash
+{
+  std::vector<PoEndRecord> setup;  // max ends at output ports, query order
+  std::vector<PoEndRecord> hold;   // min ends at output ports, query order
+};
+
+struct PoCache
+{
+  bool valid = false;
+  odb::dbBlock* block = nullptr;
+  float fingerprint[4] = {0, 0, 0, 0};  // TNS/WNS max/min at stash time
+  std::unordered_map<odb::dbInst*, PoStash> by_reg;
+};
+
+PoCache& poCache()
+{
+  static PoCache cache;
+  return cache;
+}
+
+// Whole-design timing fingerprint.  The IO pass replays the stash only when
+// the fingerprint it measures equals the one stored by the register pass.
+void timingFingerprint(sta::dbSta* sta, float fp[4])
+{
+  fp[0] = sta::delayAsFloat(sta->totalNegativeSlack(sta::MinMax::max()));
+  fp[1] = sta::delayAsFloat(sta->totalNegativeSlack(sta::MinMax::min()));
+  fp[2] = sta::delayAsFloat(sta->worstSlack(sta::MinMax::max()));
+  fp[3] = sta::delayAsFloat(sta->worstSlack(sta::MinMax::min()));
+}
+
+// Everything the IO pass reads from a register -> output-port PathEnd.
+PoEndRecord makePoEndRecord(
+    sta::PathEnd* pe,
+    sta::dbSta* sta,
+    sta::dbNetwork* network,
+    std::unordered_map<const sta::Instance*, bool>& latch_cache,
+    const std::unordered_map<odb::dbInst*, std::string>& inst_to_name)
+{
+  constexpr float SEC_TO_NS = 1e9f;
+  PoEndRecord r;
+  r.why = admissionReason(pe, sta, network, latch_cache);
+  r.has_path = pe && pe->path();
+  r.endpoint = r.has_path ? network->pathName(pe->path()->pin(sta)) : "NULL";
+  if (!r.why.empty() || !r.has_path) {
+    return r;
+  }
+  sta::PathExpanded expanded(pe->path(), sta);
+  if (expanded.size() == 0) {
+    r.expanded_empty = true;
+    return r;
+  }
+  const auto* sp = expanded.startPath();
+  if (sp) {
+    sta::Pin* pin = sp->pin(sta);
+    sta::Instance* inst = pin ? network->instance(pin) : nullptr;
+    odb::dbInst* odb_inst = inst ? network->staToDb(inst) : nullptr;
+    if (odb_inst) {
+      auto it = inst_to_name.find(odb_inst);
+      r.ff = (it != inst_to_name.end()) ? it->second : odb_inst->getName();
+    }
+  }
+  r.slack_ns = sta::delayAsFloat(pe->slack(sta)) * SEC_TO_NS;
+  return r;
+}
+
+}  // namespace
+
+TimingGraphExtractor::TimingGraphExtractor(odb::dbBlock* block,
+                                           sta::dbSta* sta,
+                                           sta::dbNetwork* network,
+                                           utl::Logger* logger)
+    : block_(block), sta_(sta), network_(network), logger_(logger)
+{
+}
+
+// Header: from_ff,to_ff,slack_max_ns,slack_min_ns,arrival_max_ns,
+// arrival_min_ns,required_max_ns,required_min_ns,from_x,from_y,from_tier,
+// to_x,to_y,to_tier,from_clock_net,to_clock_net.  An unmeasured corner is
+// written as inf (not 0), so it cannot be read as a real zero slack.
+void TimingGraphExtractor::writeCSV(const std::vector<FFEdge>& edges,
+                                    const std::string& output_file)
+{
+  std::ofstream file(output_file);
+  if (!file.is_open()) {
+    logger_->error(utl::CTS, 309, "Cannot open output file: {}", output_file);
+  }
+
+  file << "from_ff,to_ff,slack_max_ns,slack_min_ns,arrival_max_ns,arrival_min_"
+          "ns,required_max_ns,required_min_ns,from_x,from_y,from_tier,to_x,to_"
+          "y,to_tier,from_clock_net,to_clock_net\n";
+
+  const float kUnmeasured = std::numeric_limits<float>::infinity();
+
+  for (const auto& edge : edges) {
+    const float smax = edge.has_timing ? edge.slack_max : kUnmeasured;
+    const float smin = edge.has_hold ? edge.slack_min : kUnmeasured;
+    file << edge.from_ff << "," << edge.to_ff << "," << smax << "," << smin
+         << "," << edge.arrival_max << "," << edge.arrival_min << ","
+         << edge.required_max << "," << edge.required_min << ","
+         << edge.from_x << "," << edge.from_y << "," << edge.from_tier << ","
+         << edge.to_x << "," << edge.to_y << "," << edge.to_tier << ","
+         << edge.from_clock_net << "," << edge.to_clock_net << "\n";
+  }
+
+  file.close();
+
+  logger_->info(
+      utl::CTS, 310, "Wrote {} edges to {}", edges.size(), output_file);
+}
+
+// IO edges.  Input ports: one query per port (setup, hold, removal, recovery);
+// output ports: one query per launch register to all output ports (setup,
+// hold).  The endpoint bound is the whole pin universe, so no end is
+// truncated; reaching the bound is an error.  Input ports: one query with all
+// check roles; the ends are split by path group and consumed in the order
+// setup, hold, removal, recovery.  Output ports: the register -> output-port
+// ends stashed by extractRegisterEdges are replayed (re-queried when the stash
+// is not valid for this block and timing state).
+std::vector<IOEdge> TimingGraphExtractor::extractIOEdges()
+{
+  std::vector<IOEdge> result;
+
+  if (!sta_ || !network_ || !block_) {
+    logger_->warn(utl::CTS,
+                  600,
+                  "IO extraction: STA/network/block not available, skipped");
+    return result;
+  }
+
+  sta_->ensureGraph();
+  sta_->ensureClkArrivals();
+  sta_->updateTiming(false);
+
+  int endpoint_limit = 1 + block_->getBTerms().size();
+  for (auto* inst : block_->getInsts()) {
+    endpoint_limit += inst->getITerms().size();
+  }
+  std::unordered_map<const sta::Instance*, bool> latch_cache;
+  const std::string base
+      = std::getenv("RESULTS_DIR") ? std::getenv("RESULTS_DIR") : ".";
+  std::ofstream audit(base + "/io_admission_events.csv");
+  audit << "status,reason,endpoint\n";
+  size_t unsupported = 0, retained = 0;
+  // Partition bookkeeping for the merge step (inactive unless N > 1).
+  const LaunchPartition part = launchPartition();
+  const bool parted = part.total > 1;
+  std::vector<std::string> part_keys;  // edge_map keys in first-insert order
+  struct IoSegment
+  {
+    int order;        // -1 = input-port side, else single-process launch order
+    long audit_end;   // byte offset in io_admission_events.csv after the segment
+    size_t keys_end;  // part_keys.size() after the segment
+    std::string name;
+  };
+  std::vector<IoSegment> part_segs;
+  auto accepted = [&](sta::PathEnd* pe) {
+    auto why = admissionReason(pe, sta_, network_, latch_cache);
+    if (!why.empty()) {
+      ++unsupported;
+      audit << "unsupported," << why << ","
+            << (pe && pe->path() ? network_->pathName(pe->path()->pin(sta_))
+                                 : "NULL")
+            << "\n";
+      return false;
+    }
+    ++retained;
+    return true;
+  };
+  constexpr float SEC_TO_NS = 1e9f;
+
+  std::unordered_map<odb::dbInst*, std::string> inst_to_name;
+  for (const auto& [name, inst] : odb_registers_) {
+    inst_to_name[inst] = name;
+  }
+
+  // Data input / output ports (clock ports are skipped).
+  std::vector<odb::dbBTerm*> input_ports, output_ports;
+  for (auto* bterm : block_->getBTerms()) {
+    odb::dbSigType sig = bterm->getSigType();
+    if (sig == odb::dbSigType::CLOCK) {
+      continue;
+    }
+    auto io = bterm->getIoType();
+    if (io == odb::dbIoType::INPUT) {
+      input_ports.push_back(bterm);
+    } else if (io == odb::dbIoType::OUTPUT) {
+      output_ports.push_back(bterm);
+    }
+  }
+
+  logger_->info(utl::CTS,
+                601,
+                "IO extraction: {} input ports, {} output ports",
+                input_ports.size(),
+                output_ports.size());
+
+  // key "type|port|ff" -> edge (worst slack per pair and corner)
+  std::unordered_map<std::string, IOEdge> edge_map;
+
+  auto getFFName = [&](sta::Pin* pin) -> std::string {
+    if (!pin) {
+      return "";
+    }
+    sta::Instance* inst = network_->instance(pin);
+    if (!inst) {
+      return "";
+    }
+    odb::dbInst* odb_inst = network_->staToDb(inst);
+    if (!odb_inst) {
+      return "";
+    }
+    auto it = inst_to_name.find(odb_inst);
+    if (it != inst_to_name.end()) {
+      return it->second;
+    }
+    return odb_inst->getName();
+  };
+
+  std::unordered_map<std::string, std::string> io_ff_clock_cache;
+  for (const auto& [name, inst] : odb_registers_) {
+    io_ff_clock_cache[name] = traceClockNetRoot(inst);
+  }
+
+  int pi_setup_ct = 0, pi_hold_ct = 0, po_setup_ct = 0, po_hold_ct = 0;
+  int pi_removal_ct = 0, pi_recovery_ct = 0;
+  int po_setup_ends = 0, po_ff_empty = 0;
+
+  // ==================== input port -> register ====================
+  auto piQuery = [&](sta::Pin* port_pin,
+                     const sta::MinMaxAll* mm,
+                     bool setup,
+                     bool hold,
+                     bool recovery,
+                     bool removal) {
+    sta::PinSet* from_pins = new sta::PinSet(network_);
+    from_pins->insert(port_pin);
+    sta::ExceptionFrom* from = sta_->makeExceptionFrom(
+        from_pins, nullptr, nullptr, sta::RiseFallBoth::riseFall());
+    return sta_->findPathEnds(from,
+                              nullptr,
+                              nullptr,
+                              false,
+                              nullptr,
+                              mm,
+                              endpoint_limit,
+                              1,
+                              true,
+                              false,
+                              -sta::INF,
+                              sta::INF,
+                              false,
+                              nullptr,
+                              setup,
+                              hold,
+                              recovery,
+                              removal,
+                              false,
+                              false);
+  };
+  // kind: 0 = setup, 1 = hold, 2 = removal, 3 = recovery.
+  auto piApply = [&](const std::string& port_name,
+                     const sta::PathEndSeq& path_ends,
+                     int kind) {
+    const bool is_max = (kind == 0 || kind == 3);
+    if (path_ends.size() >= static_cast<size_t>(endpoint_limit)) {
+      logger_->error(utl::CTS, 971, "IO extraction: endpoint bound saturated");
+    }
+    for (sta::PathEnd* pe : path_ends) {
+      if (!accepted(pe)) {
+        continue;
+      }
+      if (!pe) {
+        continue;
+      }
+      sta::Pin* end_pin = nullptr;
+      if (is_max) {
+        const sta::Path* path = pe->path();
+        if (!path) {
+          continue;
+        }
+        end_pin = path->pin(sta_);
+      } else {
+        sta::Vertex* end_vertex = pe->vertex(sta_);
+        if (!end_vertex) {
+          continue;
+        }
+        end_pin = end_vertex->pin();
+      }
+      std::string ff = getFFName(end_pin);
+      if (ff.empty()) {
+        continue;
+      }
+
+      std::string key = "PI_TO_FF|" + port_name + "|" + ff;
+      if (parted && !edge_map.count(key)) {
+        part_keys.push_back(key);
+      }
+      auto& e = edge_map[key];
+      e.edge_type = "PI_TO_FF";
+      e.port_name = port_name;
+      e.ff_name = ff;
+      e.ff_clock_net
+          = io_ff_clock_cache.count(ff) ? io_ff_clock_cache[ff] : "";
+      float slack = sta::delayAsFloat(pe->slack(sta_)) * SEC_TO_NS;
+      if (is_max) {
+        if (!e.has_setup || slack < e.slack_setup_ns) {
+          e.slack_setup_ns = slack;
+          e.has_setup = true;
+          if (kind == 0) {
+            pi_setup_ct++;
+          } else {
+            pi_recovery_ct++;
+          }
+        }
+      } else {
+        // Removal (asynchronous hold) is merged into the hold slack.
+        if (!e.has_hold || slack < e.slack_hold_ns) {
+          e.slack_hold_ns = slack;
+          e.has_hold = true;
+          if (kind == 1) {
+            pi_hold_ct++;
+          } else {
+            pi_removal_ct++;
+          }
+        }
+      }
+    }
+  };
+
+  for (auto* bterm : input_ports) {
+    // The input-port side is not per launch: only partition 0 runs it.
+    if (parted && part.id != 0) {
+      break;
+    }
+    std::string port_name = bterm->getName();
+    sta::Pin* port_pin = network_->dbToSta(bterm);
+    if (!port_pin) {
+      continue;
+    }
+
+    // Fused query: PathGroups builds the max groups from (setup, recovery)
+    // and the min groups from (hold, removal), so one call with all four
+    // flags returns the union of the four separate calls (clock/named groups
+    // <- setup|hold, "asynchronous" group <- recovery|removal); the group
+    // path count is a per-group bound.  Split by group, then emit in the
+    // separate-query order.
+    sta::PathEndSeq all_ends = piQuery(
+        port_pin, sta::MinMaxAll::all(), true, true, true, true);
+    sta::PathEndSeq split[4];
+    for (sta::PathEnd* pe : all_ends) {
+      const bool is_min = pe && pe->minMax(sta_) == sta::MinMax::min();
+      const bool is_async
+          = pe && pe->pathGroup()
+            && std::strcmp(pe->pathGroup()->name(),
+                           sta::PathGroups::asyncPathGroupName())
+                   == 0;
+      split[is_min ? (is_async ? 2 : 1) : (is_async ? 3 : 0)].push_back(pe);
+    }
+    for (int kind = 0; kind < 4; ++kind) {
+      piApply(port_name, split[kind], kind);
+    }
+
+  }
+
+  if (parted) {
+    part_segs.push_back(
+        {-1, static_cast<long>(audit.tellp()), part_keys.size(), ""});
+  }
+
+  // ==================== register -> output port ====================
+  // Row emission from a plain-value record, shared by the query path and the
+  // replay path.
+  auto poConsume = [&](const PoEndRecord& r, bool is_setup) {
+    if (!r.why.empty()) {
+      ++unsupported;
+      audit << "unsupported," << r.why << "," << r.endpoint << "\n";
+      return;
+    }
+    ++retained;
+    if (!r.has_path) {
+      return;
+    }
+    if (r.expanded_empty) {
+      return;
+    }
+    // The launch register is the expanded path start (path(0) is the clock
+    // source).
+    if (r.ff.empty()) {
+      if (is_setup) {
+        po_ff_empty++;
+      }
+      return;
+    }
+    const std::string& ff = r.ff;
+    const std::string& port_name = r.endpoint;
+    std::string key = "FF_TO_PO|" + port_name + "|" + ff;
+    if (parted && !edge_map.count(key)) {
+      part_keys.push_back(key);
+    }
+    auto& e = edge_map[key];
+    e.edge_type = "FF_TO_PO";
+    e.port_name = port_name;
+    e.ff_name = ff;
+    e.ff_clock_net = io_ff_clock_cache.count(ff) ? io_ff_clock_cache[ff] : "";
+    float slack = r.slack_ns;
+    if (is_setup) {
+      if (!e.has_setup || slack < e.slack_setup_ns) {
+        e.slack_setup_ns = slack;
+        e.has_setup = true;
+        po_setup_ct++;
+      }
+    } else {
+      if (!e.has_hold || slack < e.slack_hold_ns) {
+        e.slack_hold_ns = slack;
+        e.has_hold = true;
+        po_hold_ct++;
+      }
+    }
+  };
+  auto poQuery = [&](sta::Instance* source_inst,
+                     const sta::MinMaxAll* mm,
+                     bool setup,
+                     bool hold) {
+    sta::InstanceSet* from_insts = new sta::InstanceSet(network_);
+    from_insts->insert(source_inst);
+    sta::ExceptionFrom* from = sta_->makeExceptionFrom(
+        nullptr, nullptr, from_insts, sta::RiseFallBoth::riseFall());
+    sta::PinSet* to_pins = new sta::PinSet(network_);
+    for (auto* bterm : output_ports) {
+      to_pins->insert(network_->dbToSta(bterm));
+    }
+    sta::ExceptionTo* to
+        = sta_->makeExceptionTo(to_pins,
+                                nullptr,
+                                nullptr,
+                                sta::RiseFallBoth::riseFall(),
+                                sta::RiseFallBoth::riseFall());
+    return sta_->findPathEnds(from,
+                              nullptr,
+                              to,
+                              false,
+                              nullptr,
+                              mm,
+                              endpoint_limit,
+                              1,
+                              true,
+                              false,
+                              -sta::INF,
+                              sta::INF,
+                              false,
+                              nullptr,
+                              setup,
+                              hold,
+                              false,
+                              false,
+                              false,
+                              false);
+  };
+  auto poApply = [&](const sta::PathEndSeq& path_ends, bool is_setup) {
+    if (is_setup) {
+      po_setup_ends += static_cast<int>(path_ends.size());
+    }
+    if (path_ends.size() >= static_cast<size_t>(endpoint_limit)) {
+      logger_->error(utl::CTS, 2022, "IO extraction: endpoint bound saturated");
+    }
+    for (sta::PathEnd* pe : path_ends) {
+      poConsume(makePoEndRecord(pe, sta_, network_, latch_cache, inst_to_name),
+                is_setup);
+    }
+  };
+
+  // Replay the register-pass stash only when it was taken on this block with
+  // the same register universe and an unchanged timing fingerprint.
+  // Registers without a stash entry (another partition) are re-queried.
+  PoCache& po_cache = poCache();
+  bool use_stash = false;
+  if (!output_ports.empty()) {
+    if (po_cache.valid && po_cache.block == block_ && !odb_registers_.empty()) {
+      float fp[4];
+      timingFingerprint(sta_, fp);
+      use_stash = std::memcmp(fp, po_cache.fingerprint, sizeof(fp)) == 0;
+    }
+    if (!use_stash) {
+      logger_->report(
+          "IO extraction: no valid register-pass stash; re-querying "
+          "register -> output port per register");
+    }
+  }
+
+  // Launches of this process: every register in odb_registers_ order, or the
+  // members of this partition only.
+  std::vector<LaunchMember> po_sources;
+  if (parted) {
+    po_sources = partitionMembers(odb_registers_, network_, part, nullptr);
+  } else {
+    po_sources.reserve(odb_registers_.size());
+    for (const auto& source : odb_registers_) {
+      po_sources.push_back({source.first, source.second, 0});
+    }
+  }
+  auto poOne = [&](odb::dbInst* source_odb) {
+    sta::Instance* source_inst = network_->dbToSta(source_odb);
+    if (output_ports.empty()) {
+      return;
+    }
+
+    if (use_stash) {
+      auto stash_it = po_cache.by_reg.find(source_odb);
+      if (stash_it != po_cache.by_reg.end()) {
+        const PoStash& stash = stash_it->second;
+        po_setup_ends += static_cast<int>(stash.setup.size());
+        for (const auto& r : stash.setup) {
+          poConsume(r, true);
+        }
+        for (const auto& r : stash.hold) {
+          poConsume(r, false);
+        }
+        return;
+      }
+    }
+
+    // Fused: max groups <- setup, min groups <- hold; split by min/max.
+    sta::PathEndSeq all_ends
+        = poQuery(source_inst, sta::MinMaxAll::all(), true, true);
+    sta::PathEndSeq max_ends, min_ends;
+    for (sta::PathEnd* pe : all_ends) {
+      if (pe && pe->minMax(sta_) == sta::MinMax::min()) {
+        min_ends.push_back(pe);
+      } else {
+        max_ends.push_back(pe);
+      }
+    }
+    poApply(max_ends, true);
+    poApply(min_ends, false);
+
+  };
+  for (const auto& source : po_sources) {
+    poOne(source.inst);
+    if (parted) {
+      part_segs.push_back({source.order,
+                           static_cast<long>(audit.tellp()),
+                           part_keys.size(),
+                           source.name});
+    }
+  }
+  po_cache = PoCache();  // one-shot: a stash is never replayed twice
+
+  result.reserve(edge_map.size());
+  for (auto& [key, edge] : edge_map) {
+    result.push_back(std::move(edge));
+  }
+
+  logger_->info(utl::CTS,
+                602,
+                "IO extraction: {} IO edges (PI->FF: setup={}, hold={}, "
+                "removal={}, recovery={}; FF->PO: setup={}, hold={}; FF->PO "
+                "setup ends={}, unresolved launch={}, output ports={})",
+                result.size(),
+                pi_setup_ct,
+                pi_hold_ct,
+                pi_removal_ct,
+                pi_recovery_ct,
+                po_setup_ct,
+                po_hold_ct,
+                po_setup_ends,
+                po_ff_empty,
+                static_cast<int>(output_ports.size()));
+
+  std::ofstream receipt(base + "/io_admission.status");
+  receipt << (unsupported ? "BLOCKED" : "VALID")
+          << "\nretained_pathends=" << retained
+          << "\nunsupported=" << unsupported << "\n";
+  if (parted) {
+    // Index for the partition merge step: "S" = segment (input-port side or one
+    // launch), "K" = edge_map key in first-insert order, "P" = counters.
+    std::ofstream index(base + "/io_partition_index.csv");
+    index << "#partition=" << part.id << "/" << part.total << "\n";
+    index << "P," << pi_setup_ct << "," << pi_hold_ct << "," << pi_removal_ct
+          << "," << pi_recovery_ct << "," << po_setup_ct << "," << po_hold_ct
+          << "," << retained << "," << unsupported << "\n";
+    for (const auto& seg : part_segs) {
+      index << "S," << seg.order << "," << seg.audit_end << "," << seg.keys_end
+            << "," << seg.name << "\n";
+    }
+    for (const auto& key : part_keys) {
+      index << "K," << key << "\n";
+    }
+  }
+  return result;
+}
+
+// Header: edge_type,port_name,ff_name,slack_setup_ns,slack_hold_ns,ff_clock_net
+// (an unmeasured slack is written as an empty field).
+void TimingGraphExtractor::writeIOCSV(const std::vector<IOEdge>& edges,
+                                      const std::string& output_file)
+{
+  std::ofstream file(output_file);
+  if (!file.is_open()) {
+    logger_->error(
+        utl::CTS, 603, "Cannot open IO output file: {}", output_file);
+  }
+
+  file << "edge_type,port_name,ff_name,slack_setup_ns,slack_hold_ns,ff_clock_"
+          "net\n";
+
+  for (const auto& e : edges) {
+    file << e.edge_type << "," << e.port_name << "," << e.ff_name << ",";
+    if (e.has_setup) {
+      file << e.slack_setup_ns;
+    }
+    file << ",";
+    if (e.has_hold) {
+      file << e.slack_hold_ns;
+    }
+    file << "," << e.ff_clock_net << "\n";
+  }
+
+  file.close();
+
+  int pi_ct = 0, po_ct = 0;
+  for (const auto& e : edges) {
+    if (e.edge_type == "PI_TO_FF") {
+      pi_ct++;
+    } else {
+      po_ct++;
+    }
+  }
+
+  logger_->info(utl::CTS,
+                604,
+                "IO extraction: wrote {} IO edges to {} (PI->FF: {}, FF->PO: {})",
+                edges.size(),
+                output_file,
+                pi_ct,
+                po_ct);
+}
+
+// Register universe: every instance with a sequential Liberty cell, plus every
+// placed macro (macro clock pins are CTS sinks although a macro model has no
+// sequential group).  The LP universe must contain the macros so that input
+// port -> macro and register -> macro hold edges are enforced.
+void TimingGraphExtractor::collectRegisters()
+{
+  if (!block_ || !network_) {
+    logger_->warn(utl::CTS,
+                  610,
+                  "Timing graph: block or network not available, no registers "
+                  "collected");
+    return;
+  }
+
+  odb_registers_.clear();
+
+  for (auto* inst : block_->getInsts()) {
+    sta::Instance* sta_inst = network_->dbToSta(inst);
+    if (!sta_inst) {
+      continue;
+    }
+    sta::LibertyCell* lib_cell = network_->libertyCell(sta_inst);
+    if (!lib_cell) {
+      continue;
+    }
+    if (lib_cell->hasSequentials()) {
+      std::string name = inst->getName();
+      odb_registers_[name] = inst;
+    }
+  }
+
+  const int seq_count = odb_registers_.size();
+
+  int macro_count = 0;
+  for (auto* inst : block_->getInsts()) {
+    if (!isMacroBlockInst(inst)) {
+      continue;
+    }
+    if (!inst->isPlaced()) {
+      continue;
+    }
+    std::string name = inst->getName();
+    if (odb_registers_.count(name)) {
+      continue;  // already collected as sequential
+    }
+    odb_registers_[name] = inst;
+    ++macro_count;
+  }
+
+  logger_->info(utl::CTS,
+                611,
+                "Timing graph: {} registers ({} sequential + {} macro)",
+                odb_registers_.size(),
+                seq_count,
+                macro_count);
+}
+
+std::string TimingGraphExtractor::traceClockNetRoot(odb::dbInst* ff_inst) const
+{
+  if (!ff_inst || !block_) {
+    return "";
+  }
+
+  odb::dbITerm* clk_iterm = nullptr;
+  for (odb::dbITerm* iterm : ff_inst->getITerms()) {
+    if (iterm->getSigType() == odb::dbSigType::CLOCK) {
+      clk_iterm = iterm;
+      break;
+    }
+  }
+  if (!clk_iterm) {
+    return "";
+  }
+
+  odb::dbNet* net = clk_iterm->getNet();
+  if (!net) {
+    return "";
+  }
+
+  constexpr int MAX_DEPTH = 50;
+  for (int depth = 0; depth < MAX_DEPTH; ++depth) {
+    for (odb::dbBTerm* bterm : net->getBTerms()) {
+      if (bterm->getIoType() == odb::dbIoType::INPUT) {
+        return net->getName();  // port-driven: root clock net
+      }
+    }
+
+    odb::dbITerm* driver = net->getFirstOutput();
+    if (!driver) {
+      return net->getName();
+    }
+
+    odb::dbInst* driver_inst = driver->getInst();
+    if (!driver_inst) {
+      return net->getName();
+    }
+
+    odb::dbITerm* input_iterm = nullptr;
+    int input_count = 0;
+    for (odb::dbITerm* iterm : driver_inst->getITerms()) {
+      if (iterm->isInputSignal()) {
+        input_iterm = iterm;
+        input_count++;
+      }
+    }
+
+    if (input_count != 1 || !input_iterm) {
+      return net->getName();  // e.g. a clock gater: effective root
+    }
+
+    odb::dbNet* next_net = input_iterm->getNet();
+    if (!next_net || next_net == net) {
+      return net->getName();
+    }
+    net = next_net;
+  }
+
+  return net->getName();  // depth limit reached
+}
+
+// Register -> register edges.  One findPathEnds per launch register, bound by
+// the whole pin universe (one path per endpoint); hitting the bound is an
+// error.  Every admitted end at a register becomes (or updates) the edge
+// launch -> capture with the worst setup / hold path.  An identity row per
+// launch keeps registers without register -> register paths in the LP
+// universe (no constraint, no fabricated zero slack).
+// One query per launch with MinMaxAll::all() and all check roles; the ends
+// are split by min/max and consumed setup first, then hold.  The register ->
+// output-port ends are stashed for the IO pass.
+//   EXTRACT_PARTITION=k/N : this process handles partition k of N launches.
+std::vector<FFEdge> TimingGraphExtractor::extractRegisterEdges()
+{
+  std::vector<FFEdge> edges;
+
+  if (!sta_ || !network_ || !block_) {
+    logger_->warn(utl::CTS,
+                  612,
+                  "Timing graph: STA/network/block not available, no edges");
+    return edges;
+  }
+
+  if (odb_registers_.empty()) {
+    logger_->warn(utl::CTS,
+                  613,
+                  "Timing graph: no registers (collectRegisters not called or "
+                  "empty design)");
+    return edges;
+  }
+
+  sta_->ensureGraph();
+  sta_->ensureClkArrivals();
+  sta_->updateTiming(false);
+
+  constexpr float SEC_TO_NS = 1e9f;
+
+  int n_path_limit = 1 + block_->getBTerms().size();
+  for (auto* inst : block_->getInsts()) {
+    n_path_limit += inst->getITerms().size();
+  }
+  const std::string base
+      = std::getenv("RESULTS_DIR") ? std::getenv("RESULTS_DIR") : ".";
+  std::ofstream admission(base + "/ff_admission_events.csv");
+  admission << "status,reason,source,endpoint,mode,slack_ns\n";
+  std::unordered_map<const sta::Instance*, bool> latch_cache;
+  size_t unsupported = 0, retained = 0, empty_queries = 0;
+
+  const auto t_begin = std::chrono::steady_clock::now();
+  // Register -> output-port ends seen by this pass are stashed per launch for
+  // the IO pass.  An older stash is dropped first.
+  PoCache& po_cache = poCache();
+  po_cache = PoCache();
+  std::unordered_set<const sta::Pin*> po_pins;  // == IO-pass -to pin set
+  std::unordered_map<odb::dbInst*, std::string> inst_to_name;
+  PoStash* cur_stash = nullptr;  // stash of the current launch
+  for (auto* bterm : block_->getBTerms()) {
+    if (bterm->getSigType() == odb::dbSigType::CLOCK) {
+      continue;
+    }
+    if (bterm->getIoType() != odb::dbIoType::OUTPUT) {
+      continue;
+    }
+    if (const sta::Pin* pin = network_->dbToSta(bterm)) {
+      po_pins.insert(pin);
+    }
+  }
+  for (const auto& [name, inst] : odb_registers_) {
+    inst_to_name[inst] = name;
+  }
+
+  std::unordered_set<odb::dbInst*> register_set;
+  for (const auto& [name, inst] : odb_registers_) {
+    register_set.insert(inst);
+  }
+
+  auto fillFromODB = [&](odb::dbInst* inst, int& x, int& y, int& tier) {
+    inst->getLocation(x, y);
+    if (cts3dDb_) {
+      tier = cts3dDb_->getInstTier(inst);
+    } else {
+      std::string master = inst->getMaster()->getName();
+      tier = (master.find("_upper") != std::string::npos) ? 1 : 0;
+    }
+  };
+
+  std::unordered_map<std::string, std::string> ff_clock_cache;
+  for (const auto& [name, inst] : odb_registers_) {
+    ff_clock_cache[name] = traceClockNetRoot(inst);
+  }
+  int n_traced = 0, n_untraceable = 0;
+  for (const auto& [name, clk] : ff_clock_cache) {
+    if (clk.empty()) {
+      n_untraceable++;
+    } else {
+      n_traced++;
+    }
+  }
+  logger_->info(utl::CTS,
+                616,
+                "Timing graph: traced {} registers to root clock nets ({} "
+                "untraceable)",
+                n_traced,
+                n_untraceable);
+
+  // Integer register ids (iteration order of odb_registers_); edge key =
+  // (src_id << 32) | dst_id.
+  std::unordered_map<std::string, int> ff_name_to_id;
+  {
+    int id = 0;
+    for (const auto& [name, inst] : odb_registers_) {
+      ff_name_to_id[name] = id++;
+    }
+  }
+  std::unordered_map<odb::dbInst*, int> capture_odb_to_id;
+  for (const auto& [name, inst] : odb_registers_) {
+    capture_odb_to_id[inst] = ff_name_to_id[name];
+  }
+
+  std::unordered_map<uint64_t, size_t> edge_map;
+
+  int setup_found = 0;
+  int hold_found = 0;
+  int total_sta_calls = 0;
+
+  struct SourceFF
+  {
+    std::string name;
+    odb::dbInst* odb_inst;
+    sta::Instance* sta_inst;
+  };
+  std::vector<SourceFF> all_sources;
+  all_sources.reserve(odb_registers_.size());
+  for (const auto& [name, inst] : odb_registers_) {
+    sta::Instance* sta_inst = network_->dbToSta(inst);
+    if (sta_inst) {
+      all_sources.push_back({name, inst, sta_inst});
+    }
+  }
+
+  // Per-launch index for the merge step (filled only when partitioned).
+  const LaunchPartition part = launchPartition();
+  std::vector<int> part_order;        // single-process position per source
+  std::vector<size_t> part_edge_end;  // edges.size() after each source
+  std::vector<long> part_event_end;   // admission byte offset after each source
+  const size_t n_all_sources = all_sources.size();
+  if (part.total > 1) {
+    logger_->info(utl::CTS,
+                  618,
+                  "Timing graph: partition {}/{} ({} of {} sources)",
+                  part.id,
+                  part.total,
+                  (static_cast<int>(all_sources.size()) + part.total - 1)
+                      / part.total,
+                  all_sources.size());
+  }
+
+  std::vector<SourceFF> sources;
+  if (part.total <= 1) {
+    sources = std::move(all_sources);
+  } else {
+    // Members in name order; member.order indexes all_sources (both skip
+    // registers without an STA instance and iterate odb_registers_).
+    int n_universe = 0;
+    for (const auto& member :
+         partitionMembers(odb_registers_, network_, part, &n_universe)) {
+      if (member.order < 0
+          || member.order >= static_cast<int>(all_sources.size())
+          || all_sources[member.order].odb_inst != member.inst) {
+        logger_->error(utl::CTS, 1973, "Launch partition order mismatch");
+      }
+      sources.push_back(all_sources[member.order]);
+      part_order.push_back(member.order);
+    }
+    if (n_universe != static_cast<int>(all_sources.size())) {
+      logger_->error(utl::CTS, 2029, "Launch partition universe mismatch");
+    }
+  }
+
+  struct SourceInfo
+  {
+    int x;
+    int y;
+    int tier;
+  };
+  std::unordered_map<odb::dbInst*, SourceInfo> src_info_cache;
+  for (const auto& s : sources) {
+    SourceInfo si;
+    fillFromODB(s.odb_inst, si.x, si.y, si.tier);
+    src_info_cache[s.odb_inst] = si;
+  }
+
+  std::unordered_map<odb::dbInst*, int> odb_to_src_idx;
+  for (int i = 0; i < static_cast<int>(sources.size()); ++i) {
+    odb_to_src_idx[sources[i].odb_inst] = i;
+  }
+
+  logger_->info(utl::CTS,
+                617,
+                "Timing graph: {} sources, endpoint bound per source {}",
+                sources.size(),
+                n_path_limit);
+
+  // Admit the ends of one launch and update edge_map.
+  auto processPathEnds = [&](const sta::PathEndSeq& path_ends,
+                             const std::unordered_set<odb::dbInst*>& launch_set,
+                             bool is_setup) {
+    for (sta::PathEnd* path_end : path_ends) {
+      if (!path_end) {
+        continue;
+      }
+
+      const sta::Path* data_path = path_end->path();
+      if (!data_path) {
+        continue;
+      }
+
+      sta::Pin* end_pin
+          = is_setup ? data_path->pin(sta_)
+                     : (path_end->vertex(sta_) ? path_end->vertex(sta_)->pin()
+                                               : nullptr);
+      if (!end_pin) {
+        continue;
+      }
+
+      // Copy what the IO pass needs from an end at an output port; the end
+      // itself is processed below like any other end.
+      if (cur_stash && po_pins.count(end_pin)) {
+        (is_setup ? cur_stash->setup : cur_stash->hold)
+            .push_back(makePoEndRecord(
+                path_end, sta_, network_, latch_cache, inst_to_name));
+      }
+
+      sta::Instance* end_inst = network_->instance(end_pin);
+      if (!end_inst) {
+        continue;
+      }
+      odb::dbInst* end_odb = network_->staToDb(end_inst);
+      if (!end_odb || register_set.find(end_odb) == register_set.end()) {
+        std::string why
+            = admissionReason(path_end, sta_, network_, latch_cache);
+        if (!why.empty()) {
+          ++unsupported;
+          admission << "unsupported," << why << ",UNKNOWN,"
+                    << network_->pathName(end_pin) << "," << is_setup << ","
+                    << sta::delayAsFloat(path_end->slack(sta_)) * SEC_TO_NS
+                    << "\n";
+        }
+        continue;  // constrained register -> port ends: IO extraction
+      }
+
+      auto cap_id_it = capture_odb_to_id.find(end_odb);
+      if (cap_id_it == capture_odb_to_id.end()) {
+        continue;
+      }
+      int dst_id = cap_id_it->second;
+
+      std::string why = admissionReason(path_end, sta_, network_, latch_cache);
+      sta::PathExpanded expanded(data_path, sta_);
+      const auto* start_path = expanded.startPath();
+      auto* start_pin = start_path ? start_path->pin(sta_) : nullptr;
+      auto* start_inst = start_pin ? network_->instance(start_pin) : nullptr;
+      odb::dbInst* launch_odb
+          = start_inst ? network_->staToDb(start_inst) : nullptr;
+      if (why.empty() && (!launch_odb || !launch_set.count(launch_odb))) {
+        why = "unsupported_startpoint_projection";
+      }
+      if (!why.empty()) {
+        ++unsupported;
+        admission << "unsupported," << why << ","
+                  << (launch_odb ? launch_odb->getName() : "NULL") << ","
+                  << network_->pathName(end_pin) << "," << is_setup << ","
+                  << sta::delayAsFloat(path_end->slack(sta_)) * SEC_TO_NS
+                  << "\n";
+        continue;
+      }
+      ++retained;
+      if (sta::delayAsFloat(path_end->slack(sta_)) * SEC_TO_NS < 0.012f) {
+        admission << "retained,constrained_native_pathend,"
+                  << launch_odb->getName() << "," << network_->pathName(end_pin)
+                  << "," << is_setup << ","
+                  << sta::delayAsFloat(path_end->slack(sta_)) * SEC_TO_NS
+                  << "\n";
+      }
+      auto src_it = odb_to_src_idx.find(launch_odb);
+      if (src_it == odb_to_src_idx.end()) {
+        continue;
+      }
+      int src_local_idx = src_it->second;
+      const auto& src = sources[src_local_idx];
+
+      auto src_id_it = ff_name_to_id.find(src.name);
+      if (src_id_it == ff_name_to_id.end()) {
+        continue;
+      }
+      int src_id = src_id_it->second;
+
+      // Self paths keep their slack; the clock terms cancel in the LP.
+      uint64_t key = (static_cast<uint64_t>(src_id) << 32)
+                     | static_cast<uint64_t>(static_cast<uint32_t>(dst_id));
+
+      float slack = sta::delayAsFloat(path_end->slack(sta_)) * SEC_TO_NS;
+      float arrival = sta::delayAsFloat(data_path->arrival()) * SEC_TO_NS;
+      float required
+          = sta::delayAsFloat(path_end->requiredTime(sta_)) * SEC_TO_NS;
+
+      auto it = edge_map.find(key);
+      if (it == edge_map.end()) {
+        FFEdge edge;
+        edge.from_ff = src.name;
+        edge.to_ff = end_odb->getName();
+        edge.from_clock_net = ff_clock_cache.count(src.name)
+                                  ? ff_clock_cache[src.name]
+                                  : "";
+        edge.to_clock_net = ff_clock_cache.count(edge.to_ff)
+                                ? ff_clock_cache[edge.to_ff]
+                                : "";
+        const auto& si = src_info_cache[launch_odb];
+        edge.from_x = si.x;
+        edge.from_y = si.y;
+        edge.from_tier = si.tier;
+        auto cap_si = src_info_cache.find(end_odb);
+        if (cap_si != src_info_cache.end()) {
+          edge.to_x = cap_si->second.x;
+          edge.to_y = cap_si->second.y;
+          edge.to_tier = cap_si->second.tier;
+        } else {
+          fillFromODB(end_odb, edge.to_x, edge.to_y, edge.to_tier);
+        }
+        if (is_setup) {
+          edge.slack_max = slack;
+          edge.arrival_max = arrival;
+          edge.required_max = required;
+          edge.has_timing = true;
+          ++setup_found;
+        } else {
+          edge.slack_min = slack;
+          edge.arrival_min = arrival;
+          edge.required_min = required;
+          edge.has_hold = true;
+          ++hold_found;
+        }
+        edge_map[key] = edges.size();
+        edges.push_back(edge);
+      } else {
+        auto& existing = edges[it->second];
+        if (is_setup) {
+          if (!existing.has_timing || slack < existing.slack_max) {
+            existing.slack_max = slack;
+            existing.arrival_max = arrival;
+            existing.required_max = required;
+          }
+          existing.has_timing = true;
+        } else {
+          if (!existing.has_hold || slack < existing.slack_min) {
+            existing.slack_min = slack;
+            existing.arrival_min = arrival;
+            existing.required_min = required;
+          }
+          existing.has_hold = true;
+          ++hold_found;
+        }
+      }
+    }
+  };
+
+  // Record an empty query and admit the ends of launch `idx`.
+  auto consumeEnds = [&](int idx,
+                         const sta::PathEndSeq& path_ends,
+                         const std::unordered_set<odb::dbInst*>& launch_set,
+                         bool is_setup) {
+    int n_results = static_cast<int>(path_ends.size());
+    if (n_results >= n_path_limit) {
+      logger_->error(utl::CTS,
+                     2020,
+                     "Timing graph: native extraction saturated the "
+                     "endpoint bound");
+    }
+    if (n_results == 0) {
+      ++empty_queries;
+      admission << "inactive,no_constrained_pathend_for_source,"
+                << sources[idx].name << ",," << is_setup << ",\n";
+    }
+    processPathEnds(path_ends, launch_set, is_setup);
+  };
+
+  // Fused query of one launch.  PathGroups builds its max groups from (setup,
+  // recovery, clock-gating setup) and its min groups from (hold, removal,
+  // clock-gating hold), each with its own per-group bound, and keeps one end
+  // per (endpoint, group); so MinMaxAll::all() with all six roles returns the
+  // union of the two separate queries.  Consumed setup first, then hold.
+  auto fusedExtract = [&](int idx) {
+    sta::InstanceSet* from_insts = new sta::InstanceSet(network_);
+    std::unordered_set<odb::dbInst*> launch_set;
+    from_insts->insert(sources[idx].sta_inst);
+    launch_set.insert(sources[idx].odb_inst);
+    sta::ExceptionFrom* from = sta_->makeExceptionFrom(
+        nullptr, nullptr, from_insts, sta::RiseFallBoth::riseFall());
+    sta::PathEndSeq all_ends = sta_->findPathEnds(from,
+                                                  nullptr,
+                                                  nullptr,
+                                                  false,
+                                                  nullptr,
+                                                  sta::MinMaxAll::all(),
+                                                  n_path_limit,
+                                                  1,
+                                                  true,
+                                                  false,
+                                                  -sta::INF,
+                                                  sta::INF,
+                                                  false,
+                                                  nullptr,
+                                                  true,
+                                                  true,
+                                                  true,
+                                                  true,
+                                                  true,
+                                                  true);
+    ++total_sta_calls;
+
+    sta::PathEndSeq max_ends, min_ends;
+    for (sta::PathEnd* pe : all_ends) {
+      if (pe && pe->minMax(sta_) == sta::MinMax::min()) {
+        min_ends.push_back(pe);
+      } else {
+        max_ends.push_back(pe);
+      }
+    }
+    consumeEnds(idx, max_ends, launch_set, true);
+    consumeEnds(idx, min_ends, launch_set, false);
+  };
+
+  const int n_sources = static_cast<int>(sources.size());
+
+  auto t0 = std::chrono::high_resolution_clock::now();
+  const auto t_loop = std::chrono::steady_clock::now();
+
+  for (int idx = 0; idx < n_sources; ++idx) {
+    cur_stash = &po_cache.by_reg[sources[idx].odb_inst];
+
+    fusedExtract(idx);
+    cur_stash = nullptr;
+    if (part.total > 1) {
+      part_edge_end.push_back(edges.size());
+      part_event_end.push_back(static_cast<long>(admission.tellp()));
+    }
+
+    const int processed = idx + 1;
+    if (processed % 500 == 0 || processed == n_sources) {
+      auto t1 = std::chrono::high_resolution_clock::now();
+      double elapsed = std::chrono::duration<double>(t1 - t0).count();
+      logger_->info(utl::CTS,
+                    614,
+                    "Timing graph: {}/{} sources, {} edges, {} STA calls in "
+                    "{:.1f}s",
+                    processed,
+                    n_sources,
+                    edges.size(),
+                    total_sta_calls,
+                    elapsed);
+    }
+  }
+
+  auto t_end = std::chrono::high_resolution_clock::now();
+  double total_elapsed = std::chrono::duration<double>(t_end - t0).count();
+
+  logger_->info(utl::CTS,
+                615,
+                "Timing graph: {} edges (setup={}, hold={}) from {} sources, "
+                "{} STA calls in {:.1f}s",
+                edges.size(),
+                setup_found,
+                hold_found,
+                n_sources,
+                total_sta_calls,
+                total_elapsed);
+
+  // Identity rows: keep IO-only registers in the LP universe.  Both corners
+  // are unmeasured (inf), so they create no constraint.
+  for (const auto& src : sources) {
+    FFEdge e;
+    e.from_ff = src.name;
+    e.to_ff = src.name;
+    e.from_clock_net = ff_clock_cache[src.name];
+    e.to_clock_net = e.from_clock_net;
+    fillFromODB(src.odb_inst, e.from_x, e.from_y, e.from_tier);
+    e.to_x = e.from_x;
+    e.to_y = e.from_y;
+    e.to_tier = e.from_tier;
+    edges.push_back(e);
+  }
+  std::ofstream receipt(base + "/ff_admission.status");
+  receipt << (unsupported ? "BLOCKED" : "VALID") << "\n";
+  receipt << "retained_pathends=" << retained
+          << "\nunsupported=" << unsupported
+          << "\ninactive_source_modes=" << empty_queries << "\n";
+  logger_->info(utl::CTS,
+                2021,
+                "Timing graph admission: retained {} unsupported {} empty "
+                "queries {}",
+                retained,
+                unsupported,
+                empty_queries);
+  if (part.total > 1) {
+    // Index for the partition merge step: one row per launch in processing order:
+    // its single-process position, the end of its rows (row index in this
+    // partition's CSV, before the identity rows) and the end of its events
+    // (byte offset in ff_admission_events.csv).
+    const double prequery_s
+        = std::chrono::duration<double>(t_loop - t_begin).count();
+    std::ofstream index(base + "/ff_partition_index.csv");
+    index << "#partition=" << part.id << "/" << part.total
+          << " total_sources=" << n_all_sources
+          << " sources=" << sources.size()
+          << " edges=" << (edges.size() - sources.size())
+          << " retained=" << retained << " unsupported=" << unsupported
+          << " inactive_source_modes=" << empty_queries
+          << " prequery_s=" << prequery_s << "\n";
+    index << "order,edge_end,event_end,name\n";
+    for (size_t i = 0; i < sources.size(); ++i) {
+      index << part_order[i] << "," << part_edge_end[i] << ","
+            << part_event_end[i] << "," << sources[i].name << "\n";
+    }
+  }
+  // Publish the register -> output-port stash for the IO pass.
+  po_cache.block = block_;
+  timingFingerprint(sta_, po_cache.fingerprint);
+  po_cache.valid = true;
+
+  return edges;
+}
+
+}  // namespace cts
