+  // ---------- candidates ranked by the hold loss of the affected sinks ----------
+  struct Cand
+  {
+    int node;
+    double loss;
+    bool leaf;
+    bool sinkKind = false;
+    std::vector<int> moveSinks;
+    odb::dbMaster* newMaster = nullptr;  // resize candidate
+    bool co = false;  // joint resize with the early drivers on the root's input net
+  };
+  auto makeCand = [](int node, double loss, bool leaf) {
+    Cand x;
+    x.node = node;
+    x.loss = loss;
+    x.leaf = leaf;
+    return x;
+  };
+  const std::string kinds = envS("CTS_REFINE_KINDS", kDefaultKinds);
+  auto hasKind = [&](const char* k) {
+    return ("," + kinds + ",").find(std::string(",") + k + ",") != std::string::npos;
+  };
+  const bool doBypass = hasKind("bypass");
+  const bool doSink = hasKind("sink");
+  const bool doResize = hasKind("resize");
+  const double sinkSetupMargin
+      = envD("CTS_REFINE_SINK_SETUP_MARGIN_PS", kDefaultSinkSetupMarginPs);
+  // ---------- master families and per-tier row occupancy ----------
+  const int dbu = block->getDbUnitsPerMicron();
+  const int resizeRadius = static_cast<int>(
+      envD("CTS_REFINE_RESIZE_RADIUS_UM", kDefaultResizeRadiusUm) * dbu);
+  auto tierOf = [](const std::string& m) {
+    return m.find("_bottom") != std::string::npos ? 0 : (m.find("_upper") != std::string::npos ? 1 : -1);
+  };
+  auto family = [](const std::string& m) {  // drop digit runs and a drive suffix 'f'
+    std::string k;
+    for (size_t i = 0; i < m.size(); ++i) {
+      if (std::isdigit(static_cast<unsigned char>(m[i]))) {
+        while (i + 1 < m.size() && std::isdigit(static_cast<unsigned char>(m[i + 1]))) ++i;
+        if (i + 1 < m.size() && m[i + 1] == 'f') ++i;
+        continue;
+      }
+      k += m[i];
+    }
+    return k;
+  };
+  auto pinSig = [](odb::dbMaster* m) {
+    std::set<std::string> v;
+    for (odb::dbMTerm* t : m->getMTerms()) {
+      if (!t->getSigType().isSupply()) v.insert(t->getName() + (t->getIoType() == odb::dbIoType::OUTPUT ? ":o" : ":i"));
+    }
+    return v;
+  };
+  std::map<std::string, std::vector<odb::dbMaster*>> famMasters;
+  struct Row { int x0, y0, x1, y1, siteW; odb::dbOrientType orient; };
+  std::vector<Row> rows;
+  struct Seg { int x0, x1, tier; odb::dbInst* inst; };
+  std::unordered_map<int, std::vector<Seg>> occ;  // row y -> occupied spans
+  std::vector<int> rowYs;
+  int rowH = 0;
