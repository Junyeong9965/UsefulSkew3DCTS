+++ b/src/cts/src/StagePredictor.cpp
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+// Clock-arrival prediction through the buffer stages of the clock tree with
+// OpenSTA's delay kernel (gate delay, driver slew, wire delay and load slew per
+// buffer stage, slew propagated stage to stage).  STA arrivals are not used as
+// prediction inputs except at the boundaries: a pin that is not driven by a
+// buffer (port, clock gater, other cell) is a boundary seeded with its STA
+// arrival and slew, or, when CTS_STAGE_BOUNDARY_CSV names a boundary file
+// (key,arrival_s,slew_s), with the frozen values of that file (every boundary
+// must be present).  Used to predict the clock arrivals of a virtually edited
+// tree with the boundaries of the unedited tree.
+//
+// Output <path>: pin,kind(sink|buffer),mode(min|max),rf,root,depth,pred_ps,
+// sta_ps,slew_pred_ps,slew_sta_ps,base_ps,gates_ps,wires_ps,pin_cap_ff,
+// wire_cap_ff,direct_loads for every register clock pin and every pin of a
+// clkbuf* instance; <path>.boundaries.csv: the boundary seeds used.
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <fstream>
+#include <functional>
+#include <iomanip>
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <sstream>
+#include <cstdlib>
+#include "db_sta/dbSta.hh"
+#include "db_sta/dbNetwork.hh"
+#include "odb/db.h"
+#include "sta/ArcDelayCalc.hh"
+#include "sta/Corner.hh"
+#include "sta/DcalcAnalysisPt.hh"
+#include "sta/Graph.hh"
+#include "sta/GraphDelayCalc.hh"
+#include "sta/Liberty.hh"
+#include "sta/MinMax.hh"
+#include "sta/Network.hh"
+#include "sta/PortDirection.hh"
+#include "sta/TimingArc.hh"
+#include "utl/Logger.h"
+namespace cts {
+void runStagePredictor(odb::dbDatabase* db, sta::dbSta* sta, utl::Logger* logger,
+                       const char* path) {
+  const auto begin = std::chrono::steady_clock::now();
+  auto* netw=sta->getDbNetwork(); auto* graph=sta->graph();
+  auto* block=db->getChip()->getBlock(); auto* corner=sta->cmdCorner();
+  std::unique_ptr<sta::ArcDelayCalc> calc(sta->arcDelayCalc()->copy());
+  struct State { double a=0,s=0,base=0,gates=0,wires=0; int depth=0; std::string root; };
+  std::ofstream out(path); out<<std::setprecision(12);
+  out<<"pin,kind,mode,rf,root,depth,pred_ps,sta_ps,slew_pred_ps,slew_sta_ps,base_ps,gates_ps,wires_ps,pin_cap_ff,wire_cap_ff,direct_loads\n";
+  std::map<std::string,std::pair<double,double>> frozen;
+  if (const char* file=std::getenv("CTS_STAGE_BOUNDARY_CSV")) {
+    std::ifstream in(file); if(!in)logger->error(utl::CTS,889,"Cannot read frozen boundaries {}",file);
+    std::string line;std::getline(in,line);
+    while(std::getline(in,line)) {std::stringstream ss(line);std::string k,a,b;
+      std::getline(ss,k,',');std::getline(ss,a,',');std::getline(ss,b,',');
+      frozen[k]={std::stod(a),std::stod(b)};
+    }
+  }
+  std::ofstream seeds(std::string(path)+".boundaries.csv");
+  seeds<<std::setprecision(17)<<"key,arrival_s,slew_s\n";
+  size_t rows=0, kernels=0;
+  for (auto* mm : {sta::MinMax::min(),sta::MinMax::max()}) {
+    auto* ap=corner->findDcalcAnalysisPt(mm);
+    using Key=std::pair<const sta::Pin*,int>;
+    std::map<Key,State> predicted; std::set<Key> active;
+    auto boundary=[&](const sta::Pin* pin,const sta::RiseFall* rf) {
+      State x;
+      std::string k=std::string(netw->pathName(pin))+"|"+std::to_string(mm->index())+"|"+std::to_string(rf->index());
+      if(!frozen.empty()) {
+        if(!frozen.count(k))logger->error(utl::CTS,2011,"New boundary not present before edit: {}",k);
+        x.a=frozen.at(k).first;x.s=frozen.at(k).second;
+      } else {
+        x.a=sta::delayAsFloat(sta->pinArrival(pin,rf,mm));
+        x.s=sta::delayAsFloat(sta->vertexSlew(graph->pinLoadVertex(pin),rf,ap));
+      }
+      seeds<<k<<','<<x.a<<','<<x.s<<'\n';
+      x.base=x.a;x.root=netw->pathName(pin);return x;
+    };
+    std::function<State(const sta::Pin*,const sta::RiseFall*)> predict;
+    predict=[&](const sta::Pin* pin,const sta::RiseFall* rf)->State {
+      Key key{pin,rf->index()}; if(predicted.count(key))return predicted.at(key);
+      if(!active.insert(key).second)logger->error(utl::CTS,2008,"Stage predictor cycle at {}",netw->pathName(pin));
+      // The single buffer that drives this pin; otherwise the pin is a boundary.
+      auto* inst=netw->instance(pin);
+      auto* lib=inst?netw->libertyCell(inst):nullptr;
+      bool is_output=netw->direction(pin)->isAnyOutput();
+      const sta::Pin* driver=nullptr;
+      if(is_output && lib && lib->isBuffer())driver=pin;
+      if(!is_output) {
+        auto* vertex=graph->pinLoadVertex(pin);
+        if(vertex) {sta::VertexInEdgeIterator ei(vertex,graph);while(ei.hasNext()) {
+          auto* edge=ei.next();if(!edge->isWire())continue;
+          auto* dp=edge->from(graph)->pin(); auto* di=netw->instance(dp);
+          auto* dl=di?netw->libertyCell(di):nullptr;
+          if(dl && dl->isBuffer()) {
+            if(driver && driver!=dp)logger->error(utl::CTS,2009,"Unsupported multiple drivers");
+            driver=dp;
+          }
+        }}
+      }
+      if(!driver) {auto x=boundary(pin,rf);predicted[key]=x;active.erase(key);return x;}
+      auto* di=netw->instance(driver); auto* dl=netw->libertyCell(di);
+      sta::LibertyPort *ip,*op;dl->bufferPorts(ip,op);
+      auto* input=netw->findPin(di,ip);
+      auto parent=predict(input,rf);
+      sta::LoadPinIndexMap loads(netw);
+      auto* dv=graph->pinDrvrVertex(driver);
+      sta::VertexOutEdgeIterator ei(dv,graph);while(ei.hasNext()) {
+        auto* edge=ei.next();if(edge->isWire()) {
+          auto* lp=edge->to(graph)->pin();if(!loads.count(lp))loads[lp]=loads.size();
+        }
+      }
+      auto* parasitic=calc->findParasitic(driver,rf,ap);
+      float pc=0,wc=0;sta->graphDelayCalc()->loadCap(driver,rf,ap,pc,wc);
+      bool found=false;State best; unsigned matching_arcs=0;
+      for(auto* aset:dl->timingArcSets(ip,op)) for(auto* arc:aset->arcs()) {
+        if(!arc->fromEdge() || !arc->toEdge()
+          || arc->fromEdge()->asRiseFall()!=rf || arc->toEdge()->asRiseFall()!=rf)continue;
+        if (++matching_arcs > 1)
+          logger->error(utl::CTS,2017,"Unsupported multiple matching buffer arcs at {}",netw->pathName(driver));
+        auto result=calc->gateDelay(driver,arc,sta::Slew(parent.s),pc+wc,parasitic,loads,ap);++kernels;
+        State x=parent;double gd=sta::delayAsFloat(result.gateDelay());
+        x.a+=gd;x.gates+=gd;x.depth++;x.s=sta::delayAsFloat(result.drvrSlew());
+        State dr=x;
+        predicted[{driver,rf->index()}]=dr;
+        if(driver!=pin) {
+          if(!loads.count(pin))logger->error(utl::CTS,2010,"Missing direct load");
+          double wd=sta::delayAsFloat(result.wireDelay(loads.at(pin)));
+          x.a+=wd;x.wires+=wd;x.s=sta::delayAsFloat(result.loadSlew(loads.at(pin)));
+        }
+        if(!found || (mm==sta::MinMax::max()?x.a>best.a:x.a<best.a)){best=x;found=true;}
+      }
+      if(!found)logger->error(utl::CTS,887,"Unsupported buffer arc at {}",netw->pathName(driver));
+      predicted[key]=best;active.erase(key);return best;
+    };
+    for(auto* inst:block->getInsts()) for(auto* it:inst->getITerms()) {
+      auto* p=netw->dbToSta(it);
+      bool clock=netw->isRegClkPin(p);
+      bool buffer=std::string(inst->getName()).find("clkbuf")!=std::string::npos;
+      if(!clock && !buffer)continue;
+      if(it->getSigType()==odb::dbSigType::POWER || it->getSigType()==odb::dbSigType::GROUND)continue;
+      for(auto* rf:sta::RiseFall::range()) {
+        auto x=predict(p,rf); float pc=0,wc=0;int count=0;
+        if(it->getIoType()==odb::dbIoType::OUTPUT) {
+          sta->graphDelayCalc()->loadCap(p,rf,ap,pc,wc);
+          if(it->getNet()) for(auto* load:it->getNet()->getITerms())if(load->getIoType()==odb::dbIoType::INPUT)++count;
+        }
+        auto* v=it->getIoType()==odb::dbIoType::OUTPUT?graph->pinDrvrVertex(p):graph->pinLoadVertex(p);
+        out<<netw->pathName(p)<<','<<(clock?"sink":"buffer")<<','<<(mm==sta::MinMax::min()?"min":"max")<<','<<(rf==sta::RiseFall::rise()?"rise":"fall")<<','<<x.root<<','<<x.depth<<','<<x.a*1e12<<','
+           <<sta::delayAsFloat(sta->pinArrival(p,rf,mm))*1e12<<','<<x.s*1e12<<','<<sta::delayAsFloat(sta->vertexSlew(v,rf,ap))*1e12<<','
+           <<x.base*1e12<<','<<x.gates*1e12<<','<<x.wires*1e12<<','<<pc*1e15<<','<<wc*1e15<<','<<count<<'\n';++rows;
+      }
+    }
+  }
+  logger->info(utl::CTS,888,"Clock-arrival prediction: {} rows, {} delay-kernel calls, {:.3f}s (command corner; min/max x rise/fall; non-buffer boundaries seeded explicitly)",
+    rows,kernels,std::chrono::duration<double>(std::chrono::steady_clock::now()-begin).count());
+}
+}
