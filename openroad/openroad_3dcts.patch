+double read_r_hbt(const std::string& setrc)
+{
+  std::regex re(R"(^\s*set_layer_rc\s+-via\s+hb_layer\s+-resistance\s+(\S+))");
+  for (auto& line : read_lines(setrc)) {
+    std::smatch m;
+    if (std::regex_search(line, m, re)) return to_double(m[1].str()) * 1000.0;   // kOhm -> Ohm
+  }
+  fail("no hb_layer resistance in " + setrc);
+}
+
+NetDumps parse_nets(const std::string& path)
+{
+  NetDumps out;
+  double scale = 1e-15;
+  NetDump* cur = nullptr;
+  char sec = 0;
+  static const std::regex re_master(R"(\((\S+)\))");
+  static const std::regex re_cap(R"(\s([0-9.eE+-]+)-([0-9.eE+-]+)\s)");
+  for (auto& s : read_lines(path)) {
+    std::string t = strip(s);
+    if (starts_with(s, "CAP_UNIT")) { scale = to_double(split(strip(s), ' ')[1]); continue; }
+    if (starts_with(s, "Net ")) {
+      std::string name = strip(s.substr(4));
+      out.order.push_back(name);
+      cur = &out.nets[name];
+      *cur = NetDump();
+      sec = 0;
+      continue;
+    }
+    if (!cur) continue;
+    if (starts_with(t, "Wire capacitance:")) {
+      std::string v = t.substr(t.find(':') + 1);
+      v = v.substr(v.rfind('-') + 1);
+      cur->wc = to_double(strip(v)) * scale;
+      continue;
+    }
+    if (t == "Driver pins") { sec = 'd'; continue; }
+    if (t == "Load pins") { sec = 'l'; continue; }
+    std::vector<std::string> tok;
+    { std::istringstream ss(t); std::string w; while (ss >> w) tok.push_back(w); }
+    if (sec == 0 || tok.size() < 2 || (tok[1] != "input" && tok[1] != "output" && tok[1] != "bidirect")) continue;
+    std::smatch mm;
+    std::string master;
+    if (std::regex_search(t, mm, re_master) && mm[1].str().find(',') == std::string::npos) master = mm[1].str();
+    if (sec == 'd') cur->drv = tok[0];
+    else {
+      std::string padded = " " + t + " ";
+      std::smatch cm;
+      double c = std::regex_search(padded, cm, re_cap) ? to_double(cm[2].str()) * scale : 0.0;
+      cur->loads.push_back({tok[0], master, c});
+    }
+  }
+  return out;
+}
+
+double steiner_um(const std::vector<std::pair<double, double>>& pts)
+{
+  if (pts.size() < 2) return 0.0;
+  double xmin = pts[0].first, xmax = pts[0].first, ymin = pts[0].second, ymax = pts[0].second;
+  for (auto& p : pts) { xmin = std::min(xmin, p.first); xmax = std::max(xmax, p.first); ymin = std::min(ymin, p.second); ymax = std::max(ymax, p.second); }
+  double w = (xmax - xmin) / 1000.0, h = (ymax - ymin) / 1000.0;
+  double a = w + h, b = 0.7124 * std::sqrt((double) pts.size() * w * h);
+  return b > a ? b : a;
+}
