+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+// Early-clock decision data: the initial clock tree dump, the extracted timing graph, the scoped reference view,
+// the exact stored-check replay (per-endpoint minima under register clock shifts) and the hybrid-bond delay term.
+// Array orders and floating-point operation orders are fixed, so results are bit-reproducible.
+#pragma once
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "EarlyUtil.h"
+
+namespace cts::early {
+
+constexpr double SETUP_TOL = 0.5, HOLD_TOL = 0.02, MIN_GAIN = 1.0;   // ps
+
+struct TreeRow
+{
+  std::string inst, master, driver, in_net, out_net, kind;
+  int tier = 0;
+  long long x = 0, y = 0, w = 0;
+};
+// tree.csv (kind == "buffer" rows only when buffers_only); insertion order kept in `order`
+struct Tree
+{
+  std::unordered_map<std::string, TreeRow> rows;
+  std::vector<std::string> order;
+  bool has(const std::string& i) const { return rows.count(i) > 0; }
+  const TreeRow& at(const std::string& i) const
+  {
+    auto it = rows.find(i);
+    if (it == rows.end()) fail("tree: unknown instance " + i);
+    return it->second;
+  }
+};
+Tree load_tree(const std::string& dump, bool buffers_only);
+
+struct SinkRow
+{
+  std::string inst, pin, master, net, driver;
+  int tier = 0;
+  long long x = 0, y = 0;
+};
+// sinks.csv keyed by "inst/pin"; file order in `order`
+struct Sinks
+{
+  std::unordered_map<std::string, SinkRow> rows;
+  std::vector<std::string> order;
+  bool has(const std::string& p) const { return rows.count(p) > 0; }
+  const SinkRow& at(const std::string& p) const
+  {
+    auto it = rows.find(p);
+    if (it == rows.end()) fail("sinks: unknown pin " + p);
+    return it->second;
+  }
+};
+Sinks load_sinks(const std::string& dump);
+
+// Timing graph: FF-to-FF checks and IO edges (first columns only), names interned in first-appearance order
+struct Graph
+{
+  std::vector<std::string> names;
+  std::unordered_map<std::string, int> id;
+  std::vector<int> ff_from, ff_to;
+  std::vector<double> ff_smax, ff_smin;
+  std::vector<unsigned char> io_pi;   // 1 = PI_TO_FF
+  std::vector<int> io_ff, io_port;    // io_port indexes ports
+  std::vector<double> io_ss, io_sh;
+  std::vector<std::string> ports;
+  std::unordered_map<std::string, int> port_id;
+};
+// parsed once per session: the result is cached by directory and file size / mtime
+std::shared_ptr<const Graph> load_graph(const std::string& gdir);
+// worker threads for the per-register batches (env NUM_CORES, default 4)
+int early_threads();
+
+inline std::string sub_dir(const std::string& plat, const std::string& des) { return "results/" + plat + "/" + des + "/openroad"; }
+
+// ------------------------------------------------------------------------------------------------ replay
+struct Replay
+{
+  // decided registers (sorted by clock pin)
+  std::vector<std::string> pins, reg, DOM;
+  std::unordered_map<std::string, int> pid, rid;
+  std::vector<double> X, Y, CAP;
+  std::vector<int> TI;
+  int P = 0, F = 0, F_LIST = 0;
+  std::vector<std::string> UNMAPPED;
+  Tree tree;      // buffers only
+  Sinks sk;
+  std::string root;
+  long long rx = 0, ry = 0;
+  double rout = 0;
+  // stock groups
+  std::vector<std::string> gids, brs, gdom;
+  int G = 0;
+  std::vector<int> chosen, memb0, gbr, gbt, sbr;
+  std::vector<double> BOUT;
+  std::vector<double> tgt_all, tgt;
+  // IO arrays (post target shift)
+  std::vector<int> PIc, POl, POe;
+  std::vector<double> PIs, PIh, POs, POh;
+  size_t N_FF_CHECKS = 0, N_IO_ROWS = 0;
+  // unified checks sorted by endpoint
+  int NE = 0, NR = 0, Z = 0;
+  std::vector<int64_t> ep, cap, lau;
+  std::vector<double> bs, bh;
+  std::vector<int64_t> seg_ep, seg_st, seg_en, ep_pos;
+  std::vector<int64_t> byl, byl_p, byc, byc_p;
+  std::vector<double> su_b, ho_b;
+  double b_st = 0, b_sw = 0, b_ht = 0, b_hw = 0;
+  long NCG = 0;
+
+  void full_replay(const std::vector<double>& d, std::vector<double>& su, std::vector<double>& ho) const;
+  void summ(const std::vector<double>& su, const std::vector<double>& ho, double& st, double& sw, double& ht, double& hw) const;
+  // gain (d setup TNS + d hold TNS, ps) and WNS compatibility when only registers mem shift by x
+  std::pair<double, bool> cgain(const std::vector<int>& mem, const std::vector<double>& x);
+  // same without the call counter (thread-safe; the caller adds the count)
+  std::pair<double, bool> cgain_quiet(const std::vector<int>& mem, const std::vector<double>& x) const;
+};
+Replay load_replay(const std::string& ref, const std::string& plat, const std::string& des, const std::string& dump,
+                   const J& cal, const std::string& fixed_regs);
