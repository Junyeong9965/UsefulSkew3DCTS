+++ b/src/cts/src/EarlyKDTree.h
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+// k-d tree (leaf size 16, balanced median split on the widest dimension, node bounds recomputed per node, no
+// periodic box) for k-nearest-neighbour queries with p = 1 and a distance upper bound.  The build partitions the
+// index array with std::nth_element / std::partition (std::min_element / std::max_element for degenerate splits);
+// the query uses a binary min-heap of nodes and a bounded max-heap of neighbours, so the neighbour set, including
+// ties, is fully determined by the input order.
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+namespace cts::early {
+
+class KDTree
+{
+ public:
+  // data: n points of dimension m (row major)
+  KDTree(std::vector<double> data, int m, int leafsize = 16) : data_(std::move(data)), m_(m), leafsize_(leafsize)
+  {
+    n_ = (long) data_.size() / m_;
+    indices_.resize(n_);
+    for (long i = 0; i < n_; ++i) indices_[i] = i;
+    maxes_.assign(m_, 0.0); mins_.assign(m_, 0.0);
+    if (n_ > 0) {
+      for (int d = 0; d < m_; ++d) { maxes_[d] = data_[d]; mins_[d] = data_[d]; }
+      for (long i = 1; i < n_; ++i)
+        for (int d = 0; d < m_; ++d) { maxes_[d] = std::max(maxes_[d], data_[i * m_ + d]); mins_[d] = std::min(mins_[d], data_[i * m_ + d]); }
+    }
+    std::vector<double> tmaxes(maxes_), tmins(mins_);
+    build(0, n_, tmaxes.data(), tmins.data());
+  }
+  // k nearest neighbours of x (p = 1): indices (n_ for a missing neighbour), ascending distance
+  std::vector<long> query(const double* x, long k, double distance_upper_bound) const;
+  long n() const { return n_; }
+
+ private:
+  struct Node { long start_idx = 0, end_idx = 0, children = 0; int split_dim = -1; double split = 0; long less = -1, greater = -1; };
+  union Contents { long intdata; const void* ptrdata; };
+  struct HeapItem { double priority; Contents contents; };
+  // Binary min-heap on priority with a growable array (capacity 2 * space + 1 on overflow)
+  struct Heap
+  {
+    std::vector<HeapItem> h;
+    long n = 0, space;
+    explicit Heap(long initial) : h(initial), space(initial) {}
+    void push(const HeapItem& item)
+    {
+      n++;
+      if (n > space) h.resize(2 * space + 1);
+      space = (long) h.size();
+      long i = n - 1;
+      h[i] = item;
+      while (i > 0 && h[i].priority < h[(i - 1) / 2].priority) { std::swap(h[(i - 1) / 2], h[i]); i = (i - 1) / 2; }
+    }
+    HeapItem peek() const { return h[0]; }
+    void remove()
+    {
+      h[0] = h[n - 1];
+      n--;
+      long nn = n, i = 0, j = 1, k = 2, l;
+      while ((j < nn && h[i].priority > h[j].priority) || (k < nn && h[i].priority > h[k].priority)) {
+        if (k < nn && h[j].priority > h[k].priority) l = k; else l = j;
+        std::swap(h[l], h[i]);
+        i = l; j = 2 * i + 1; k = 2 * i + 2;
+      }
+    }
+    HeapItem pop() { HeapItem it = h[0]; remove(); return it; }
+  };
+  struct NodeInfo { const Node* node; double min_distance; std::vector<double> side; };
+
+  long build(long start, long end, double* maxes, double* mins)
+  {
+    nodes_.emplace_back();
+    long idx = (long) nodes_.size() - 1;
+    nodes_[idx].start_idx = start; nodes_[idx].end_idx = end; nodes_[idx].children = end - start;
+    if (end - start <= leafsize_) { nodes_[idx].split_dim = -1; return idx; }
+    const double* data = data_.data();
+    long* indices = indices_.data();
+    const int m = m_;
+    // compact: recompute the bounds of this node's points
+    for (int i = 0; i < m; ++i) { maxes[i] = data[indices[start] * m + i]; mins[i] = maxes[i]; }
+    for (long j = start + 1; j < end; ++j)
+      for (int i = 0; i < m; ++i) { double t = data[indices[j] * m + i]; maxes[i] = maxes[i] > t ? maxes[i] : t; mins[i] = mins[i] < t ? mins[i] : t; }
+    int d = 0;
+    double size = 0;
+    for (int i = 0; i < m; ++i) if (maxes[i] - mins[i] > size) { d = i; size = maxes[i] - mins[i]; }
+    double maxval = maxes[d], minval = mins[d];
+    if (maxval == minval) { nodes_[idx].split_dim = -1; return idx; }
+    auto index_compare = [=](long a, long b) { return data[a * m + d] < data[b * m + d]; };
+    auto partition_pivot = [=](long* first, long* last, double pivot) {
+      long* pp = std::partition(first, last, [&](long a) { return !(data[a * m + d] >= pivot); });
+      return (long) (pp - indices);
+    };
+    const long n_points = end - start;
+    long* node_indices = indices + start;
+    long* mid = node_indices + n_points / 2;
+    std::nth_element(node_indices, mid, node_indices + n_points, index_compare);
+    double split = data[*mid * m + d];
+    long p = partition_pivot(node_indices, mid, split);
+    if (p == start) {
+      long min_idx = *std::min_element(indices + start, indices + end, index_compare);
+      split = std::nextafter(data[min_idx * m + d], HUGE_VAL);
+      p = partition_pivot(indices + start, indices + end, split);
+    } else if (p == end) {
+      long max_idx = *std::max_element(indices + start, indices + end, index_compare);
+      split = data[max_idx * m + d];
+      p = partition_pivot(indices + start, indices + end, split);
+    }
+    long less = build(start, p, maxes, mins);
+    long greater = build(p, end, maxes, mins);
+    nodes_[idx].less = less; nodes_[idx].greater = greater; nodes_[idx].split_dim = d; nodes_[idx].split = split;
+    return idx;
+  }
+
+  std::vector<double> data_;
+  int m_, leafsize_;
+  long n_ = 0;
+  std::vector<long> indices_;
+  std::vector<double> maxes_, mins_;
+  std::deque<Node> nodes_;   // stable addresses
+};
+
+inline std::vector<long> KDTree::query(const double* x, long kmax, double distance_upper_bound) const
+{
+  const int m = m_;
+  std::deque<NodeInfo> pool;
+  Heap q(12), neighbors(kmax);
+  pool.emplace_back();
+  NodeInfo* ni1 = &pool.back();
+  ni1->node = &nodes_[0];
+  ni1->min_distance = 0;
+  ni1->side.assign(m, 0.0);
+  for (int i = 0; i < m; ++i) {
+    double s = 0, t = x[i] - maxes_[i];
+    if (t > s) s = t; else { t = mins_[i] - x[i]; if (t > s) s = t; }
+    ni1->min_distance += s - ni1->side[i];
+    ni1->side[i] = s;
+  }
+  const double epsfac = 1.0;
+  // p = 1: distances are plain sums of absolute differences
+  for (;;) {
+    if (ni1->node->split_dim == -1) {
+      const Node* node = ni1->node;
+      for (long i = node->start_idx; i < node->end_idx; ++i) {
+        const double* y = data_.data() + indices_[i] * m;
+        double d = 0;
+        for (int k = 0; k < m; ++k) { d += std::fabs(y[k] - x[k]); if (d > distance_upper_bound) break; }
+        if (d < distance_upper_bound) {
+          if (neighbors.n == kmax) neighbors.remove();
+          HeapItem nb; nb.priority = -d; nb.contents.intdata = indices_[i];
+          neighbors.push(nb);
+          if (neighbors.n == kmax) distance_upper_bound = -neighbors.peek().priority;
+        }
+      }
+      if (q.n == 0) break;
+      HeapItem it = q.pop();
+      ni1 = const_cast<NodeInfo*>(static_cast<const NodeInfo*>(it.contents.ptrdata));
+    } else {
+      const Node* inode = ni1->node;
+      const int sd = inode->split_dim;
+      const double split = inode->split;
+      if (ni1->min_distance > distance_upper_bound * epsfac) break;
+      pool.emplace_back();
+      NodeInfo* ni2 = &pool.back();
+      ni2->side = ni1->side;
+      ni2->min_distance = ni1->min_distance;
+      double side_distance;
+      if (x[sd] < split) { ni1->node = &nodes_[inode->less]; ni2->node = &nodes_[inode->greater]; side_distance = split - x[sd]; }
+      else { ni1->node = &nodes_[inode->greater]; ni2->node = &nodes_[inode->less]; side_distance = x[sd] - split; }
+      ni2->min_distance += side_distance - ni2->side[sd];
+      ni2->side[sd] = side_distance;
+      if (ni1->min_distance > ni2->min_distance) std::swap(ni1, ni2);
+      if (ni2->min_distance <= distance_upper_bound * epsfac) {
+        HeapItem it2; it2.priority = ni2->min_distance; it2.contents.ptrdata = ni2;
+        q.push(it2);
+      }
+    }
+  }
+  std::vector<HeapItem> sorted(kmax);
+  long nnb = neighbors.n;
+  for (long i = neighbors.n - 1; i >= 0; --i) sorted[i] = neighbors.pop();
+  std::vector<long> out(kmax, n_);
+  for (long i = 0; i < kmax; ++i) if (i < nnb) out[i] = sorted[i].contents.intdata;
+  return out;
+}
+
+}  // namespace cts::early
