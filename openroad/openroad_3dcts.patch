+HBT::HBT(const std::string& dump, const std::string& nets_txt, double r_ohm, const std::vector<std::string>& pins,
+         const std::vector<int>& TI, const std::vector<double>& X, const std::vector<double>& Y, const std::vector<double>& CAP_ff,
+         const std::string& root)
+    : R_(r_ohm), pins_(pins), P_((int) pins.size()), TI_(TI), X_(X), Y_(Y), CAP_(CAP_ff), root_(root)
+{
+  for (int i = 0; i < P_; ++i) pidx_[pins_[i]] = i;
+  tree_ = load_tree(dump, false);
+  Sinks sinks = load_sinks(dump);
+  NetDumps dn = parse_nets(nets_txt);
+  for (auto& inst : tree_.order) { auto& r = tree_.rows[inst]; loc_[inst] = {r.x, r.y, true}; tier_[inst] = r.tier; }
+  for (auto& k : sinks.order) { auto& r = sinks.rows[k]; loc_[r.inst] = {r.x, r.y, true}; tier_[r.inst] = r.tier; }
+  for (auto& net : dn.order) {
+    auto& d = dn.nets[net];
+    wc_[net] = d.wc;
+    net_drv_[net] = (!d.drv.empty() && d.drv.find('/') != std::string::npos) ? inst_of(d.drv) : "";
+    for (auto& ld : d.loads) {
+      std::string inst = inst_of(ld.pin);
+      if (!tier_.count(inst)) {
+        int t = tier_of_master(ld.master);
+        if (t < 0) continue;
+        tier_[inst] = t;
+        loc_.emplace(inst, XY());
+      }
+      cap_[ld.pin] = ld.cap;
+      if (!net_loads_.count(net)) net_order_.push_back(net);
+      net_loads_[net].push_back(ld.pin);
+      if (!ld.master.empty()) mcap_.emplace(ld.master, ld.cap);
+    }
+  }
+  for (auto& net : net_order_)
+    for (auto& p : net_loads_[net]) {
+      std::string inst = inst_of(p);
+      if (tree_.has(inst) && net_loads_.count(tree_.at(inst).out_net)) { child_[p] = tree_.at(inst).out_net; in_pin_[inst] = p; }
+    }
+  // wire capacitance per um from the reference placement estimate
+  std::vector<double> ratios;
+  for (auto& net : net_order_) {
+    std::vector<std::pair<double, double>> pts;
+    for (auto& p : net_loads_[net]) { XY q = xy(p); if (q.valid) pts.emplace_back((double) q.x, (double) q.y); }
+    auto dit = loc_.find(net_drv_[net]);
+    if (!net_drv_[net].empty() && dit != loc_.end() && dit->second.valid) pts.emplace_back((double) dit->second.x, (double) dit->second.y);
+    double L = steiner_um(pts);
+    if (L > 1.0 && wc_[net] > 0) ratios.push_back(wc_[net] / L);
+  }
+  std::sort(ratios.begin(), ratios.end());
+  cw_ = ratios.empty() ? 0.0 : ratios[ratios.size() / 2];
+  for (auto& net : net_order_) {
+    bool ok;
+    int td = drv_tier(net, ok);
+    ref_local_[net] = local(net, net_loads_[net], ok, td, drv_xy(net));
+  }
+  ref_d_.assign(P_, 0.0);
+  for (auto& n : net_order_)
+    if (net_drv_[n].empty() || !in_pin_.count(net_drv_[n])) walk(n, {}, 0.0);
+  if (tree_.has(root_)) { entry_ = tree_.at(root_).in_net; entry_ok_ = true; }
+  for (auto& net : net_order_) for (auto& p : net_loads_[net]) pin_net_[p] = net;
+}
+
+XY HBT::xy(const std::string& pin) const
+{
+  auto it = loc_.find(inst_of(pin));
+  return it == loc_.end() ? XY() : it->second;
+}
+
+int HBT::drv_tier(const std::string& net, bool& ok) const
+{
+  ok = true;
+  auto d = net_drv_.find(net);
+  if (d != net_drv_.end() && !d->second.empty()) {
+    auto t = tier_.find(d->second);
+    if (t != tier_.end()) return t->second;
+  }
+  long long sum = 0, cnt = 0;
+  auto nl = net_loads_.find(net);
+  if (nl != net_loads_.end())
+    for (auto& p : nl->second) { auto t = tier_.find(inst_of(p)); if (t != tier_.end()) { sum += t->second; ++cnt; } }
+  if (cnt == 0) { ok = false; return -1; }
+  return 2 * sum > cnt ? 1 : 0;
+}
+
+XY HBT::drv_xy(const std::string& net) const
+{
+  auto d = net_drv_.find(net);
+  if (d != net_drv_.end() && !d->second.empty()) {
+    auto l = loc_.find(d->second);
+    if (l != loc_.end() && l->second.valid) return l->second;
+  }
+  long long sx = 0, sy = 0, n = 0;
+  auto nl = net_loads_.find(net);
+  if (nl != net_loads_.end())
+    for (auto& p : nl->second) { XY q = xy(p); if (q.valid) { sx += q.x; sy += q.y; ++n; } }
+  XY r; r.valid = true;
+  if (n) { r.x = py_floordiv(sx, n); r.y = py_floordiv(sy, n); }
+  return r;
+}
+
+HBT::Local HBT::local(const std::string&, const std::vector<std::string>& loads, bool td_ok, int td, XY dxy, const std::vector<Extra>& extra) const
+{
+  Local out;
+  if (!td_ok) return out;
+  struct Off { std::string key; XY xy; double cap; };
+  std::vector<Off> off;
+  for (auto& p : loads) {
+    auto t = tier_.find(inst_of(p));
+    if (t != tier_.end() && t->second != td) {
+      auto c = cap_.find(p);
+      off.push_back({p, xy(p), c == cap_.end() ? 0.0 : c->second});
+    }
+  }
+  for (auto& e : extra) if (e.tier != td) off.push_back({e.key, e.xy, e.cap});
+  if (off.empty()) return out;
+  std::vector<double> caps;
+  for (auto& o : off) caps.push_back(o.cap);
+  std::vector<std::pair<double, double>> pts{{(double) dxy.x, (double) dxy.y}};
+  for (auto& o : off) if (o.xy.valid) pts.emplace_back((double) o.xy.x, (double) o.xy.y);
+  double cdown = py_sum(caps) + cw_ * steiner_um(pts);
+  double d = R_ * cdown * 1e12;
+  for (auto& o : off) out[o.key] = d;
+  return out;
+}
+
+std::vector<int> HBT::walk(const std::string& net, std::vector<std::pair<std::string, std::string>> path, double acc)
+{
+  const Local& loc = ref_local_[net];
+  for (auto& p : net_loads_[net]) {
+    auto l = loc.find(p);
+    double a = acc + (l == loc.end() ? 0.0 : l->second);
+    auto pp = path;
+    pp.emplace_back(net, p);
+    auto c = child_.find(p);
+    if (c != child_.end()) {
+      auto below = walk(c->second, pp, a);
+      auto& sb = sub_[p];
+      sb.insert(sb.end(), below.begin(), below.end());
+    } else {
+      auto s = pidx_.find(p);
+      if (s != pidx_.end()) { int i = s->second; ref_d_[i] = a; path_[i] = pp; sub_[p].push_back(i); }
+    }
+  }
+  std::vector<int> out;
+  for (auto& p : net_loads_[net]) { auto s = sub_.find(p); if (s != sub_.end()) out.insert(out.end(), s->second.begin(), s->second.end()); }
+  return out;
+}
+
+std::vector<HBT::Extra> HBT::hub_extra(const std::set<int>& tiers) const
+{
+  const TreeRow& r = tree_.at(root_);
+  std::vector<Extra> ex;
+  for (int t : tiers) {
+    auto m = leaf_master_.find(t);
+    double c = 0.0;
+    if (m != leaf_master_.end()) { auto mc = mcap_.find(m->second); if (mc != mcap_.end()) c = mc->second; }
+    XY q; q.x = r.x + r.w; q.y = r.y; q.valid = true;
+    ex.push_back({"hub" + std::to_string(t), t, q, c});
+  }
+  return ex;
+}
+
+HBT::Local HBT::entry_local(const std::set<int>& tiers) const
+{
+  if (!entry_ok_ || !net_loads_.count(entry_)) fail("HBT: entry net of the root is unknown");
+  bool ok;
+  int td = drv_tier(entry_, ok);
+  return local(entry_, net_loads_.at(entry_), ok, td, drv_xy(entry_), hub_extra(tiers));
+}
+
+HBT::Local HBT::new_leaf_local(const std::vector<int>& mem, int t, long long cx, long long cy) const
+{
+  Local out;
+  std::vector<int> off;
+  for (int i : mem) if (TI_[i] != t) off.push_back(i);
+  if (off.empty()) return out;
+  std::vector<double> caps;
+  for (int i : off) caps.push_back(CAP_[i] * 1e-15);
+  std::vector<std::pair<double, double>> pts{{(double) cx, (double) cy}};
+  for (int i : off) pts.emplace_back(X_[i], Y_[i]);
+  double cdown = py_sum(caps) + cw_ * steiner_um(pts);
+  double d = R_ * cdown * 1e12;
+  for (int i : off) out[std::to_string(i)] = d;
+  return out;
+}
+
+std::vector<double> HBT::member_delta(const std::vector<int>& mem, int t, long long cx, long long cy, const std::set<int>& hub_tiers) const
+{
+  Local el = entry_local(hub_tiers);
+  auto h = el.find("hub" + std::to_string(t));
+  double dh = h == el.end() ? 0.0 : h->second;
+  Local leaf = new_leaf_local(mem, t, cx, cy);
+  std::vector<double> out;
+  for (int i : mem) {
+    auto l = leaf.find(std::to_string(i));
+    out.push_back(dh + (l == leaf.end() ? 0.0 : l->second) - ref_d_[i]);
+  }
+  return out;
+}
+
+double HBT::below(int i, const std::string& p) const
+{
+  double acc = 0.0;
+  bool seen = false;
+  for (auto& nq : path_.at(i)) {
+    if (seen) { auto& rl = ref_local_.at(nq.first); auto it = rl.find(nq.second); acc += it == rl.end() ? 0.0 : it->second; }
+    if (nq.second == p) seen = true;
+  }
+  return acc;
+}
+
+std::vector<double> HBT::full_delta(const std::vector<Group>& groups, const std::vector<std::pair<std::string, int>>& geo_leaves)
+{
+  std::vector<double> out(P_, 0.0);
+  std::set<int> tiers;
+  for (auto& g : groups) tiers.insert(g.tier);
+  for (auto& gl : geo_leaves) tiers.insert(gl.second);
+  if (tiers.empty()) return out;
+  Local el = entry_local(tiers);
+  std::set<int> moved;
+  for (auto& g : groups) moved.insert(g.mem.begin(), g.mem.end());
+  // 1. nets whose load set changes (entry first, then the nets of removed loads in first-touch order)
+  std::vector<std::string> nl_order{entry_};
+  std::unordered_map<std::string, Local> new_local;
+  Local e0;
+  for (auto& kv : el) if (!starts_with(kv.first, "hub")) e0[kv.first] = kv.second;
+  new_local[entry_] = e0;
+  std::vector<std::string> rm_order;
+  std::unordered_map<std::string, std::set<std::string>> rm;
+  auto rm_add = [&](const std::string& net, const std::string& p) { if (!rm.count(net)) rm_order.push_back(net); rm[net].insert(p); };
+  for (int i : moved) { auto pt = path_.find(i); if (pt != path_.end()) rm_add(pt->second.back().first, pt->second.back().second); }
+  for (auto& gl : geo_leaves) {
+    auto ip = in_pin_.find(gl.first);
+    if (ip != in_pin_.end() && pin_net_.count(ip->second)) rm_add(pin_net_[ip->second], ip->second);
+  }
+  for (auto& net : rm_order) {
+    std::vector<std::string> keep;
+    for (auto& p : net_loads_[net]) if (!rm[net].count(p)) keep.push_back(p);
+    bool ok;
+    int td = drv_tier(net, ok);
+    if (!new_local.count(net)) nl_order.push_back(net);
+    new_local[net] = local(net, keep, ok, td, drv_xy(net));
+  }
+  // 2. non-members: the change of every affected net reaches the sinks below each changed load
+  for (auto& net : nl_order) {
+    const Local& nl = new_local[net];
+    auto oldit = ref_local_.find(net);
+    for (auto& p : net_loads_[net]) {
+      double nv = nl.count(p) ? nl.at(p) : 0.0;
+      double ov = (oldit != ref_local_.end() && oldit->second.count(p)) ? oldit->second.at(p) : 0.0;
+      double dd = nv - ov;
+      if (dd != 0.0 && !(rm.count(net) && rm[net].count(p))) {
+        auto s = sub_.find(p);
+        if (s != sub_.end()) for (int i : s->second) if (!moved.count(i)) out[i] += dd;
+      }
+    }
+  }
+  // 3. members of new leaves
+  for (auto& g : groups) {
+    Local leaf = new_leaf_local(g.mem, g.tier, g.cx, g.cy);
+    auto h = el.find("hub" + std::to_string(g.tier));
+    double dh = h == el.end() ? 0.0 : h->second;
+    for (int i : g.mem) { auto l = leaf.find(std::to_string(i)); out[i] = dh + (l == leaf.end() ? 0.0 : l->second) - ref_d_[i]; }
+  }
+  // 4. reparented stock leaves
+  for (auto& gl : geo_leaves) {
+    auto ip = in_pin_.find(gl.first);
+    if (ip == in_pin_.end()) continue;
+    auto h = el.find("hub" + std::to_string(gl.second));
+    double dh = h == el.end() ? 0.0 : h->second;
+    auto s = sub_.find(ip->second);
+    if (s != sub_.end()) for (int i : s->second) out[i] = dh + below(i, ip->second) - ref_d_[i];
+  }
+  return out;
+}
+
+// ------------------------------------------------------------------------------------------------ scope
+namespace {
+std::string tree_top(const Tree& tree, std::string b)
+{
+  std::set<std::string> seen;
+  while (tree.has(b) && !starts_with(tree.at(b).driver, "PORT:") && !seen.count(b)) { seen.insert(b); b = tree.at(b).driver; }
+  return (tree.has(b) && starts_with(tree.at(b).driver, "PORT:")) ? b : "";
+}
+}  // namespace
+
+std::string scope_main(const std::string& ref, const std::string& plat, const std::string& des, const std::string& dump,
+                       const std::string& out)
+{
+  std::string sub = sub_dir(plat, des);
+  std::string lgpath = join_path(ref, "P/" + sub + "/phase1_leaf_groups.csv");
+  Table rows = read_table(lgpath);
+  int c_level = rows.col("level"), c_sink = rows.col("sink"), c_clock = rows.col("clock"), c_leaf = rows.col("leaf");
+  std::vector<const std::vector<std::string>*> l1;
+  for (auto& r : rows.rows) if (r[c_level] == "1") l1.push_back(&r);
+  Tree tree = load_tree(dump, true);
+  Sinks sk = load_sinks(dump);
+  // root: clock-port-driven buffer with the most register sinks on regular leaves; ties: larger name
+  std::map<std::string, long> cnt;
+  for (auto& key : sk.order) {
+    auto& r = sk.rows[key];
+    if (starts_with(r.driver, "clkbuf_leaf") && tree.has(r.driver)) { std::string t = tree_top(tree, r.driver); if (!t.empty()) cnt[t]++; }
+  }
+  if (cnt.empty()) fail("scope: no register sink on a regular leaf");
+  std::string root;
+  long best = -1;
+  for (auto& kv : cnt) if (kv.second > best || (kv.second == best && kv.first > root)) { best = kv.second; root = kv.first; }
+  auto gkey = [&](const std::vector<std::string>& r) { return r[c_clock] + ":" + r[c_leaf]; };
+  std::vector<std::string> gorder;
+  std::unordered_map<std::string, std::vector<std::string>> grp;
+  for (auto* r : l1) { std::string k = gkey(*r); if (!grp.count(k)) gorder.push_back(k); grp[k].push_back((*r)[c_sink]); }
+  std::set<std::string> sup;
+  for (auto& g : gorder) {
+    auto& mem = grp[g];
+    std::set<std::string> drv;
+    bool all = true;
+    for (auto& m : mem) { if (sk.has(m)) drv.insert(sk.at(m).driver); else all = false; }
+    if (all && drv.size() == 1) {
+      const std::string& d = *drv.begin();
+      if (starts_with(d, "clkbuf_leaf") && tree_top(tree, d) == root) sup.insert(g);
+    }
+  }
+  mkdirs(out);
+  for (const char* d : {"G", "D"}) {
+    std::string link = join_path(out, d);
+    struct stat st;
+    if (lstat(link.c_str(), &st) != 0) symlink(join_path(ref, d).c_str(), link.c_str());
+  }
+  std::string pd = join_path(out, "P/" + sub);
+  mkdirs(pd);
+  std::string refp = join_path(ref, "P/" + sub);
+  if (DIR* dir = opendir(refp.c_str())) {
+    std::vector<std::string> names;
+    while (dirent* e = readdir(dir)) { std::string n = e->d_name; if (n != "." && n != "..") names.push_back(n); }
+    closedir(dir);
+    for (auto& f : names) {
+      if (f == "phase1_leaf_groups.csv") continue;
+      std::string link = join_path(pd, f);
+      struct stat st;
+      if (lstat(link.c_str(), &st) != 0) symlink(join_path(refp, f).c_str(), link.c_str());
+    }
+  } else fail("cannot list " + refp);
+  {
+    std::string s = csv_row(rows.header);
+    for (auto& r : rows.rows) if (r[c_level] != "1" || sup.count(gkey(r))) s += csv_row(r);
+    write_text(join_path(pd, "phase1_leaf_groups.csv"), s);
+  }
+  std::set<std::string> listed;
+  for (auto* r : l1) listed.insert((*r)[c_sink]);
+  std::vector<std::string> single;
+  for (auto& key : sk.order) if (!listed.count(key)) single.push_back(key);
+  std::sort(single.begin(), single.end());
+  {
+    std::string s = "group,sink\n";
+    for (auto* r : l1) if (!sup.count(gkey(*r))) s += "f_" + (*r)[c_clock] + "_" + (*r)[c_leaf] + "," + (*r)[c_sink] + "\n";
+    for (size_t k = 0; k < single.size(); ++k) s += "s_" + std::to_string(k) + "," + single[k] + "\n";
+    write_text(join_path(out, "fixed_groups.csv"), s);
+  }
+  std::set<std::string> supregs;
+  for (auto* r : l1) if (sup.count(gkey(*r))) supregs.insert(inst_of((*r)[c_sink]));
+  const Graph& g = *load_graph(join_path(ref, "G/results"));
+  std::set<std::string> regs;
+  for (int a : g.ff_from) if (!supregs.count(g.names[a])) regs.insert(g.names[a]);
+  for (int b : g.ff_to) if (!supregs.count(g.names[b])) regs.insert(g.names[b]);
+  for (int f : g.io_ff) if (!supregs.count(g.names[f])) regs.insert(g.names[f]);
+  {
+    std::string s;
+    for (auto& x : regs) s += x + "\n";
+    write_text(join_path(out, "fixed_regs.txt"), s);
+  }
+  std::set<std::string> clocks;
+  for (auto* r : l1) if (sup.count(gkey(*r))) clocks.insert((*r)[c_clock]);
+  long supregs_n = 0;
+  for (auto& g_ : sup) supregs_n += (long) grp[g_].size();
+  J sc = J::Obj();
+  sc.set("root", J::S(root));
+  sc.set("supported_groups", J::I((long long) sup.size()));
+  sc.set("groups", J::I((long long) grp.size()));
+  sc.set("supported_regs", J::I(supregs_n));
+  sc.set("regs", J::I((long long) l1.size()));
+  sc.set("fixed_groups", J::I((long long) grp.size() - (long long) sup.size()));
+  sc.set("single_register_clusters", J::I((long long) single.size()));
+  sc.set("fixed_registers", J::I((long long) regs.size()));
+  J cl = J::Arr();
+  for (auto& c : clocks) cl.push(J::S(c));
+  sc.set("supported_clocks", cl);
+  write_text(join_path(out, "scope.json"), sc.dump(1));
+  std::printf("%s\n", sc.dump(1).c_str());
+  return root;
+}
