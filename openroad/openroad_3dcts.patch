+    int& tappedSinks)
+{
+  // One chain per tier: a chain-output net that spans two tiers is avoided.
+  // Registers with an unknown tier stay on their leaf net.
+  std::map<int, std::vector<TapSink>> tierBins;
+  for (const TapSink& ts : branchSinks) {
+    const int t = cts3dDb_->getInstTier(ts.inst->getDbInst());
+    if (t < 0) {
+      homeNet[ts.inst]->addInst(*ts.inst);
+      ++directSinks;
+      continue;
+    }
+    tierBins[t].push_back(ts);
+  }
+
+  int numBufs = 0;
