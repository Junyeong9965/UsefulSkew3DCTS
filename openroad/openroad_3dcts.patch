+Graph parse_graph(const std::string& gdir)
+{
+  Graph g;
+  char* buf = nullptr;
+  size_t cap = 0;
+  ssize_t len;
+  std::vector<std::pair<const char*, const char*>> f;
+  // FF-to-FF checks
+  std::string ffp = join_path(gdir, "pre_cts_ff_timing_graph.csv");
+  FILE* fp = std::fopen(ffp.c_str(), "r");
+  if (!fp) fail("cannot read " + ffp);
+  if ((len = getline(&buf, &cap, fp)) < 0) fail("empty " + ffp);
+  std::string hdr(buf, len);
+  while (!hdr.empty() && (hdr.back() == '\n' || hdr.back() == '\r')) hdr.pop_back();
+  Cols fc = header_cols(hdr, {"from_ff", "to_ff", "slack_max_ns", "slack_min_ns"}, ffp);
+  while ((len = getline(&buf, &cap, fp)) >= 0) {
+    while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r')) buf[--len] = 0;
+    if (len == 0) continue;
+    if (split_fields(buf, f, fc.maxc) <= fc.maxc) fail("short FF row in " + ffp);
+    g.ff_from.push_back(intern(g, f[fc.want[0]]));
+    g.ff_to.push_back(intern(g, f[fc.want[1]]));
+    g.ff_smax.push_back(num_field(f[fc.want[2]]));
+    g.ff_smin.push_back(num_field(f[fc.want[3]]));
+  }
+  std::fclose(fp);
+  // IO edges
+  std::string iop = join_path(gdir, "pre_cts_io_timing_edges.csv");
+  fp = std::fopen(iop.c_str(), "r");
+  if (!fp) fail("cannot read " + iop);
+  if ((len = getline(&buf, &cap, fp)) < 0) fail("empty " + iop);
+  hdr.assign(buf, len);
+  while (!hdr.empty() && (hdr.back() == '\n' || hdr.back() == '\r')) hdr.pop_back();
+  Cols ic = header_cols(hdr, {"edge_type", "port_name", "ff_name", "slack_setup_ns", "slack_hold_ns"}, iop);
+  while ((len = getline(&buf, &cap, fp)) >= 0) {
+    while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r')) buf[--len] = 0;
+    if (len == 0) continue;
+    if (split_fields(buf, f, ic.maxc) <= ic.maxc) fail("short IO row in " + iop);
+    std::string et(f[ic.want[0]].first, f[ic.want[0]].second);
+    g.io_pi.push_back(et == "PI_TO_FF" ? 1 : 0);
+    std::string pn(f[ic.want[1]].first, f[ic.want[1]].second);
+    auto it = g.port_id.find(pn);
+    if (it == g.port_id.end()) { it = g.port_id.emplace(pn, (int) g.ports.size()).first; g.ports.push_back(pn); }
+    g.io_port.push_back(it->second);
+    g.io_ff.push_back(intern(g, f[ic.want[2]]));
+    g.io_ss.push_back(num_field(f[ic.want[3]]));
+    g.io_sh.push_back(num_field(f[ic.want[4]]));
+  }
+  std::fclose(fp);
+  std::free(buf);
+  return g;
+}
+}  // namespace
