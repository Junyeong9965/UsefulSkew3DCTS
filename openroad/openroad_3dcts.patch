+//
+// Early-group selection: construction gains on the
+// exact replay, agglomeration on the 8-nearest-neighbour graph, per-tier prefix selection with repair, hold-WNS
+// front cover, tier search.  Writes plan.tsv, membership.csv, groups.csv, clusters.csv, prefix.csv, pred_shift.csv,
+// regs_debug.csv, summary.json into <outdir>.
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <dirent.h>
+#include <functional>
+#include <map>
