+    sta::Pin* pin;
+    const sta::MinMax* mm;
+    double parent;
+  };
+  std::vector<Guard> guards;
+  {
+    std::ifstream in(envS("CTS_GUARD_ENDPOINTS_TSV", ""));
+    std::string line;
+    if (in) {
+      std::getline(in, line);
+      while (std::getline(in, line)) {
+        const auto tab = line.find('\t');
+        if (tab == std::string::npos) {
+          continue;
+        }
+        const std::string pn = line.substr(0, tab), md = line.substr(tab + 1, 3);
+        const auto slash = pn.rfind('/');
+        odb::dbInst* inst = block->findInst(pn.substr(0, slash).c_str());
+        odb::dbITerm* term = inst ? inst->findITerm(pn.substr(slash + 1).c_str()) : nullptr;
+        if (!term) {
+          logger->error(CTS, 990, "Clock refinement: guard endpoint {} not found", pn);
+        }
