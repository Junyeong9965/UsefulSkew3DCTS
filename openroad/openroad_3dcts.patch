+// ---------------------------------------------------------------------------
+// Load-aware depth assignment for one shared delay chain (CTS_LOAD_AWARE_TAPS=1).
+//
+// The constant-delay rule depth = round(a / tapStageDelay_) uses one stage
+// delay for every stage.  A stage carrying many registers is slower than the
+// unloaded stage, and the depth-0 reference (the register's own leaf buffer) is
+// a loaded stage as well, so the delay of each stage is computed from its load.
+//
+// Model (Liberty NLDM delays and clock-wire capacitance, no STA call):
+//   stage k = 1..Dmax+1 of the chain (stage 1 = first stage, or the bridge
+//   source of a bridged chain; stage k carries the depth-(k-1) registers);
+//   load_k = clock-pin caps of the registers on stage k
+//            + wire cap of a Steiner estimate over (stage location, registers)
+//            + input pin cap and step wire of the next stage (if any);
+//   D_k = Liberty delay of the stage master at load_k with the input slew of
+//         stage k-1 (stage 1: self-loaded slew of the chain buffer);
+//   A_k = D_1 + ... + D_k;
+//   reference of register i = delay of its leaf buffer at the leaf load;
+//   delivered increment of depth d = A_{d+1} - reference (d = 0: 0).
+// Cost per register (ps) = max(0, a - inc) + max(0, inc - H) + 0.1 max(0, inc - a),
+// H = capture hold budget (tapHoldBudget_; none = no hold term): under-delivery
+// costs setup, over-delivery costs only beyond the hold budget.
+// Search: joint descent over single-register depth moves (each move re-evaluates
+// the whole chain with the moved load; a move needs a 0.5 ps total gain; at most
+// 8 passes; best pass kept), alternated (2 rounds) with stage sizing: every
+// stage behind the first one (behind the bridge for a bridged chain) may use a
+// wider buffer of the same family (TechChar::bufUpsizeMasters); the smallest
+// master within 0.25 ps x N of the best total is taken when it gains at least
+// 0.5 ps x N.  The stage that loads the branch net is not resized (its input cap
+// is a load of the branch net).  Depth 0 is allowed only if the register's leaf
+// net still has a sink.
+// ---------------------------------------------------------------------------
+int HTreeBuilder::assignLoadAwareTapDepths(
+    std::map<int, std::vector<ClockInst*>>& dg,
+    std::map<ClockInst*, ClockSubNet*>& homeNet,
+    ClockInst* drv,
+    int chainTier,
+    int stage1Tier,
+    unsigned branchIdx,
+    int chainIdx,
+    std::vector<ClockInst*>& demoted,
+    std::vector<std::string>& stageMaster)
+{
+  struct F
+  {
+    ClockInst* ff;
+    int d0;           // depth from the constant-delay rule
+    int d;            // current depth
+    double aPs;       // LP target, ps
+    double capF;      // clock pin cap, F
+    ClockSubNet* home;
+    double holdPs;    // hold budget (ps), +inf = no hold path
+  };
+  std::vector<F> fs;
+  for (auto& [d, v] : dg) {
+    if (d <= 0) {
+      continue;
+    }
+    for (ClockInst* ff : v) {
+      F f;
+      f.ff = ff;
+      f.d0 = f.d = d;
+      f.aPs = cts3dDb_->getSkewTarget(sinkRegisterName(ff)) * 1e3;
+      f.capF = ff->getInputCap();
+      auto h = homeNet.find(ff);
+      f.home = (h != homeNet.end()) ? h->second : nullptr;
+      {
+        auto vt = tapHoldBudget_.find(sinkRegisterName(ff));
+        f.holdPs = vt != tapHoldBudget_.end()
+                       ? vt->second * 1e3
+                       : std::numeric_limits<double>::infinity();
+      }
+      fs.push_back(f);
+    }
+  }
+  if (fs.empty()) {
+    return 0;
+  }
+  const std::string bufM
+      = cts3dDb_->getBufferForTier(options_->getRootBuffer(), chainTier);
+  const std::string st1M
+      = cts3dDb_->getBufferForTier(options_->getRootBuffer(), stage1Tier);
+  const double cin = techChar_->bufInputCapF(bufM);
+  // Stage 1 of a bridged chain is bridge_src and stage 2 bridge_dst; those keep
+  // their masters.
+  const bool bridgedModel = (stage1Tier != chainTier);
+  const int firstSizable = bridgedModel ? 3 : 2;
+  const std::vector<std::string> upsizes = techChar_->bufUpsizeMasters(bufM);
+  const double capPerDbu = techChar_->getCapPerDBU();  // F per dbu
+  for (F& f : fs) {
+    if (f.capF <= 0.0) {
+      f.capF = cin;  // unknown pin cap: same order as a buffer input
+    }
+  }
+  // Input slew on the branch net: self-loaded slew of the chain buffer.
+  double s0 = 0.0, tmp = 0.0;
+  if (techChar_->bufStageDelayPs(bufM, cin, 0.0, &tmp) < 0.0) {
+    logger_->warn(CTS,
+                  2061,
+                  "Load-aware taps: no Liberty arcs for {}; constant-delay "
+                  "depths kept",
+                  bufM);
+    return 0;
+  }
+  techChar_->bufStageDelayPs(bufM, cin, tmp, &s0);
+
+  // Stage locations (same stepping as the chain builder: from the branch driver
+  // toward the centroid of the depth>0 registers).
+  double ccx = 0.0, ccy = 0.0;
+  for (const F& f : fs) {
+    ccx += f.ff->getX();
+    ccy += f.ff->getY();
+  }
+  ccx /= fs.size();
+  ccy /= fs.size();
+  int bufW = 0;
+  if (odb::dbMaster* m = db_->findMaster(bufM.c_str())) {
+    bufW = m->getWidth();
+  }
+  const int step = std::max(bufW + bufW / 2, wireSegmentUnit_);
+  double ux = ccx - drv->getX(), uy = ccy - drv->getY();
+  const double ul = std::sqrt(ux * ux + uy * uy);
+  if (ul > 1e-9) {
+    ux /= ul;
+    uy /= ul;
+  } else {
+    ux = 1.0;
+    uy = 0.0;
+  }
+  const int dmax = std::max(1, tapMaxDepth_);
+  const int kmax = dmax + 1;
+  std::vector<std::string> mst(kmax + 2, bufM);
+  mst[1] = st1M;
+  std::map<std::string, double> cinOf;
+  auto cinM = [&](const std::string& m) {
+    auto it = cinOf.find(m);
+    if (it == cinOf.end()) {
+      it = cinOf.emplace(m, techChar_->bufInputCapF(m)).first;
+    }
+    return it->second;
+  };
+  auto stageX = [&](int k) { return drv->getX() + ux * step * k; };
+  auto stageY = [&](int k) { return drv->getY() + uy * step * k; };
+
+  // Leaf data: the sinks already on each leaf net.
+  struct Leaf
+  {
+    std::string master;
+    double baseCap = 0.0;  // pin caps of the sinks already on the leaf
+    int baseSinks = 0;
+    double x0 = 0, x1 = 0, y0 = 0, y1 = 0;  // bbox of driver + sinks (dbu)
+  };
+  std::map<ClockSubNet*, Leaf> leaves;
+  for (const F& f : fs) {
+    if (f.home == nullptr || leaves.count(f.home)) {
+      continue;
+    }
+    Leaf L;
+    ClockInst* ld = f.home->getDriver();
+    L.master = ld != nullptr ? ld->getMaster() : bufM;
+    L.x0 = L.x1 = ld != nullptr ? ld->getX() : f.ff->getX();
+    L.y0 = L.y1 = ld != nullptr ? ld->getY() : f.ff->getY();
+    f.home->forEachSink([&](ClockInst* s) {
+      L.baseCap += (s->getInputCap() > 0 ? s->getInputCap() : cin);
+      ++L.baseSinks;
+      L.x0 = std::min<double>(L.x0, s->getX());
+      L.x1 = std::max<double>(L.x1, s->getX());
+      L.y0 = std::min<double>(L.y0, s->getY());
+      L.y1 = std::max<double>(L.y1, s->getY());
+    });
+    leaves[f.home] = L;
+  }
+
+  // Wire length of a clock net: max(HPWL, 0.7124*sqrt(n*area)), the
+  // Beardwood-Halton-Hammersley estimate of a rectilinear Steiner tree over n
+  // pins in the box (HPWL alone under-counts a net with tens of sinks).
+  auto steinerLen = [](double w, double h, int n) {
+    const double hp = w + h;
+    const double bhh = 0.7124 * std::sqrt(std::max(0, n) * std::max(0.0, w * h));
+    return std::max(hp, bhh);
+  };
+  std::vector<double> A(kmax + 1, 0.0);
+  std::map<ClockSubNet*, double> dLeaf;
+  auto evalModel = [&]() {
+    int kcur = 1;
+    for (const F& f : fs) {
+      kcur = std::max(kcur, f.d + 1);
+    }
+    std::vector<double> capK(kmax + 1, 0.0);
+    std::vector<int> nK(kmax + 1, 0);
+    std::vector<double> bx0(kmax + 1), bx1(kmax + 1), by0(kmax + 1),
+        by1(kmax + 1);
+    for (int k = 1; k <= kmax; ++k) {
+      bx0[k] = bx1[k] = stageX(k);
+      by0[k] = by1[k] = stageY(k);
+    }
+    for (const F& f : fs) {
+      if (f.d <= 0) {
+        continue;
+      }
+      const int k = f.d + 1;
+      capK[k] += f.capF;
+      ++nK[k];
+      bx0[k] = std::min<double>(bx0[k], f.ff->getX());
+      bx1[k] = std::max<double>(bx1[k], f.ff->getX());
+      by0[k] = std::min<double>(by0[k], f.ff->getY());
+      by1[k] = std::max<double>(by1[k], f.ff->getY());
+    }
+    double sin = s0, acc = 0.0;
+    for (int k = 1; k <= kmax; ++k) {
+      double load = capK[k];
+      if (k < std::max(kcur, 2)) {
+        // the next stage exists: its input pin and the step wire to it
+        load += cinM(mst[k + 1]) + capPerDbu * step;
+      }
+      load += capPerDbu * steinerLen(bx1[k] - bx0[k], by1[k] - by0[k], nK[k] + 1);
+      double sout = sin;
+      const std::string& m = mst[k];
+      double dk = techChar_->bufStageDelayPs(m, load, sin, &sout);
+      if (dk < 0.0) {
+        dk = techChar_->bufStageDelayPs(bufM, load, sin, &sout);
+      }
+      acc += dk;
+      A[k] = acc;
+      sin = sout;
+    }
+    dLeaf.clear();
+    for (auto& [net, L] : leaves) {
+      double cap = L.baseCap;
+      int nL = L.baseSinks;
+      double x0 = L.x0, x1 = L.x1, y0 = L.y0, y1 = L.y1;
+      for (const F& f : fs) {
+        if (f.home == net && f.d == 0) {
+          cap += f.capF;
+          ++nL;
+          x0 = std::min<double>(x0, f.ff->getX());
+          x1 = std::max<double>(x1, f.ff->getX());
+          y0 = std::min<double>(y0, f.ff->getY());
+          y1 = std::max<double>(y1, f.ff->getY());
+        }
+      }
+      cap += capPerDbu * steinerLen(x1 - x0, y1 - y0, nL + 1);
+      double so = 0.0;
+      double dl = techChar_->bufStageDelayPs(L.master, cap, s0, &so);
+      if (dl < 0.0) {
+        dl = techChar_->bufStageDelayPs(bufM, cap, s0, &so);
+      }
+      dLeaf[net] = dl;
+    }
+  };
+  auto incr = [&](const F& f, int d) {
+    if (d <= 0) {
+      return 0.0;
+    }
+    const double ref
+        = (f.home != nullptr && dLeaf.count(f.home)) ? dLeaf[f.home] : A[1];
+    return A[d + 1] - ref;
+  };
+  auto meanErr = [&](double& meanAbs, double& meanOver) {
+    meanAbs = meanOver = 0.0;
+    for (const F& f : fs) {
+      const double e = incr(f, f.d) - f.aPs;
+      meanAbs += std::abs(e);
+      meanOver += std::max(0.0, e);
+    }
+    meanAbs /= fs.size();
+    meanOver /= fs.size();
+  };
+
+  evalModel();
+  double eb = 0.0, ob = 0.0;
+  meanErr(eb, ob);
+  const double hyst = 0.5;
+  // The loads move with the assignment, so a pass can overshoot; the best
+  // assignment seen (by the cost) is kept rather than the last one.
+  std::vector<int> bestD(fs.size());
+  for (size_t i = 0; i < fs.size(); ++i) {
+    bestD[i] = fs[i].d;
+  }
+  std::vector<std::string> bestMst = mst;
+  auto costOf = [&](const F& f, int d) {
+    const double inc = incr(f, d);
+    return std::max(0.0, f.aPs - inc) + std::max(0.0, inc - f.holdPs)
+           + 0.1 * std::max(0.0, inc - f.aPs);
+  };
+  auto totalErr = [&]() {
+    double t = 0.0;
+    for (const F& f : fs) {
+      t += costOf(f, f.d);
+    }
+    return t;
+  };
+  double cur = totalErr();
+  double bestMean = cur / fs.size();
+  int passes = 0;
+  // Joint descent: a move changes the load (and so the delay) of the source
+  // and destination stages and of every stage between them, i.e. the errors of
+  // the other registers of the chain.  Each candidate move is therefore scored
+  // by the chain total re-evaluated with the moved load; registers are visited
+  // in decreasing cost.
+  auto descend = [&]() {
+    for (int pass = 0; pass < 8; ++pass, ++passes) {
+      int changed = 0;
+      std::vector<size_t> order(fs.size());
+      for (size_t i = 0; i < fs.size(); ++i) {
+        order[i] = i;
+      }
+      std::sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+        return costOf(fs[a], fs[a].d) > costOf(fs[b], fs[b].d);
+      });
+      for (size_t oi : order) {
+        F& f = fs[oi];
+        const bool leafOk = f.home != nullptr && leaves[f.home].baseSinks > 0;
+        const int d0 = f.d;
+        int best = d0;
+        double bestTot = cur;
+        for (int d = 0; d <= dmax; ++d) {
+          if (d == d0 || (d == 0 && !leafOk)) {
+            continue;
+          }
+          f.d = d;
+          evalModel();
+          const double t = totalErr();
+          if (t + hyst < bestTot) {
+            bestTot = t;
+            best = d;
+          }
+        }
+        f.d = best;
+        evalModel();
+        if (best != d0) {
+          cur = bestTot;
+          ++changed;
+        }
+      }
+      const double m = cur / fs.size();
+      if (m < bestMean) {
+        bestMean = m;
+        for (size_t i = 0; i < fs.size(); ++i) {
+          bestD[i] = fs[i].d;
+        }
+        bestMst = mst;
+      }
+      if (changed == 0) {
+        break;
+      }
+    }
+  };
+  // Stage sizing: for each sizable stage (front to back) every same-family
+  // master is scored; a wider buffer on a heavily tapped stage shortens that
+  // stage's delay, an over-delivery that no depth choice can remove.
+  int resized = 0;
+  auto sizeStages = [&]() {
+    for (int k = firstSizable; k <= kmax && upsizes.size() > 1; ++k) {
+      const std::string m0 = mst[k];
+      std::string bestM = m0;
+      double bestTot = cur;
+      std::vector<std::pair<std::string, double>> sc;
+      double tMin = cur;
+      for (const std::string& m : upsizes) {
+        mst[k] = m;
+        evalModel();
+        const double t = totalErr();
+        sc.emplace_back(m, t);
+        tMin = std::min(tMin, t);
+      }
+      const double nF = static_cast<double>(fs.size());
+      for (const auto& [m, t] : sc) {  // base first, then by width
+        if (t <= tMin + 0.25 * nF) {
+          if (m != m0 && t + 0.5 * nF <= cur) {
+            bestM = m;
+            bestTot = t;
+          }
+          break;
+        }
+      }
+      mst[k] = bestM;
+      evalModel();
+      if (bestM != m0) {
+        cur = bestTot;
+        ++resized;
+      }
+    }
+    const double m = cur / fs.size();
+    if (m < bestMean) {
+      bestMean = m;
+      for (size_t i = 0; i < fs.size(); ++i) {
+        bestD[i] = fs[i].d;
+      }
+      bestMst = mst;
+    }
+  };
+  descend();
+  for (int round = 0; round < 2; ++round) {
+    const int r0 = resized;
+    sizeStages();
+    descend();
+    if (resized == r0) {
+      break;
+    }
+  }
+  for (size_t i = 0; i < fs.size(); ++i) {
+    fs[i].d = bestD[i];
+  }
+  mst = bestMst;
+  evalModel();
+  stageMaster = mst;
+  double ea = 0.0, oa = 0.0;
+  meanErr(ea, oa);
+
+  int moved = 0;
+  std::map<int, std::vector<ClockInst*>> ndg;
+  for (auto& [d, v] : dg) {
+    if (d <= 0) {
+      ndg[d] = v;  // depth <= 0: not in a chain, copied unchanged
+    }
+  }
+  for (const F& f : fs) {
+    moved += (f.d != f.d0);
+    if (f.d <= 0) {
+      demoted.push_back(f.ff);
+    } else {
+      ndg[f.d].push_back(f.ff);
+    }
+  }
+  dg.swap(ndg);
+  logger_->info(CTS,
+                2060,
+                "Load-aware taps: branch {} chain {} tier {} (stage1 tier {}): "
+                "{} FFs, {} re-depthed ({} to leaf), {} passes; model mean|err| "
+                "{:.2f} -> {:.2f} ps, mean over {:.2f} -> {:.2f} ps; resized "
+                "stages {}",
+                branchIdx,
+                chainIdx,
+                chainTier,
+                stage1Tier,
+                fs.size(),
+                moved,
+                demoted.size(),
+                passes + 1,
+                eb,
+                ea,
+                ob,
+                oa,
+                [&]() {
+                  std::string r;
+                  for (int k = firstSizable; k <= kmax; ++k) {
+                    if (mst[k] != (k == 1 ? st1M : bufM)) {
+                      r += " s" + std::to_string(k) + "=" + mst[k];
+                    }
+                  }
+                  return r.empty() ? std::string("none") : r;
+                }());
+  return moved;
+}
+
+// Hold budgets for the load-aware tap assignment.  The timing-graph CSV can be
+// large (millions of rows), so it is parsed once per process; later trees of the
+// same process reuse the maps (key = file paths, sizes and mtimes; the budgets
+// also depend on the LP targets, which are fixed for the session).
+void HTreeBuilder::loadHoldBudgets()
+{
+  const char* csv = std::getenv("CTS_TIMING_GRAPH_CSV");
+  const char* ioCsv = std::getenv("CTS_IO_TIMING_CSV");
+  auto stamp = [](const char* f) {
+    struct stat st;
+    if (f == nullptr || stat(f, &st) != 0) {
+      return std::string("-");
+    }
+    return std::to_string(st.st_size) + ":" + std::to_string(st.st_mtime);
+  };
+  const std::string key = std::string(csv ? csv : "") + "|" + stamp(csv) + "|"
+                          + (ioCsv ? ioCsv : "") + "|" + stamp(ioCsv);
+  static std::string cacheKey;
+  static std::unordered_map<std::string, double> cacheBudget;
+  if (!cacheKey.empty() && cacheKey == key) {
+    tapHoldBudget_ = cacheBudget;
+    logger_->info(CTS,
+                  2072,
+                  "Hold budgets reused from the first tree ({} capture FFs)",
+                  tapHoldBudget_.size());
+    return;
+  }
+  if (csv) {
+    loadTapHoldBudgets(csv);
+  }
+  if (ioCsv) {
+    loadIoTapHoldBudgets(ioCsv);
+  }
+  cacheKey = key;
+  cacheBudget = tapHoldBudget_;
+}
+
 }  // namespace cts
