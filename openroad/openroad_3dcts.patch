+    for (const TapSink& ts : binSinks) {
+      dg[ts.depth].push_back(ts.inst);
+    }
+    int downstream = 0;
+    int maxDepth = 0;
+    for (auto& [d, v] : dg) {
+      if (d > 0) {
+        downstream += static_cast<int>(v.size());
+        if (!v.empty()) {
+          maxDepth = d;
+        }
+      }
+    }
+
+    ClockInst* drv = branchNet->getDriver();
+    const int driverTier = drv->getTier();
+    // A chain on the tier opposite to the branch driver starts with a bridge.
+    const bool bridge = driverTier >= 0 && chainTier != driverTier;
+
+    // Load-aware depths and stage masters (empty = every stage uses chainMaster).
+    std::vector<std::string> stageMaster;
+    if (downstream > 0 && maxDepth > 0) {
+      std::vector<ClockInst*> demoted;
+      assignLoadAwareTapDepths(dg,
+                               homeNet,
+                               drv,
+                               chainTier,
+                               bridge ? driverTier : chainTier,
+                               branchIdx,
+                               chain,
+                               demoted,
+                               stageMaster);
+      for (ClockInst* ff : demoted) {
+        homeNet[ff]->addInst(*ff);
+        ++directSinks;
+      }
+      downstream = 0;
+      maxDepth = 0;
+      for (auto& [d, v] : dg) {
+        if (d > 0) {
+          downstream += static_cast<int>(v.size());
+          if (!v.empty()) {
+            maxDepth = d;
+          }
+        }
+      }
+    }
+
+    if (downstream <= 0 || maxDepth <= 0) {
+      continue;
+    }
+
+    const std::string chainMaster
+        = cts3dDb_->getBufferForTier(options_->getRootBuffer(), chainTier);
+    int bufW = 0;
+    if (odb::dbMaster* m = db_->findMaster(chainMaster.c_str())) {
+      bufW = m->getWidth();
+    }
+    const int step = std::max(bufW + bufW / 2, wireSegmentUnit_);
+
+    // The chain is stepped from its driver toward the centroid of the
+    // registers it feeds, so the tap->register wires stay short.
+    double ccx = 0.0, ccy = 0.0;
+    for (auto& [d, v] : dg) {
+      if (d == 0) {
+        continue;
+      }
+      for (auto* ff : v) {
+        ccx += ff->getX();
+        ccy += ff->getY();
+      }
+    }
+    ccx /= downstream;
+    ccy /= downstream;
+
+    ClockInst* chainDrv = drv;
+    ClockSubNet* cur = branchNet;
+    if (bridge) {
+      // Bridge: bridge_src on the driver tier and bridge_dst on the chain tier,
+      // both at the legal site nearest to the register centroid, joined by a
+      // dedicated two-pin net, so the chain crosses the tiers once.  The two
+      // bridge buffers count as two delay stages: depth-1 registers attach to
+      // the bridge output and the chain after it has (maxDepth - 1) stages.
+      const std::string bTag = "_sb" + std::to_string(branchIdx) + "g"
+                               + std::to_string(chain) + "_tr"
+                               + std::to_string(chainTier);
+      const std::string bsrcMaster
+          = cts3dDb_->getBufferForTier(options_->getRootBuffer(), driverTier);
+      Point<double> hSrc = legalizeOneBuffer(
+          Point<double>(ccx / wireSegmentUnit_, ccy / wireSegmentUnit_),
+          bsrcMaster);
+      const int bsx = static_cast<int>(hSrc.getX() * wireSegmentUnit_);
+      const int bsy = static_cast<int>(hSrc.getY() * wireSegmentUnit_);
+      ClockInst& bsrc = clock_.addClockBuffer(
+          "clkbuf_bridge_src" + bTag, bsrcMaster, bsx, bsy);
+      cts3dDb_->setClockInstTier(bsrc, driverTier);
+      addTreeLevelBuffer(&bsrc);
+      branchNet->addInst(bsrc);
+      ClockSubNet& bnet = clock_.addSubNet("clknet_bridge" + bTag);
+      bnet.addInst(bsrc);
+      Point<double> hDst = legalizeOneBuffer(
+          Point<double>(ccx / wireSegmentUnit_, ccy / wireSegmentUnit_),
+          chainMaster);
+      const int bdx = static_cast<int>(hDst.getX() * wireSegmentUnit_);
+      const int bdy = static_cast<int>(hDst.getY() * wireSegmentUnit_);
+      ClockInst& bdst = clock_.addClockBuffer(
+          "clkbuf_bridge_dst" + bTag, chainMaster, bdx, bdy);
+      cts3dDb_->setClockInstTier(bdst, chainTier);
+      addTreeLevelBuffer(&bdst);
+      bnet.addInst(bdst);
+      ClockSubNet& bdstNet = clock_.addSubNet("clknet_bridgeout" + bTag);
+      bdstNet.addInst(bdst);
+      auto it1 = dg.find(1);
+      if (it1 != dg.end()) {
+        for (auto* ff : it1->second) {
+          bdstNet.addInst(*ff);
+          ++tappedSinks;
+        }
+      }
+      chainDrv = &bdst;
+      cur = &bdstNet;
+      logger_->info(CTS,
+                    586,
+                    "Bridge: branch {} chain {} tier {}<-{} dedicated 2-pin "
+                    "net, src@({},{}) dst@({},{})",
+                    branchIdx,
+                    chain,
+                    chainTier,
+                    driverTier,
+                    bsx,
+                    bsy,
+                    bdx,
+                    bdy);
+    }
+
+    double sdx = ccx - chainDrv->getX(), sdy = ccy - chainDrv->getY();
+    const double sdLen = std::sqrt(sdx * sdx + sdy * sdy);
+    double sux = 1.0, suy = 0.0;
+    if (sdLen > 1e-9) {
+      sux = sdx / sdLen;
+      suy = sdy / sdLen;
+    }
+
+    // Without a bridge a depth-d register taps stage d+1 (one more stage than
+    // its depth: the first stage replaces the leaf buffer of the register).
+    // Behind a bridge, chain stage s carries the depth-(s+1) registers.
+    const int stages = bridge ? std::max(0, maxDepth - 1) : maxDepth + 1;
+    for (int s = 1; s <= stages; ++s) {
+      // Model stage of this chain stage (the bridge is model stages 1 and 2).
+      const size_t k = static_cast<size_t>(bridge ? s + 2 : s);
+      const std::string& stageM
+          = (k < stageMaster.size() && !stageMaster[k].empty())
+                ? stageMaster[k]
+                : chainMaster;
+      int bx = chainDrv->getX() + static_cast<int>(std::lround(sux * step * s));
+      int by = chainDrv->getY() + static_cast<int>(std::lround(suy * step * s));
+      {
+        Point<double> rawLoc(static_cast<double>(bx) / wireSegmentUnit_,
+                             static_cast<double>(by) / wireSegmentUnit_);
+        Point<double> legalLoc = legalizeOneBuffer(rawLoc, stageM);
+        bx = static_cast<int>(legalLoc.getX() * wireSegmentUnit_);
+        by = static_cast<int>(legalLoc.getY() * wireSegmentUnit_);
+      }
+      // The location is clamped to the core area (legalizeOneBuffer and
+      // resolveLocationCollision do not check the core boundary).
+      if (db_ != nullptr && db_->getChip() != nullptr) {
+        const odb::Rect core = db_->getChip()->getBlock()->getCoreArea();
+        odb::dbMaster* cm = db_->findMaster(stageM.c_str());
+        const int bw = (cm != nullptr) ? cm->getWidth() : 0;
+        const int bh = (cm != nullptr) ? cm->getHeight() : 0;
+        bx = std::max<int>(core.xMin(), std::min<int>(bx, core.xMax() - bw));
+        by = std::max<int>(core.yMin(), std::min<int>(by, core.yMax() - bh));
+      }
+
+      const std::string tag = "_sb" + std::to_string(branchIdx) + "g"
+                              + std::to_string(chain) + "_c"
+                              + std::to_string(sinkCount) + "_tr"
+                              + std::to_string(chainTier) + "_t"
+                              + std::to_string(s);
+      ClockInst& stageBuf
+          = clock_.addClockBuffer("clkbuf_ghtap" + tag, stageM, bx, by);
+      cts3dDb_->setClockInstTier(stageBuf, chainTier);
+      addTreeLevelBuffer(&stageBuf);
+      cur->addInst(stageBuf);
+
+      ClockSubNet& stageNet = clock_.addSubNet("clknet_ghtap" + tag);
+      stageNet.addInst(stageBuf);
+
+      const int dHere = bridge ? s + 1 : s - 1;
+      if (dHere >= 1 && dg.count(dHere)) {
+        for (auto* ff : dg[dHere]) {
+          stageNet.addInst(*ff);
+          ++tappedSinks;
+        }
+      }
+      if (s == stages) {
+        stageNet.setLeafLevel(true);
+      }
+      cur = &stageNet;
+      ++numBufs;
+    }
+    // Number of leaves feeding this chain = distinct leaf nets of its registers.
+    std::set<ClockSubNet*> leaves;
+    for (auto& [d, v] : dg) {
+      if (d == 0) {
+        continue;
+      }
+      for (auto* ff : v) {
+        leaves.insert(homeNet[ff]);
+      }
+    }
+    logger_->info(CTS,
+                  582,
+                  "Shared delay chain: branch {} chain {} tier {} - {} stages "
+                  "feed {} depth>0 FFs from {} leaves",
+                  branchIdx,
+                  chain,
+                  chainTier,
+                  stages,
+                  downstream,
+                  static_cast<int>(leaves.size()));
+  }
+  return numBufs;
+}
