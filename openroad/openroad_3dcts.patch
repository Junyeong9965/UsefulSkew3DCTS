+    }
+    for (odb::dbBlockage* bk : block->getBlockages()) {
+      odb::Rect b = bk->getBBox()->getBox();
+      forRows(b.yMin(), b.yMax(), [&](int y) { occ[y].push_back({b.xMin(), b.xMax(), -1, nullptr}); });
