+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+// Shared helpers of the early-clock decision modules: CSV / TSV reading, deterministic number formatting
+// (shortest round-trip, decimal rounding, '%.nf'), pairwise summation and a small JSON value with an indented
+// writer.
+#pragma once
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <stdlib.h>
+#include <map>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace cts::early {
+
+[[noreturn]] inline void fail(const std::string& m) { throw std::runtime_error(m); }
+
+// ------------------------------------------------------------------------------------------------ files
+inline std::vector<std::string> read_lines(const std::string& path)
+{
+  std::ifstream in(path);
+  if (!in) fail("cannot read " + path);
+  std::vector<std::string> out;
+  std::string l;
+  while (std::getline(in, l)) {
+    if (!l.empty() && l.back() == '\r') l.pop_back();
+    out.push_back(l);
+  }
+  return out;
+}
+inline std::string read_text(const std::string& path)
+{
+  std::ifstream in(path, std::ios::binary);
+  if (!in) fail("cannot read " + path);
+  std::ostringstream ss;
+  ss << in.rdbuf();
+  return ss.str();
+}
+inline void write_text(const std::string& path, const std::string& s)
+{
+  std::ofstream out(path, std::ios::binary);
+  if (!out) fail("cannot write " + path);
+  out << s;
+}
+inline bool file_exists(const std::string& path)
+{
+  std::ifstream in(path);
+  return in.good();
+}
+inline std::string join_path(const std::string& a, const std::string& b)
+{
+  if (a.empty()) return b;
+  if (b.empty()) return a;
+  return a.back() == '/' ? a + b : a + "/" + b;
+}
+// realpath of an existing path (the path itself when it cannot be resolved)
+inline std::string realpath_exists(const std::string& p)
+{
+  char buf[4096];
+  const char* r = ::realpath(p.c_str(), buf);
+  return r ? std::string(r) : p;
+}
+inline std::string dirname_of(const std::string& p)
+{
+  auto k = p.rfind('/');
+  return k == std::string::npos ? "." : (k == 0 ? "/" : p.substr(0, k));
+}
+inline void mkdirs(const std::string& path)
+{
+  std::string cmd = "mkdir -p '" + path + "'";
+  if (std::system(cmd.c_str()) != 0) fail("mkdir failed: " + path);
+}
+inline std::vector<std::string> split(const std::string& s, char sep)
+{
+  std::vector<std::string> out;
+  size_t a = 0;
+  while (true) {
+    size_t b = s.find(sep, a);
+    if (b == std::string::npos) { out.push_back(s.substr(a)); break; }
+    out.push_back(s.substr(a, b - a));
+    a = b + 1;
+  }
+  return out;
+}
+inline std::string strip(const std::string& s)
+{
+  size_t a = 0, b = s.size();
+  while (a < b && std::isspace((unsigned char) s[a])) ++a;
+  while (b > a && std::isspace((unsigned char) s[b - 1])) --b;
+  return s.substr(a, b - a);
+}
+inline bool starts_with(const std::string& s, const char* p) { return s.compare(0, std::strlen(p), p) == 0; }
+inline bool ends_with(const std::string& s, const char* p)
+{
+  size_t n = std::strlen(p);
+  return s.size() >= n && s.compare(s.size() - n, n, p) == 0;
+}
+// Instance part of "inst/pin" (text before the last '/')
+inline std::string inst_of(const std::string& pin)
+{
+  auto k = pin.rfind('/');
+  return k == std::string::npos ? pin : pin.substr(0, k);
+}
