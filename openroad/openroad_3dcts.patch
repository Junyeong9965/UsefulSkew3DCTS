diff --git a/src/cts/src/ClockLatencyEstimator.cpp b/src/cts/src/ClockLatencyEstimator.cpp
new file mode 100644
index 0000000000..af74fb2f59
--- /dev/null
+++ b/src/cts/src/ClockLatencyEstimator.cpp
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2019-2025, The OpenROAD Authors
+//
+// See ClockLatencyEstimator.h.
+
+#include "ClockLatencyEstimator.h"
+
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <iomanip>
+
+#include "Cts3DDatabase.h"
+#include "odb/db.h"
+
+namespace cts {
+
+ClockLatencyEstimator::ClockLatencyEstimator(Cts3DDatabase* db3d)
+    : db3d_(db3d)
+{
+  // Elmore delay of one hybrid-bond via (lumped RC, 50% threshold):
+  //   t_via = 0.693 * R_HB (ohms) * C_HB (farads)  [seconds]
+  // Without hybrid-bond parasitics t_via = 0 and both tiers get the same bound.
+  const double R = db3d_->getHbtResistance();  // ohms
+  const double C = db3d_->getHbtCapacitance();  // farads
+  t_via_ns_ = 0.693 * R * C * 1.0e9;           // seconds to ns
+}
+
+void ClockLatencyEstimator::estimateAndWrite(const std::string& output_csv,
+                                              double max_skew_ns)
+{
+  // Bottom-tier register: t_max = max_skew; upper-tier: max_skew + t_via;
+  // t_min = 0 for all registers (a_i >= 0 in the LP).
+  const double t_max_bottom = max_skew_ns;
+  const double t_max_upper  = max_skew_ns + t_via_ns_;
+
+  std::ofstream f(output_csv);
+  if (!f.is_open()) {
+    // The caller (TritonCTS::estimateLeafLatencies) reports the missing file.
+    return;
+  }
+
+  f << std::fixed << std::setprecision(6);
+  f << "ff_name,tier,t_min_ns,t_max_ns\n";
+
+  // Bottom-tier instances (tier 0)
+  const auto& tier0 = db3d_->getInstancesOnTier(0);
+  for (auto* inst : tier0) {
+    f << inst->getName() << ",0,0.000000," << t_max_bottom << "\n";
+  }
+
+  // Upper-tier instances (tier 1)
+  const auto& tier1 = db3d_->getInstancesOnTier(1);
+  for (auto* inst : tier1) {
+    f << inst->getName() << ",1,0.000000," << t_max_upper << "\n";
+  }
+}
+
+}  // namespace cts
diff --git a/src/cts/src/ClockLatencyEstimator.h b/src/cts/src/ClockLatencyEstimator.h
new file mode 100644
index 0000000000..c283811283
--- /dev/null
+++ b/src/cts/src/ClockLatencyEstimator.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2019-2025, The OpenROAD Authors
+//
+// ClockLatencyEstimator: per-register bounds of the clock arrival increment
+// for the LP skew solver (pre_cts_leaf_bounds.csv).
+//
+// A leaf buffer drives the registers of its own tier directly and the
+// registers of the other tier through a hybrid-bond via, so the achievable
+// increment of a register is [0, max_skew] on the bottom tier and
+// [0, max_skew + t_via] on the upper tier, t_via = 0.693 * R_HB * C_HB.
+//
+// Output CSV: ff_name,tier,t_min_ns,t_max_ns  (t_min_ns = 0: delay is only
+// added, a_i >= 0).
+
+#pragma once
+
+#include <string>
+
+namespace cts {
+
+class Cts3DDatabase;
+
+class ClockLatencyEstimator
+{
+ public:
+  // db3d: populated Cts3DDatabase (tiers and hybrid-bond parasitics loaded).
+  explicit ClockLatencyEstimator(Cts3DDatabase* db3d);
+
+  // Writes the per-register bounds of the arrival increment to output_csv.
+  // max_skew_ns: clock delay budget per register (ns).
+  // output_csv:  destination path, format ff_name,tier,t_min_ns,t_max_ns.
+  void estimateAndWrite(const std::string& output_csv, double max_skew_ns);
+
+  // HB via delay in ns (0.693 * R_HB * C_HB, computed at construction).
+  double getViaDelayNs() const { return t_via_ns_; }
+
+ private:
+  Cts3DDatabase* db3d_;    // 3D database: tier assignments + HBT R/C
+  double t_via_ns_ = 0.0;  // Elmore delay of one HB via (ns)
+};
+
+}  // namespace cts
diff --git a/src/cts/src/ClockRefinement.cpp b/src/cts/src/ClockRefinement.cpp
new file mode 100644
index 0000000000..cc6cd3547b
--- /dev/null
+++ b/src/cts/src/ClockRefinement.cpp
@@ -0,0 +1,1128 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+///////////////////////////////////////////////////////////////////////////////
+// STA-guided refinement of an existing clock tree.
+//
+// Local actions on the built tree, each evaluated with placement parasitics
+// and a whole-design timing update and kept or rolled back:
+//   bypass : every load of a non-inverting clock buffer B moves to B's input
+//            net (the subtree arrives one stage earlier; B stays, unloaded).
+//            No new cell, no master change, polarity preserved.
+//   sink   : only the hold-violating register clock pins directly on B's
+//            output net move to B's input net (their siblings stay).  Sinks
+//            whose setup slack is below start setup WNS + sink setup margin are
+//            left in place.
+//   resize : B gets the next one or two wider masters of its family (same
+//            tier, height and pin names).  It stays in place if the wider
+//            footprint is free on its tier, otherwise it moves to the nearest
+//            free site-aligned span of a row of the same height within the
+//            resize radius.  If no same-pin master exists, a wider
+//            one-input/one-output buffer of the same tier and height is used
+//            by creating a new instance (name suffix _rz<id>) on the same nets
+//            (pin remap).  For a root buffer, a joint candidate also steps every
+//            early driver on the root's input net (a non-inverting buffer that
+//            drives only leaf buffers) one master up, so the relative arrival
+//            of the two groups is kept.  Masters matching a dont-use pattern
+//            are never used.
+// Candidates are ranked by the hold violation carried by the affected sinks
+// and evaluated one at a time.  Keep rule:
+//   hold TNS gain > kMinHoldGainPs
+//   hold WNS >= reference - kHoldWnsTolPs (reference = current kept state with
+//             CTS_REFINE_HOLD_WNS_VS_CURRENT=1, else the start state)
+//   setup WNS >= start - kSetupWnsTolPs
+//   cumulative setup TNS loss <= kSetupTnsBudgetFrac x |start setup TNS|
+//   setup TNS loss of the candidate <= CTS_REFINE_MAX_SETUP_PER_HOLD x its
+//             hold TNS gain (0 = no exchange-rate limit)
+//   max-slew/cap/fanout violator counts <= start counts
+//   guard endpoints (CTS_GUARD_ENDPOINTS_TSV): slack >= CTS_GUARD_MARGIN_PS or
+//             >= its start slack
+// Budget: CTS_REFINE_MAX_CAND evaluations or CTS_REFINE_MAX_SEC seconds.
+// Options (default values in parentheses):
+//   CTS_REFINE_KINDS                 comma list of bypass,sink,resize
+//   CTS_REFINE_MAX_CAND (60), CTS_REFINE_MAX_SEC (2400)
+//   CTS_REFINE_MAX_SETUP_PER_HOLD (2), CTS_REFINE_RESIZE_RADIUS_UM (3)
+//   CTS_REFINE_SINK_SETUP_MARGIN_PS (25, negative = no filter)
+//   CTS_REFINE_HOLD_WNS_VS_CURRENT (1)
+//   CTS_REFINE_DONT_USE (space separated globs, default DONT_USE_CELLS)
+//   CTS_GUARD_ENDPOINTS_TSV, CTS_GUARD_MARGIN_PS (10)
+// Evaluation: incremental parasitics + fast read-out (SelEval.h); the final
+// state is re-checked with a whole-design estimation and the full read-out.
+//
+// Audit ($RESULTS_DIR): refine_candidates.csv (per candidate: kind, subtree
+// size, metrics, violator counts, decision, reason), refine_sinks.csv (every
+// kept candidate: affected sinks and siblings with early/late clock arrival
+// and hold/setup slack before and after), refine_resize_masters.csv,
+// refine_evals.csv, refine_timing.csv, refine_eval_stats.csv,
+// refine_summary.csv.
+///////////////////////////////////////////////////////////////////////////////
+#include <algorithm>
+#include <chrono>
+#include <fnmatch.h>
+
+#include <cctype>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <functional>
+#include <map>
+#include <memory>
+#include <set>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "db_sta/dbNetwork.hh"
+#include "db_sta/dbSta.hh"
+#include "est/EstimateParasitics.h"
+#include "odb/db.h"
+#include "sta/Clock.hh"
+#include "sta/Corner.hh"
+#include "sta/Delay.hh"
+#include "sta/Graph.hh"
+#include "sta/Liberty.hh"
+#include "sta/MinMax.hh"
+#include "sta/Path.hh"
+#include "sta/Sdc.hh"
+#include "sta/Transition.hh"
+#include "utl/Logger.h"
+
+#include "SelEval.h"
+
+namespace cts {
+using utl::CTS;
+
+namespace {
+const double PS = 1e12;
+// Fixed keep-rule constants.
+constexpr double kMinHoldGainPs = 1.0;
+constexpr double kHoldWnsTolPs = 0.02;
+constexpr double kSetupWnsTolPs = 0.5;
+constexpr double kSetupTnsBudgetFrac = 0.01;
+constexpr double kGuardMarginPs = 10.0;
+// Default options.
+constexpr const char* kDefaultKinds = "bypass,sink,resize";
+constexpr int kDefaultMaxCand = 60;
+constexpr double kDefaultMaxSec = 2400;
+constexpr double kDefaultMaxSetupPerHold = 2.0;
+constexpr double kDefaultResizeRadiusUm = 3.0;
+constexpr double kDefaultSinkSetupMarginPs = 25.0;
+constexpr int kDefaultHoldWnsVsCurrent = 1;
+const double kNaN = std::numeric_limits<double>::quiet_NaN();
+double envD(const char* n, double d)
+{
+  const char* e = std::getenv(n);
+  return (e && *e) ? std::atof(e) : d;
+}
+std::string envS(const char* n, const std::string& d)
+{
+  const char* e = std::getenv(n);
+  return (e && *e) ? std::string(e) : d;
+}
+struct Sink
+{
+  odb::dbInst* inst;
+  odb::dbITerm* clk;
+  sta::Pin* pin;
+  std::vector<sta::Pin*> data;
+  double arrE = kNaN, arrL = kNaN, hold = 1e9, setup = 1e9;
+};
+struct Node  // a clock buffer in the tree
+{
+  odb::dbInst* inst;
+  odb::dbITerm* in;
+  odb::dbITerm* out;
+  odb::dbNet* inNet;
+  odb::dbNet* outNet;
+  bool inverting;
+  std::vector<int> childBufs;   // nodes driven by outNet
+  std::vector<int> sinks;       // sinks on outNet
+  std::vector<int> subtreeSinks;
+  int parent = -1;
+};
+struct Metrics
+{
+  double st, sw, ht, hw;
+  int slew, cap, fo;
+};
+}  // namespace
+
+void runClockRefinement(odb::dbDatabase* db,
+                        sta::dbSta* sta,
+                        sta::dbNetwork* network,
+                        est::EstimateParasitics* est,
+                        utl::Logger* logger)
+{
+  const auto t0 = std::chrono::steady_clock::now();
+  auto secs = [&](std::chrono::steady_clock::time_point a) {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() - a).count();
+  };
+  const std::string rd = envS("RESULTS_DIR", ".");
+  odb::dbBlock* block = db->getChip()->getBlock();
+
+  // ---------- sinks and clock buffers ----------
+  std::vector<Sink> sinks;
+  std::unordered_map<odb::dbNet*, std::vector<int>> sinksOnNet;
+  std::vector<Node> nodes;
+  std::unordered_map<odb::dbNet*, int> nodeByOutNet;
+  for (odb::dbInst* inst : block->getInsts()) {
+    sta::Instance* si = network->dbToSta(inst);
+    sta::LibertyCell* cell = si ? network->libertyCell(si) : nullptr;
+    if (cell == nullptr) {
+      continue;
+    }
+    if (cell->isBuffer() || cell->isInverter()) {
+      Node n;
+      n.inst = inst;
+      n.inverting = cell->isInverter();
+      n.in = n.out = nullptr;
+      for (odb::dbITerm* t : inst->getITerms()) {
+        if (t->getSigType().isSupply() || t->getNet() == nullptr) {
+          continue;
+        }
+        if (t->getIoType() == odb::dbIoType::OUTPUT) {
+          n.out = t;
+        } else {
+          n.in = t;
+        }
+      }
+      if (n.in && n.out) {
+        n.inNet = n.in->getNet();
+        n.outNet = n.out->getNet();
+        nodeByOutNet[n.outNet] = static_cast<int>(nodes.size());
+        nodes.push_back(n);
+      }
+      continue;
+    }
+    Sink s;
+    s.inst = inst;
+    s.clk = nullptr;
+    for (odb::dbITerm* t : inst->getITerms()) {
+      if (t->getIoType() != odb::dbIoType::INPUT || t->getNet() == nullptr
+          || t->getSigType().isSupply()) {
+        continue;
+      }
+      sta::Pin* p = network->dbToSta(t);
+      sta::LibertyPort* lp = p ? network->libertyPort(p) : nullptr;
+      if (lp == nullptr) {
+        continue;
+      }
+      if (lp->isClock() && s.clk == nullptr) {
+        s.clk = t;
+        s.pin = p;
+      } else {
+        s.data.push_back(p);
+      }
+    }
+    if (s.clk) {
+      sinksOnNet[s.clk->getNet()].push_back(static_cast<int>(sinks.size()));
+      sinks.push_back(s);
+    }
+  }
+  // Tree edges: only buffers whose input net is driven by another clock buffer
+  // or by a clock source are part of the clock tree.  Reachability is
+  // traced from the SDC clock pins.
+  std::unordered_set<odb::dbNet*> clockNets;
+  {
+    std::vector<odb::dbNet*> q;
+    for (sta::Clock* clk : *sta->sdc()->clocks()) {
+      for (const sta::Pin* p : clk->leafPins()) {
+        odb::dbITerm* it = nullptr;
+        odb::dbBTerm* bt = nullptr;
+        odb::dbModITerm* mt = nullptr;
+        network->staToDb(p, it, bt, mt);
+        odb::dbNet* n = it ? it->getNet() : (bt ? bt->getNet() : nullptr);
+        if (n && clockNets.insert(n).second) {
+          q.push_back(n);
+        }
+      }
+    }
+    while (!q.empty()) {
+      odb::dbNet* n = q.back();
+      q.pop_back();
+      for (odb::dbITerm* t : n->getITerms()) {
+        if (t->getIoType() != odb::dbIoType::INPUT) {
+          continue;
+        }
+        // continue through buffers / inverters / clock gaters (any cell whose
+        // output net reaches register clock pins); stop at registers.
+        odb::dbInst* inst = t->getInst();
+        sta::Instance* si = network->dbToSta(inst);
+        sta::LibertyCell* cell = si ? network->libertyCell(si) : nullptr;
+        if (cell == nullptr || cell->hasSequentials()) {
+          continue;
+        }
+        for (odb::dbITerm* o : inst->getITerms()) {
+          if (o->getIoType() == odb::dbIoType::OUTPUT && o->getNet()
+              && clockNets.insert(o->getNet()).second) {
+            q.push_back(o->getNet());
+          }
+        }
+      }
+    }
+  }
+  for (size_t i = 0; i < nodes.size(); ++i) {
+    Node& n = nodes[i];
+    if (!clockNets.count(n.outNet)) {
+      continue;
+    }
+    auto it = nodeByOutNet.find(n.inNet);
+    if (it != nodeByOutNet.end()) {
+      n.parent = it->second;
+      nodes[it->second].childBufs.push_back(static_cast<int>(i));
+    }
+    auto s = sinksOnNet.find(n.outNet);
+    if (s != sinksOnNet.end()) {
+      n.sinks = s->second;
+    }
+  }
+  std::function<void(int)> collect = [&](int i) {
+    Node& n = nodes[i];
+    n.subtreeSinks = n.sinks;
+    for (int c : n.childBufs) {
+      collect(c);
+      n.subtreeSinks.insert(n.subtreeSinks.end(), nodes[c].subtreeSinks.begin(),
+                            nodes[c].subtreeSinks.end());
+    }
+  };
+  for (size_t i = 0; i < nodes.size(); ++i) {
+    if (nodes[i].parent < 0 && clockNets.count(nodes[i].outNet)) {
+      collect(static_cast<int>(i));
+    }
+  }
+
+  // ---------- measurement ----------
+  auto clkArr = [&](sta::Pin* pin, const sta::MinMax* mm) -> double {
+    sta::Vertex* v = nullptr;
+    sta::Vertex* bv = nullptr;
+    sta->graph()->pinVertices(pin, v, bv);
+    if (!v) {
+      return kNaN;
+    }
+    double best = kNaN;
+    sta::VertexPathIterator it(v, sta::RiseFall::rise(), mm, sta);
+    while (it.hasNext()) {
+      sta::Path* p = it.next();
+      if (!p->isClock(sta)) {
+        continue;
+      }
+      const sta::ClockEdge* e = p->clkEdge(sta);
+      if (!e || e->transition() != sta::RiseFall::rise()) {
+        continue;
+      }
+      const double x = (sta::delayAsFloat(p->arrival()) - e->time()) * PS;
+      if (std::isfinite(x) && (std::isnan(best) || (mm == sta::MinMax::max() ? x > best : x < best))) {
+        best = x;
+      }
+    }
+    return best;
+  };
+  auto slackPs = [&](sta::Pin* pin, const sta::MinMax* mm) -> double {
+    const double s = sta::delayAsFloat(sta->pinSlack(pin, mm));
+    return (!std::isfinite(s) || std::abs(s) > 1e-3) ? 1e9 : s * PS;
+  };
+  int staRuns = 0;
+  double tRank = 0, tEdit = 0, tRoll = 0;
+  auto now = [] { return std::chrono::steady_clock::now(); };
+  sel::Eval ev(db, sta, network, est, logger, rd, "refine");
+  // One evaluation of the current circuit: parasitics (incremental unless
+  // full), design metrics, per-sink clock arrivals and data-pin slacks.
+  // full=true: whole-design estimation and full read-out.
+  auto measureCore = [&](bool full) -> Metrics {
+    ev.rc(full);
+    Metrics m;
+    ev.tnsWns(m.st, m.sw, m.ht, m.hw, full);
+    ev.limits(m.slew, m.cap, m.fo, full);
+    for (Sink& s : sinks) {
+      auto ta = now();
+      s.arrE = clkArr(s.pin, sta::MinMax::min());
+      s.arrL = clkArr(s.pin, sta::MinMax::max());
+      const auto tb = now();
+      ev.t.scanArr += std::chrono::duration<double>(tb - ta).count();
+      s.hold = s.setup = 1e9;
+      for (sta::Pin* dp : s.data) {
+        double h, su;
+        ev.pinSlacks(dp, full, h, su);
+        s.hold = std::min(s.hold, h);
+        s.setup = std::min(s.setup, su);
+      }
+      ev.t.scanSlack += secs(tb);
+    }
+    return m;
+  };
+  auto measure = [&](const std::string& label, bool full = false) -> Metrics {
+    ev.beginEval(label);
+    const Metrics m = measureCore(full);
+    ++staRuns;
