+class HBT
+{
+ public:
+  HBT(const std::string& dump, const std::string& nets_txt, double r_ohm, const std::vector<std::string>& pins,
+      const std::vector<int>& TI, const std::vector<double>& X, const std::vector<double>& Y, const std::vector<double>& CAP_ff,
+      const std::string& root);
+  void set_leaf_masters(const std::map<int, std::string>& m) { leaf_master_ = m; }
+  double R() const { return R_; }
+  double cw() const { return cw_; }
+  // members mem on a new tier-t leaf at (cx, cy) under the tier-t hub; hub_tiers share the entry net
+  std::vector<double> member_delta(const std::vector<int>& mem, int t, long long cx, long long cy, const std::set<int>& hub_tiers) const;
+  struct Group { std::vector<int> mem; int tier; long long cx, cy; };
+  // whole-plan correction (length P)
+  std::vector<double> full_delta(const std::vector<Group>& groups, const std::vector<std::pair<std::string, int>>& geo_leaves);
+
+ private:
+  using Local = std::map<std::string, double>;   // key -> delay (insertion order irrelevant: lookups only)
+  XY xy(const std::string& pin) const;
+  int drv_tier(const std::string& net, bool& ok) const;
+  XY drv_xy(const std::string& net) const;
+  struct Extra { std::string key; int tier; XY xy; double cap; };
+  Local local(const std::string& net, const std::vector<std::string>& loads, bool td_ok, int td, XY dxy, const std::vector<Extra>& extra = {}) const;
+  std::vector<int> walk(const std::string& net, std::vector<std::pair<std::string, std::string>> path, double acc);
+  std::vector<Extra> hub_extra(const std::set<int>& tiers) const;
+  Local entry_local(const std::set<int>& tiers) const;
+  Local new_leaf_local(const std::vector<int>& mem, int t, long long cx, long long cy) const;
+  double below(int i, const std::string& p) const;
+
+  double R_;
+  std::vector<std::string> pins_;
+  int P_;
+  std::unordered_map<std::string, int> pidx_;
+  const std::vector<int>& TI_;
+  const std::vector<double>& X_;
+  const std::vector<double>& Y_;
+  const std::vector<double>& CAP_;
+  Tree tree_;   // all kinds
+  std::string root_;
+  std::unordered_map<std::string, XY> loc_;
+  std::unordered_map<std::string, int> tier_;
+  std::unordered_map<std::string, double> cap_;
+  std::unordered_map<std::string, std::string> net_drv_;   // "" = port
+  std::vector<std::string> net_order_;                     // net_loads insertion order
+  std::unordered_map<std::string, std::vector<std::string>> net_loads_;
+  std::unordered_map<std::string, double> wc_;
+  std::unordered_map<std::string, double> mcap_;
+  std::unordered_map<std::string, std::string> child_, in_pin_, pin_net_;
+  double cw_ = 0;
+  std::unordered_map<std::string, Local> ref_local_;
+  std::unordered_map<std::string, std::vector<int>> sub_;
+  std::unordered_map<int, std::vector<std::pair<std::string, std::string>>> path_;
+  std::vector<double> ref_d_;
+  std::string entry_;
+  bool entry_ok_ = false;
+  std::map<int, std::string> leaf_master_;
+};
+
+// ------------------------------------------------------------------------------------------------ scope
+// usage: early_scope <ref_arm_dir> <plat> <des> <tree_dump_dir> <outview>; returns the regular root
+std::string scope_main(const std::string& ref, const std::string& plat, const std::string& des, const std::string& dump,
+                       const std::string& out);
+
+}  // namespace cts::early
