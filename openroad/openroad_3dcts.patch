+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, ABKGroup
+//
+// Single-root early-hub candidates:
+//   generate: <out>/cands/<cid>.tsv, list.txt, gen.csv, gen.json
+//   measure:  <out>/measured.csv (from the probe reports arr_<cid>.csv)
+//   select:   <out>/plan.tsv, cid, select.json
+//   multi:    <out>/plan_k<k>.tsv, prefixes.json
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <memory>
+#include <numeric>
+#include <thread>
+
+#include "EarlyClockReplay.h"
+#include "EarlyDecision.h"
+
+namespace cts::early {
+
+namespace {
+const char* HUB_PLAN_HEADER = "gid\tmode\tmaster\tx\ty\tparent_driver\tleaf\tmembers\n";
+
+struct Setup
+{
+  Replay R;
+  std::unique_ptr<HBT> H;
+  std::map<int, std::string> masters;
+};
+
+Setup setup(const std::string& plat, const std::string& des, const std::string& view, const std::string& dump,
+            const std::string& calib_dir, const std::string& hbt_nets, const std::string& setrc)
+{
+  Setup s;
+  J cal = json_load(join_path(calib_dir, "calib.json"));
+  std::string fx = join_path(view, "fixed_regs.txt");
+  s.R = load_replay(view, plat, des, dump, cal, file_exists(fx) ? fx : "");
+  for (auto& l : s.R.tree.order)
+    if (starts_with(l, "clkbuf_leaf_")) s.masters.emplace(s.R.tree.rows[l].tier, s.R.tree.rows[l].master);
+  s.H = std::make_unique<HBT>(dump, hbt_nets, read_r_hbt(setrc), s.R.pins, s.R.TI, s.R.X, s.R.Y, s.R.CAP, s.R.root);
+  s.H->set_leaf_masters(s.masters);
+  return s;
+}
+
+// per-register hybrid-bond correction (length P) of one candidate
+std::vector<double> hbt_cand(const Replay& R, HBT& H, const std::string& fam, const std::vector<int>& m, int t, const std::string& leaf)
+{
+  if (fam == "F1") return H.full_delta({}, {{leaf, t}});
+  std::vector<double> xs, ys;
+  for (int i : m) { xs.push_back(R.X[i]); ys.push_back(R.Y[i]); }
+  HBT::Group g{m, t, py_int(np_mean(xs)), py_int(np_mean(ys))};
+  return H.full_delta({g}, {});
+}
+
+// Piecewise-linear interpolation of one value (sorted xp, len >= 1; end values of fp outside the xp range)
+double np_interp(double x, const std::vector<double>& xp, const std::vector<double>& fp)
+{
+  size_t n = xp.size();
+  double lval = fp.front(), rval = fp.back();
+  if (n == 1) return x < xp[0] ? lval : (x > xp[0] ? rval : fp[0]);
+  if (std::isnan(x)) return x;
+  long j;
+  if (x > xp[n - 1]) j = (long) n;
+  else if (x < xp[0]) j = -1;
+  else j = (long) (std::upper_bound(xp.begin(), xp.end(), x) - xp.begin()) - 1;
+  if (j == -1) return lval;
+  if (j == (long) n) return rval;
+  if (j == (long) n - 1) return fp[j];
+  if (xp[j] == x) return fp[j];
+  double slope = (fp[j + 1] - fp[j]) / (xp[j + 1] - xp[j]);
+  double r = slope * (x - xp[j]) + fp[j];
+  if (std::isnan(r)) {
+    r = slope * (x - xp[j + 1]) + fp[j + 1];
+    if (std::isnan(r) && fp[j] == fp[j + 1]) r = fp[j];
+  }
+  return r;
+}
+
+std::string mlist_of(const Replay& R, const std::vector<int>& m)
+{
+  std::vector<int> s(m);
+  std::sort(s.begin(), s.end(), [&](int a, int b) { return R.pins[a] < R.pins[b]; });
+  std::string o;
+  for (size_t i = 0; i < s.size(); ++i) { if (i) o += ";"; o += R.pins[s[i]]; }
+  return o;
+}
+
+// {inst: pred_ps} of the mode == max rows of an arr_*.csv
+std::unordered_map<std::string, double> read_arr(const std::string& path)
+{
+  std::unordered_map<std::string, double> d;
+  Table t = read_table(path);
+  int cp = t.col("pin"), cm = t.col("mode"), cv = t.col("pred_ps");
+  for (auto& r : t.rows) if (r[cm] == "max") d[inst_of(r[cp])] = to_double(r[cv]);
+  return d;
+}
+
+struct Eval { double st, sw, ht, hw, gain; bool ok; };
+Eval evaluate(const Replay& R, const std::vector<double>& d)
+{
+  std::vector<double> su, ho;
+  R.full_replay(d, su, ho);
+  Eval e;
+  R.summ(su, ho, e.st, e.sw, e.ht, e.hw);
+  e.gain = e.st + e.ht - R.b_st - R.b_ht;
+  e.ok = e.sw >= R.b_sw - SETUP_TOL && e.hw >= R.b_hw - HOLD_TOL;
+  return e;
+}
+
+// measured candidates without missing registers and meas_gain > 1 ps, largest gain first (stable)
+std::vector<std::vector<std::string>> passing(const Table& t)
+{
+  int cs = t.col("status"), cm = t.col("missing_regs"), cg = t.col("meas_gain");
+  std::vector<std::vector<std::string>> rows;
+  for (auto& r : t.rows) {
+    long long miss = r[cm].empty() ? 0 : to_int(r[cm]);
+    if (r[cs] == "measured" && !miss && to_double(r[cg]) > 1.0) rows.push_back(r);
+  }
+  std::stable_sort(rows.begin(), rows.end(), [&](auto& a, auto& b) { return -to_double(a[cg]) < -to_double(b[cg]); });
+  return rows;
+}
+}  // namespace
+
+void hub_generate(const std::string& cas, const std::string& plat, const std::string& des, const std::string& view, const std::string& dump,
+                  const std::string& calib_dir, const std::string& out, const std::string& hbt_nets, const std::string& setrc)
+{
+  auto T0 = std::chrono::steady_clock::now();
+  mkdirs(join_path(out, "cands"));
+  Setup S = setup(plat, des, view, dump, calib_dir, hbt_nets, setrc);
+  Replay& R = S.R;
+  HBT& H = *S.H;
+  // measured n=1 shifts per tier vs root distance (calibration points)
+  std::map<int, std::vector<std::pair<double, double>>> pts;
+  {
+    Table cp = read_table(join_path(calib_dir, "calib_points.csv"));
+    int cc = cp.col("cfg"), ct = cp.col("tier"), cd = cp.col("dist_um"), cs = cp.col("shift");
+    for (auto& r : cp.rows) if (r[cc].find("_n1") != std::string::npos) pts[(int) to_int(r[ct])].emplace_back(to_double(r[cd]), to_double(r[cs]));
+  }
+  auto delta = [&](int t, double dist, bool& ok) {
+    auto it = pts.find(t);
+    if (it == pts.end() || it->second.empty()) { ok = false; return 0.0; }
+    std::vector<std::pair<double, double>> p(it->second);
+    std::sort(p.begin(), p.end());
+    std::vector<double> xs, ys;
+    for (auto& q : p) { xs.push_back(q.first); ys.push_back(q.second); }
+    ok = true;
+    return np_interp(dist, xs, ys);
+  };
+  int P = R.P, G = R.G;
+  std::vector<double> dist(P);
+  for (int i = 0; i < P; ++i) dist[i] = (std::fabs(R.X[i] - (double) R.rx) + std::fabs(R.Y[i] - (double) R.ry)) / 1000.0;
+  // per-register construction gains in parallel slots (result independent of the thread count)
+  std::vector<double> single(P, -INFINITY);
+  {
+    const int nth = std::max(1, early_threads());
+    std::atomic<long> calls{0};
+    auto work = [&](int th) {
+      long c = 0;
+      for (int i = th; i < P; i += nth) {
+        int t = R.chosen[R.memb0[i]];
+        bool ok;
+        double dl = delta(t, dist[i], ok);
+        if (!ok) continue;
+        double hx = H.member_delta({i}, t, py_int(R.X[i]), py_int(R.Y[i]), {t})[0];
+        single[i] = R.cgain_quiet({i}, {dl - R.tgt[i] + hx}).first;
+        ++c;
+      }
+      calls += c;
+    };
+    std::vector<std::thread> pool;
+    for (int th = 1; th < nth; ++th) pool.emplace_back(work, th);
+    work(0);
+    for (auto& th : pool) th.join();
+    R.NCG += calls;
+  }
+  struct Row { std::string fam; int k; std::vector<int> m; int t; double gain; bool ok; double dl; };
+  std::vector<Row> rows;
+  for (int k = 0; k < G; ++k) {
+    std::vector<int> m;
+    for (int i = 0; i < P; ++i) if (R.memb0[i] == k) m.push_back(i);
+    int t = R.chosen[k];
+    std::vector<double> xs, ys;
+    for (int i : m) { xs.push_back(R.X[i]); ys.push_back(R.Y[i]); }
+    double cx = np_mean(xs), cy = np_mean(ys);
+    bool ok;
+    double dl = delta(t, (std::fabs(cx - (double) R.rx) + std::fabs(cy - (double) R.ry)) / 1000.0, ok);
+    if (!ok) continue;
+    {
+      auto hb = hbt_cand(R, H, "F1", m, t, R.sk.at(R.pins[m[0]]).driver);
+      std::vector<double> x;
+      for (int i : m) x.push_back(dl - R.tgt[i] + hb[i]);
+      auto g = R.cgain(m, x);
+      rows.push_back({"F1", k, m, t, g.first, g.second, dl});
+    }
+    std::vector<int> s;
+    for (int i : m) if (single[i] > MIN_GAIN) s.push_back(i);
+    if (s.size() >= 2 && s.size() < m.size()) {
+      std::vector<double> sx, sy;
+      for (int i : s) { sx.push_back(R.X[i]); sy.push_back(R.Y[i]); }
+      bool ok2;
+      double dl2 = delta(t, (std::fabs(np_mean(sx) - (double) R.rx) + std::fabs(np_mean(sy) - (double) R.ry)) / 1000.0, ok2);
+      auto hb = hbt_cand(R, H, "F2", s, t, "");
+      std::vector<double> x;
+      for (int i : s) x.push_back(dl2 - R.tgt[i] + hb[i]);
+      auto g = R.cgain(s, x);
+      rows.push_back({"F2", k, s, t, g.first, g.second, dl2});
+    }
+  }
+  std::vector<const Row*> sel;
+  for (const char* fam : {"F1", "F2"}) {
+    std::vector<const Row*> f;
+    for (auto& r : rows) if (r.fam == fam && r.gain > MIN_GAIN) f.push_back(&r);
+    std::stable_sort(f.begin(), f.end(), [](const Row* a, const Row* b) { return -a->gain < -b->gain; });
+    if (f.size() > 8) f.resize(8);
+    sel.insert(sel.end(), f.begin(), f.end());
+  }
+  std::string list, gen = "cid,family,stock_group,n,tier,pred_gain_ps,pred_ok,pred_member_shift_ps\n";
+  for (auto* r : sel) {
+    std::string cid = r->fam + "_" + R.gids[r->k];
+    std::string hub = "hub:" + R.root + ":" + std::to_string(r->t) + ":" + S.masters.at(r->t);
+    std::vector<double> xs, ys;
+    for (int i : r->m) { xs.push_back(R.X[i]); ys.push_back(R.Y[i]); }
+    std::string cx = std::to_string(py_int(np_mean(xs))), cy = std::to_string(py_int(np_mean(ys)));
+    std::string row;
+    if (r->fam == "F1")
+      row = cid + "\treparent\t" + S.masters.at(r->t) + "\t" + cx + "\t" + cy + "\t" + hub + "\t" + R.sk.at(R.pins[r->m[0]]).driver + "\t" + mlist_of(R, r->m);
+    else
+      row = cid + "\tnew\t" + S.masters.at(r->t) + "\t" + cx + "\t" + cy + "\t" + hub + "\t-\t" + mlist_of(R, r->m);
+    write_text(join_path(out, "cands/" + cid + ".tsv"), std::string(HUB_PLAN_HEADER) + row + "\n");
+    list += cid + "\n";
+    char b[256];
+    std::snprintf(b, sizeof b, "%s,%s,%s,%d,%d,%.2f,%d,%.2f\n", cid.c_str(), r->fam.c_str(), R.gids[r->k].c_str(), (int) r->m.size(), r->t,
+                  r->gain, r->ok ? 1 : 0, r->dl);
+    gen += b;
+  }
+  write_text(join_path(out, "cands/list.txt"), list);
+  write_text(join_path(out, "gen.csv"), gen);
+  double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - T0).count();
+  J j = J::Obj();
+  j.set("case", J::S(cas)); j.set("stage", J::S("generate")); j.set("candidates", J::I((long long) sel.size()));
+  j.set("rows_ranked", J::I((long long) rows.size())); j.set("runtime_s", J::D(py_round(secs, 1)));
+  J base = J::Obj();
+  base.set("st", J::D(R.b_st)); base.set("sw", J::D(R.b_sw)); base.set("ht", J::D(R.b_ht)); base.set("hw", J::D(R.b_hw));
+  j.set("base", base);
+  write_text(join_path(out, "gen.json"), j.dump(1));
+  std::printf("hub candidates %s ranked %zu candidates %zu %.1fs\n", cas.c_str(), rows.size(), sel.size(), secs);
+}
+
+void hub_measure(const std::string& cas, const std::string& plat, const std::string& des, const std::string& view, const std::string& dump,
+                 const std::string& calib_dir, const std::string& out, const std::string& hbt_nets, const std::string& setrc,
+                 const std::string& rep)
+{
+  Setup S = setup(plat, des, view, dump, calib_dir, hbt_nets, setrc);
+  Replay& R = S.R;
+  HBT& H = *S.H;
+  int P = R.P, F = R.F;
+  auto base = read_arr(join_path(rep, "arr_base.csv"));
+  Table gt = read_table(join_path(out, "gen.csv"));
+  int g_cid = gt.col("cid"), g_fam = gt.col("family"), g_n = gt.col("n"), g_t = gt.col("tier"), g_pg = gt.col("pred_gain_ps"), g_ps = gt.col("pred_member_shift_ps");
+  std::unordered_map<std::string, const std::vector<std::string>*> gen;
+  for (auto& r : gt.rows) gen[r[g_cid]] = &r;
+  const std::vector<std::string> keys = {"cid", "family", "n", "tier", "pred_member_shift", "meas_member_shift", "nonmember_shift_med",
+                                         "nonmember_shift_max", "pred_gain", "meas_gain", "d_setup_wns", "d_hold_wns", "ok", "missing_regs", "status"};
+  std::string csv = csv_row(keys);
+  int n_meas = 0;
+  for (auto& l : read_lines(join_path(out, "cands/list.txt"))) {
+    std::string cid = strip(l);
+    if (cid.empty()) continue;
+    std::string f = join_path(rep, "arr_" + cid + ".csv");
+    std::map<std::string, std::string> row;
+    row["cid"] = cid;
+    if (!file_exists(f)) {
+      row["status"] = "missing";
+      std::vector<std::string> fields;
+      for (auto& k : keys) fields.push_back(row.count(k) ? row[k] : "");
+      csv += csv_row(fields);
+      continue;
+    }
+    auto a = read_arr(f);
+    std::vector<double> d(P + F, 0.0);
+    long miss = 0;
+    for (auto& kv : R.rid) {
+      auto ia = a.find(kv.first), ib = base.find(kv.first);
+      if (ia != a.end() && ib != base.end()) d[kv.second] = ia->second - ib->second;
+      else if (kv.second < P + F) ++miss;
+    }
+    auto lines = read_lines(join_path(out, "cands/" + cid + ".tsv"));
+    auto row1 = split(lines.at(1), '\t');
+    std::vector<int> mem;
+    for (auto& p : split(row1.at(7), ';')) mem.push_back(R.rid.at(inst_of(p)));
+    int t1 = (int) to_int(split(row1.at(5), ':').at(2));
+    std::string fam1 = cid.substr(0, cid.find('_'));
+    auto hb = hbt_cand(R, H, fam1, mem, t1, row1.at(6));
+    for (int i = 0; i < P; ++i) d[i] += hb[i];
+    std::vector<double> dm;
+    for (int i : mem) dm.push_back(d[i]);
+    double meas_member = np_median(dm);
+    for (int i : mem) d[i] -= R.tgt_all[i];
+    Eval e = evaluate(R, d);
+    std::vector<char> ismem(P, 0);
+    for (int i : mem) if (i < P) ismem[i] = 1;
+    std::vector<double> dn;
+    for (int i = 0; i < P; ++i) if (!ismem[i]) dn.push_back(d[i]);
+    auto& g = *gen.at(cid);
+    row["family"] = g[g_fam];
+    row["n"] = std::to_string(to_int(g[g_n]));
+    row["tier"] = std::to_string(to_int(g[g_t]));
+    row["pred_member_shift"] = py_repr(to_double(g[g_ps]));
+    row["meas_member_shift"] = py_repr(py_round(meas_member, 2));
+    row["nonmember_shift_med"] = py_repr(py_round(np_median(dn), 2));
+    row["nonmember_shift_max"] = py_repr(py_round(np_max(dn), 2));
+    row["pred_gain"] = py_repr(to_double(g[g_pg]));
+    row["meas_gain"] = py_repr(py_round(e.gain, 1));
+    row["d_setup_wns"] = py_repr(np_round(e.sw - R.b_sw, 2));   // WNS differences use scaled (rint) rounding
+    row["d_hold_wns"] = py_repr(np_round(e.hw - R.b_hw, 2));
+    row["ok"] = (e.ok && e.gain > MIN_GAIN) ? "1" : "0";
+    row["missing_regs"] = std::to_string(miss);
+    row["status"] = "measured";
+    std::vector<std::string> fields;
+    for (auto& k : keys) fields.push_back(row.count(k) ? row[k] : "");
+    csv += csv_row(fields);
+    ++n_meas;
+  }
+  write_text(join_path(out, "measured.csv"), csv);
+  std::printf("hub candidates measured %s %d\n", cas.c_str(), n_meas);
+}
+
+std::string hub_select(const std::string& measured, const std::string& cands_dir, const std::string& out)
+{
+  mkdirs(out);
+  Table t = read_table(measured);
+  int cs = t.col("status"), cm = t.col("missing_regs"), cg = t.col("meas_gain"), cc = t.col("cid");
+  std::vector<std::pair<double, std::string>> ok;
+  for (auto& r : t.rows) {
+    long long miss = r[cm].empty() ? 0 : to_int(r[cm]);
+    if (r[cs] == "measured" && !miss && to_double(r[cg]) > 1.0) ok.emplace_back(to_double(r[cg]), r[cc]);
+  }
+  std::stable_sort(ok.begin(), ok.end(), [](auto& a, auto& b) { return -a.first < -b.first; });
+  J res = J::Obj();
+  res.set("rule", J::S("meas_gain > 1 ps, largest gain; WNS judged by select_output.py"));
+  res.set("n_pass", J::I((long long) ok.size()));
+  res.set("selected", ok.empty() ? J::Null() : J::S(ok[0].second));
+  if (!ok.empty()) {
+    write_text(join_path(out, "plan.tsv"), read_text(join_path(cands_dir, ok[0].second + ".tsv")));
+    write_text(join_path(out, "cid"), ok[0].second);
+  }
+  write_text(join_path(out, "select.json"), res.dump(1));
+  std::printf("%s\n", res.dump(1).c_str());
+  return ok.empty() ? "" : ok[0].second;
+}
+
+void hub_multi(const std::string& measured, const std::string& cands_dir, const std::string& out, int K)
+{
+  const size_t cap = 16;
+  mkdirs(out);
+  Table t = read_table(measured);
+  int cc = t.col("cid"), cg = t.col("meas_gain"), ct = t.col("tier");
+  std::vector<std::string> rows;
+  std::set<std::string> regs;
+  bool have_tier = false;
+  int tier = 0;
+  struct Chosen { std::string cid; double gain; size_t n; };
+  std::vector<Chosen> chosen;
+  std::string head;
+  for (auto& r : passing(t)) {
+    auto lines = read_lines(join_path(cands_dir, r[cc] + ".tsv"));   // header + non-blank plan rows
+    head = lines.at(0);
+    std::vector<std::string> body;
+    for (size_t i = 1; i < lines.size(); ++i) if (!strip(lines[i]).empty()) body.push_back(lines[i]);
+    std::set<std::string> mem;
+    for (auto& l : body) for (auto& m : split(split(l, '\t').at(7), ';')) mem.insert(m);
+    int tt = (int) to_int(r[ct]);
+    if (!have_tier) { tier = tt; have_tier = true; }
+    bool inter = false;
+    for (auto& m : mem) if (regs.count(m)) { inter = true; break; }
+    if (tt != tier || inter || rows.size() + body.size() > cap) continue;
+    rows.insert(rows.end(), body.begin(), body.end());
+    regs.insert(mem.begin(), mem.end());
+    chosen.push_back({r[cc], to_double(r[cg]), rows.size()});
+  }
+  for (int k = 2; k <= std::min<int>(K, (int) chosen.size()); ++k) {
+    size_t n = chosen[k - 1].n;
+    std::string s = head + "\n";
+    for (size_t i = 0; i < n; ++i) s += rows[i] + "\n";
+    write_text(join_path(out, "plan_k" + std::to_string(k) + ".tsv"), s);
+  }
+  J j = J::Obj();
+  j.set("rule", J::S("multi-hub prefixes (disjoint, same hub tier, meas_gain > 1 ps, <= 16 rows)"));
+  J ch = J::Arr();
+  for (auto& c : chosen) { J e = J::Arr(); e.push(J::S(c.cid)); e.push(J::D(c.gain)); e.push(J::I((long long) c.n)); ch.push(e); }
+  j.set("chosen", ch);
+  j.set("tier", have_tier ? J::I(tier) : J::Null());
+  write_text(join_path(out, "prefixes.json"), j.dump(1));
+}
+
+}  // namespace cts::early
