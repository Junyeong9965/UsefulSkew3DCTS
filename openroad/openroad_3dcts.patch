+void HTreeBuilder::insertRealizabilityGuards()
+{
+  // 1) Median sink input cap over this clock tree.
+  std::vector<float> caps;
+  clock_.forEachSink([&](const ClockInst& sink) {
+    if (sink.getInputCap() > 0.0f) {
+      caps.push_back(sink.getInputCap());
+    }
+  });
+  if (caps.size() < 2) {
+    return;
+  }
+  std::sort(caps.begin(), caps.end());
+  const float medianCap = caps[caps.size() / 2];
+  // Heavy pins only: >= 10x the median and >= 5 fF (input caps are in farads).
+  const float threshold = std::max(10.0f * medianCap, 5e-15f);
+
+  // 2) Collect the heavy sinks of every subnet (the subnet list cannot change
+  //    while it is iterated).
+  struct GuardTask
+  {
+    ClockSubNet* net;
+    ClockInst* sink;
+  };
+  std::vector<GuardTask> tasks;
+  clock_.forEachSubNet([&](ClockSubNet& subNet) {
+    if (subNet.getName().find("rguard") != std::string::npos) {
+      return;
+    }
+    subNet.forEachSink([&](ClockInst* sink) {
+      if (sink == nullptr || sink->isClockBuffer()) {
+        return;
+      }
+      if (sink->getInputCap() > threshold
+          && rguardDone_.find(sink) == rguardDone_.end()) {
+        tasks.push_back({&subNet, sink});
+      }
+    });
+  });
+  const float maxCap = caps.back();
+  logger_->info(CTS,
+                720,
+                "Realizability guard survey: {} sinks, median={:.2f}fF "
+                "max={:.2f}fF threshold={:.2f}fF -> {} heavy sink(s).",
+                static_cast<int>(caps.size()),
+                medianCap * 1e15,
+                maxCap * 1e15,
+                threshold * 1e15,
+                static_cast<int>(tasks.size()));
+  if (tasks.empty()) {
+    return;
+  }
+
+  // 3) Rewire every heavy sink behind a guard buffer at the sink location.
+  const std::string rootBufMaster = options_->getRootBuffer();
+  int made = 0;
+  for (auto& t : tasks) {
+    ClockInst* sink = t.sink;
+    // Buffer of the sink's tier (stored tier, else the tier of its instance).
+    int sinkTier = sink->getTier();
+    if (sinkTier < 0 && cts3dDb_ != nullptr
+        && sink->getDbInputPin() != nullptr) {
+      sinkTier = cts3dDb_->getInstTier(sink->getDbInputPin()->getInst());
+    }
+    std::string master = rootBufMaster;
+    if (cts3dDb_ != nullptr && sinkTier >= 0) {
+      master = cts3dDb_->getBufferForTier(rootBufMaster, sinkTier);
+    }
+    // legalizeOneBuffer snaps off macro blockages and resolves collisions
+    // (detailed placement legalizes onto rows later).
+    Point<double> rawLoc(static_cast<double>(sink->getX()) / wireSegmentUnit_,
+                         static_cast<double>(sink->getY()) / wireSegmentUnit_);
+    Point<double> legalLoc = legalizeOneBuffer(rawLoc, master);
+    const int gx = static_cast<int>(legalLoc.getX() * wireSegmentUnit_);
+    const int gy = static_cast<int>(legalLoc.getY() * wireSegmentUnit_);
+
+    std::string cn = clock_.getName();
+    std::replace(cn.begin(), cn.end(), '/', '_');
+    std::replace(cn.begin(), cn.end(), ':', '_');
+    const std::string bufName
+        = "clkbuf_rguard_" + cn + "_" + std::to_string(rguardCount_);
+    ClockInst& guard = clock_.addClockBuffer(bufName, master, gx, gy);
+    if (cts3dDb_ != nullptr && sinkTier >= 0) {
+      cts3dDb_->setClockInstTier(guard, sinkTier);
+    }
+    addTreeLevelBuffer(&guard);
+
+    // Distance of the original driver and of the guard to the sink (log).
+    ClockInst* origDriver = t.net->getDriver();
+    const long odx
+        = origDriver ? std::labs((long) origDriver->getX() - sink->getX()) : -1;
+    const long ody
+        = origDriver ? std::labs((long) origDriver->getY() - sink->getY()) : -1;
+    const long gdx = std::labs((long) gx - sink->getX());
+    const long gdy = std::labs((long) gy - sink->getY());
+
+    // The leaf net now drives the guard; the guard drives the heavy sink.
+    t.net->replaceSink(sink, &guard);
+    ClockSubNet& gNet = clock_.addSubNet("clknet_rguard_" + cn + "_"
+                                         + std::to_string(rguardCount_));
+    gNet.addInst(guard);
+    gNet.addInst(*sink);
+    gNet.setLeafLevel(true);
+    rguardDone_.insert(sink);
+    rguardCount_++;
+    made++;
+
+    // Check that the guard replaced the sink in the original net.
+    bool replaced = false;
+    try {
+      t.net->findIndex(&guard);  // throws if the guard is not in the net
+      replaced = true;
+      t.net->findIndex(sink);    // throws when the sink was removed
+      replaced = false;
+    } catch (const std::out_of_range&) {
+      // Thrown by the second lookup when the sink was removed.
+    }
+    logger_->info(CTS,
+                  721,
+                  "  rguard {} [{}] tier={} at ({},{}): sink {} cap={:.2f}fF "
+                  "(median {:.2f}fF) origDriver_dist=({}, {}) dbu -> "
+                  "stub_dist=({}, {}) dbu, net={}, replaced={}",
+                  bufName,
+                  master,
+                  sinkTier,
+                  gx,
+                  gy,
+                  sink->getName(),
+                  sink->getInputCap() * 1e15,
+                  medianCap * 1e15,
+                  odx,
+                  ody,
+                  gdx,
+                  gdy,
+                  t.net->getName(),
+                  replaced ? 1 : 0);
+  }
+  logger_->info(CTS,
+                722,
+                "Realizability guard: {} high-cap sinks isolated behind "
+                "dedicated guard buffers placed at the sink (threshold "
+                "{:.2f}fF = max(10x median, 5fF)).",
+                made,
+                threshold * 1e15);
 }
 
