diff --git a/src/dpl/src/TierLegalize.h b/src/dpl/src/TierLegalize.h
new file mode 100644
index 0000000000..21c9684f4b
--- /dev/null
+++ b/src/dpl/src/TierLegalize.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2019-2025, The OpenROAD Authors
+//
+// Tier-exact placement legalization and checking for face-to-face two-tier
+// designs (the tier of an instance is given by its master name).
+//
+//   DPL_TIER_ONLY=<0|1>  import only instances of that tier (plus instances
+//                        without a tier suffix); COVER standard-cell masters of
+//                        that tier are treated as CORE for the command and
+//                        restored afterwards (RAII, also on error).
+//                        Legalization and checking are then single-tier
+//                        operations: same-tier overlaps are illegal, cells of
+//                        the other tier are invisible (same XY allowed).
+#pragma once
+
+namespace odb {
+class dbMaster;
+}
+
+namespace dpl::tier {
+
+// tier from the master name: "*bottom*" -> 0, "*upper*" -> 1, otherwise -1
+int tierOfMasterName(const char* name);
+// DPL_TIER_ONLY from the environment (-1 when unset or invalid)
+int envTierOnly();
+// currently selected tier of this command (-1 = all tiers)
+int tierOnly();
+void setTierOnly(int tier);
+// COVER -> CORE for the duration of the current command, standard cells
+// (master with a SITE) only; no-op for other types and for COVER macros; each
+// master saved once
+void promoteCoverMaster(odb::dbMaster* master);
+void restoreMasterTypes();
+
+// Restores the promoted master types and the tier selection when the command
+// scope ends (normal exit or error).
+struct CommandScope
+{
+  CommandScope() = default;
+  CommandScope(const CommandScope&) = delete;
+  CommandScope& operator=(const CommandScope&) = delete;
+  ~CommandScope()
+  {
+    restoreMasterTypes();
+    setTierOnly(-1);
+  }
+};
+
+}  // namespace dpl::tier
