+  }
+  // nearest free, site-aligned span of width w for `inst` (its own span is ignored)
+  auto findSite = [&](odb::dbInst* inst, int w, int h, int tier, int& bx, int& by, odb::dbOrientType& bo) {
+    int ix, iy;
+    inst->getLocation(ix, iy);
+    long best = -1;
+    for (const Row& r : rows) {
+      if (r.y1 - r.y0 != h || std::abs(r.y0 - iy) > resizeRadius) continue;
+      std::vector<std::pair<int, int>> blk;
+      auto it = occ.find(r.y0);
+      if (it != occ.end()) {
+        for (const Seg& s : it->second) {
+          if (s.inst != inst && (s.tier < 0 || tier < 0 || s.tier == tier)) blk.push_back({s.x0, s.x1});
+        }
+      }
+      std::sort(blk.begin(), blk.end());
+      blk.push_back({r.x1, r.x1});
