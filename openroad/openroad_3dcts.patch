+  const double maxSec = envD("CTS_REFINE_MAX_SEC", kDefaultMaxSec);
+  const double maxSetupPerHold
+      = envD("CTS_REFINE_MAX_SETUP_PER_HOLD", kDefaultMaxSetupPerHold);
