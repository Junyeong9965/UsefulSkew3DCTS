+std::string file_key(const std::string& p)
+{
+  struct stat st;
+  if (::stat(p.c_str(), &st) != 0) fail("cannot stat " + p);
+  return std::to_string((long long) st.st_size) + ":" + std::to_string((long long) st.st_mtime) + ":" + std::to_string((long long) st.st_mtim.tv_nsec);
+}
