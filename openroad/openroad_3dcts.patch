+
+namespace cts::early {
+
+namespace {
+constexpr double W_E = 1.0, W_X = 10.0;   // weights of HPWL (um) and of the tier-crossing proxy
+constexpr int KNN = 8;
+constexpr double BUDGET = 1800.0;         // time budget of one search (s)
+constexpr double FC_STRESS = 2.0;         // front-cover margin M = FC_STRESS * k_hub * n_hubs
+
+struct Cl
+{
+  int id = 0;
+  std::vector<int> mem;
+  int n = 0, n1 = 0;
+  double sx = 0, sy = 0, x0 = 0, x1 = 0, y0 = 0, y1 = 0;
+  std::string dom;
+  double gain = 0;
+  bool ok = false;
+  int tier = 0;
+  bool cover = false;
+};
+
+// evaluation summary of a cluster list; summ_json rounds st/sw/ht/hw/hp/phi with scaled (rint) rounding and x with
+// decimal rounding
+struct Summ { double st, sw, ht, hw, hp, x, phi; int nh; };
+J summ_json(const Summ& s)
+{
+  J j = J::Obj();
+  j.set("st", J::D(np_round(s.st, 2))); j.set("sw", J::D(np_round(s.sw, 2))); j.set("ht", J::D(np_round(s.ht, 2)));
+  j.set("hw", J::D(np_round(s.hw, 2))); j.set("hp", J::D(np_round(s.hp, 2))); j.set("x", J::D(py_round(s.x, 2)));
+  j.set("phi", J::D(np_round(s.phi, 2))); j.set("nh", J::I(s.nh));
+  return j;
+}
+struct BudgetExhausted : std::runtime_error { using std::runtime_error::runtime_error; };
+
+double secs_since(std::chrono::steady_clock::time_point t) { return std::chrono::duration<double>(std::chrono::steady_clock::now() - t).count(); }
+
+void copy_file(const std::string& a, const std::string& b) { write_text(b, read_text(a)); }
+}  // namespace
+
+std::string early_groups(const std::string& ref, const std::string& plat, const std::string& des, const std::string& dumprep,
+                         const std::string& calibf, const std::string& outdir, const std::string& fixed_regs,
+                         const std::string& hbt_nets, const std::string& setrc, const std::string& tier_only)
+{
+  auto T0 = std::chrono::steady_clock::now();
+  mkdirs(outdir);
+  std::vector<std::pair<std::string, double>> TM;
+  const char* PLAN_HDR = "gid\tmode\tmaster\tx\ty\tparent_driver\tleaf\tmembers\n";
+  auto finish_early = [&](const std::string& status, const std::string& why) {
+    write_text(join_path(outdir, "plan.tsv"), PLAN_HDR);
+    J j = J::Obj();
+    j.set("mode", J::S("ACC")); j.set("realize", J::S("new")); j.set("status", J::S(status)); j.set("reason", J::S(why));
+    j.set("selected", J::I(0)); j.set("advanced_registers", J::I(0)); j.set("runtime_s", J::D(py_round(secs_since(T0), 2)));
+    write_text(join_path(outdir, "summary.json"), j.dump(1));
+    std::printf("%s %s\n", status.c_str(), why.c_str());
+    return status;
+  };
+  J cal = json_load(calibf);
+  const J& fitj = cal.get("fit");
+  {
+    bool any = false;
+    for (auto& kv : fitj.o) { const J* v = kv.second.find("valid"); if (!v || v->b) any = true; }
+    if (!any) return finish_early("model_invalid", "no tier has a valid hold-out model (calibration)");
+  }
+  Replay R = load_replay(ref, plat, des, dumprep, cal, fixed_regs);
+  const int P = R.P, F = R.F, G = R.G;
+  const std::vector<double>& X = R.X;
+  const std::vector<double>& Y = R.Y;
+  const std::vector<int>& TI = R.TI;
+  const std::vector<std::string>& DOM = R.DOM;
+  const std::vector<double>& tgt = R.tgt;
+  const double b_sw = R.b_sw, b_hw = R.b_hw;
+  TM.emplace_back("load_s", py_round(secs_since(T0), 2));
+  // calibration model
+  struct Fit { double a, b, c, d; };
+  std::map<int, Fit> fit;
+  std::map<int, bool> VALID;
+  for (auto& kv : fitj.o) {
+    int t = (int) to_int(kv.first);
+    const J& v = kv.second;
+    fit[t] = {v.get("a").num(), v.get("b").num(), v.get("c").num(), v.has("d") ? v.get("d").num() : 0.0};
+    const J* vd = v.find("valid");
+    VALID[t] = !vd || vd->b;
+  }
+  const J& NM = cal.get("nonmember");
+  const double k_per_hub = NM.get("k_per_hub").num(), u_per_removed_leaf = NM.get("u_per_removed_leaf").num();
+  if (!tier_only.empty() && tier_only != "all") {
+    int only = (int) to_int(tier_only);
+    for (auto& kv : VALID) kv.second = kv.second && kv.first == only;
+  }
+  int nvalid = 0;
+  for (auto& kv : VALID) if (kv.second) ++nvalid;
+  if (tier_only.empty() && nvalid >= 2) {
+    // tier search: joint search + one search per valid tier, best final phi among guard-passing searches
+    std::vector<std::string> runs{"all"};
+    for (auto& kv : VALID) if (kv.second) runs.push_back(std::to_string(kv.first));
+    std::vector<std::pair<std::string, J>> res;
+    std::map<std::string, std::string> sdir;
+    for (auto& r_ : runs) {
+      std::string sd = join_path(outdir, "search_" + (r_ == "all" ? std::string("all") : "t" + r_));
+      early_groups(ref, plat, des, dumprep, calibf, sd, fixed_regs, hbt_nets, setrc, r_);
+      res.emplace_back(r_, json_load(join_path(sd, "summary.json")));
+      sdir[r_] = sd;
+    }
+    std::string win = "all";
+    bool have = false;
+    double best_phi = 0;
+    bool best_all = false;
+    for (auto& rv : res) {
+      const J& s = rv.second;
+      const J* st = s.find("status");
+      const J* gp = s.find("guard_pass");
+      const J* se = s.find("selected");
+      bool ok = st && st->t == J::STR && st->s == "selected" && gp && gp->t == J::BOOL && gp->b && se && se->num() > 0;
+      if (!ok) continue;
+      double phi = s.get("final").get("phi").num();
+      bool is_all = rv.first == "all";
+      if (!have || phi > best_phi || (phi == best_phi && is_all && !best_all)) { have = true; best_phi = phi; best_all = is_all; win = rv.first; }
+    }
+    std::string wd = sdir[win];
+    if (DIR* dir = opendir(wd.c_str())) {
+      std::vector<std::string> names;
+      while (dirent* e = readdir(dir)) { std::string n = e->d_name; if (n != "." && n != "..") names.push_back(n); }
+      closedir(dir);
+      for (auto& fn : names) {
+        struct stat st;
+        std::string p = join_path(wd, fn);
+        if (stat(p.c_str(), &st) == 0 && S_ISREG(st.st_mode)) copy_file(p, join_path(outdir, fn));
+      }
+    }
+    J sm = json_load(join_path(outdir, "summary.json"));
+    J ts = J::Obj();
+    ts.set("rule", J::S("best final phi among guard-passing searches; ties -> all"));
+    ts.set("winner", J::S(win));
+    J searches = J::Obj();
+    for (auto& rv : res) {
+      J e = J::Obj();
+      const J& s = rv.second;
+      e.set("status", s.find("status") ? *s.find("status") : J::Null());
+      e.set("selected", s.find("selected") ? *s.find("selected") : J::Null());
+      e.set("guard_pass", s.find("guard_pass") ? *s.find("guard_pass") : J::Null());
+      e.set("final", s.find("final") ? *s.find("final") : J::Null());
+      searches.set(rv.first, e);
+    }
+    ts.set("searches", searches);
+    sm.set("tier_search", ts);
+    write_text(join_path(outdir, "summary.json"), sm.dump(1));
+    std::printf("TIER_SEARCH winner %s\n", win.c_str());
+    return sm.get("status").s;
+  }
+  const int N_CAP = cal.has("n_cap") ? (int) cal.get("n_cap").num() : 16;
+  std::vector<double> BASE_I(P);
+  for (int i = 0; i < P; ++i) BASE_I[i] = R.rout - R.BOUT[R.sbr[i]];
+  HBT HBTM(dumprep, hbt_nets, read_r_hbt(setrc), R.pins, TI, X, Y, R.CAP, R.root);
+  std::map<int, std::string> masters;
+  for (auto& l : R.tree.order) if (starts_with(l, "clkbuf_leaf_")) masters.emplace(R.tree.rows[l].tier, R.tree.rows[l].master);
+  HBTM.set_leaf_masters(masters);
+  auto mterm = [&](int t, double dist_um, double n) { const Fit& f = fit.at(t); return f.a + f.b * n + f.c * dist_um + f.d * py_pow(dist_um, 2.0); };
+  auto ctier = [](int n, int n1, int tie) { return 2 * n1 > n ? 1 : (2 * n1 < n ? 0 : tie); };
+  auto valid = [&](int t) { auto it = VALID.find(t); return it != VALID.end() && it->second; };
+  auto adm_tier = [&](int n, int n1) { int t = ctier(n, n1, 0); if (!valid(t) && valid(1 - t)) return 1 - t; return t; };
+  auto xcost = [](int n, int n1, int tier) { int off = tier == 1 ? (n - n1) : n1; return (off ? 1.0 : 0.0) + 0.1 * (double) off; };
+  auto hpwl = [](const Cl& c) { return ((c.x1 - c.x0) + (c.y1 - c.y0)) / 1000.0; };
+  auto hp_of = [&](const std::vector<int>& m) {
+    double xmin = X[m[0]], xmax = X[m[0]], ymin = Y[m[0]], ymax = Y[m[0]];
+    for (int i : m) { xmin = std::min(xmin, X[i]); xmax = std::max(xmax, X[i]); ymin = std::min(ymin, Y[i]); ymax = std::max(ymax, Y[i]); }
+    return ((xmax - xmin) + (ymax - ymin)) / 1000.0;
+  };
+  std::vector<int> VALID_T;
+  for (int t : {0, 1}) if (valid(t)) VALID_T.push_back(t);
+  auto cl_eval = [&](Cl& c) {
+    double dist = (std::fabs(c.sx / c.n - (double) R.rx) + std::fabs(c.sy / c.n - (double) R.ry)) / 1000.0;
+    if (!valid(c.tier)) { c.gain = 0.0; c.ok = false; return; }
+    std::vector<double> hx = HBTM.member_delta(c.mem, c.tier, py_int(c.sx / c.n), py_int(c.sy / c.n), {c.tier});
+    std::vector<double> x(c.mem.size());
+    double mt = mterm(c.tier, dist, N_CAP / 2.0);
+    for (size_t j = 0; j < c.mem.size(); ++j) x[j] = BASE_I[c.mem[j]] + mt - tgt[c.mem[j]] + hx[j];
+    auto g = R.cgain(c.mem, x);
+    c.gain = g.first; c.ok = g.second;
+  };
+  int NID = 0;
+  auto mk = [&](const std::vector<int>& mem, int tie = 0) {
+    Cl c;
+    c.id = NID++;
+    c.mem = mem; c.n = (int) mem.size();
+    long long n1 = 0;
+    for (int i : mem) n1 += TI[i];
+    c.n1 = (int) n1;
+    std::vector<double> xs, ys;
