+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2019-2025, The OpenROAD Authors
+//
+// Sequential timing graph extraction for skew scheduling.
+//
+// Registers (sequential Liberty cells) and clocked macros are collected from
+// ODB.  For every launch register one OpenSTA findPathEnds query returns the
+// constrained path ends of that launch; each end at another register becomes a
+// register -> register edge with its worst setup and hold slack.  IO edges
+// (input port -> register, register -> output port) are extracted with one
+// query per input port and per launch register.  Only native constrained path
+// ends are admitted; ends with unsupported relations (latch borrowing, gated
+// clock / data checks, path-delay exceptions, missing clock edges) are
+// recorded and mark the graph BLOCKED (admission status files).
+
+#pragma once
+
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace odb {
+class dbBlock;
+class dbInst;
+}  // namespace odb
+
+namespace sta {
+class dbSta;
+class dbNetwork;
+}  // namespace sta
+
+namespace utl {
+class Logger;
+}
+
+namespace cts {
+
+class Cts3DDatabase;
+
+// IO edge (input port -> register or register -> output port) with the worst
+// setup and hold slack of the pair.
+struct IOEdge
+{
+  std::string edge_type;  // "PI_TO_FF" or "FF_TO_PO"
+  std::string port_name;
+  std::string ff_name;
+  float slack_setup_ns = 0.0f;
+  float slack_hold_ns = 0.0f;
+  bool has_setup = false;
+  bool has_hold = false;
+  std::string ff_clock_net;  // root clock net of the register
+};
+
+// Register -> register edge with the worst setup and hold path.
+struct FFEdge
+{
+  std::string from_ff;
+  std::string to_ff;
+
+  int from_x = 0;
+  int from_y = 0;
+  int from_tier = 0;
+  int to_x = 0;
+  int to_y = 0;
+  int to_tier = 0;
+
+  // Setup (max path)
+  float slack_max = 0.0f;
+  float arrival_max = 0.0f;
+  float required_max = 0.0f;
+  // Hold (min path)
+  float slack_min = 0.0f;
+  float arrival_min = 0.0f;
+  float required_min = 0.0f;
+  bool has_timing = false;  // setup corner measured
+  bool has_hold = false;    // hold corner measured
+  // Root clock net of each endpoint register.
+  std::string from_clock_net;
+  std::string to_clock_net;
+};
+
+class TimingGraphExtractor
+{
+ public:
+  TimingGraphExtractor(odb::dbBlock* block,
+                       sta::dbSta* sta,
+                       sta::dbNetwork* network,
+                       utl::Logger* logger);
+
+  void setCts3DDatabase(Cts3DDatabase* db3d) { cts3dDb_ = db3d; }
+
+  // Collect sequential instances and placed clocked macros from ODB.
+  void collectRegisters();
+
+  // Register -> register edges (one query per launch register).
+  std::vector<FFEdge> extractRegisterEdges();
+
+  // Input port -> register and register -> output port edges.
+  std::vector<IOEdge> extractIOEdges();
+
+  void writeCSV(const std::vector<FFEdge>& edges,
+                const std::string& output_file);
+  void writeIOCSV(const std::vector<IOEdge>& edges,
+                  const std::string& output_file);
+
+ private:
+  // Root clock net of a register: walk back through single-input cells up to
+  // a port-driven net or a multi-input cell (e.g. a clock gater).
+  std::string traceClockNetRoot(odb::dbInst* ff_inst) const;
+
+  odb::dbBlock* block_;
+  sta::dbSta* sta_;
+  sta::dbNetwork* network_;
+  utl::Logger* logger_;
+  Cts3DDatabase* cts3dDb_ = nullptr;
+
+  // Register universe: instance name -> instance.
+  std::unordered_map<std::string, odb::dbInst*> odb_registers_;
+};
+
+}  // namespace cts
