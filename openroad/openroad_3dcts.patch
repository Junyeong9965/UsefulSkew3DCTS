+//
+///////////////////////////////////////////////////////////////////////////////
+// Candidate evaluation helper of the clock-tree refinement (ClockRefinement.cpp).
+//
+// One evaluation = placement parasitics + timing update + design metrics.
+//  * Incremental parasitics: after the first whole-design estimation only the
+//    nets whose pin set or pin locations changed are re-estimated
+//    (est::EstimateParasitics::updateParasitics, as used by the resizer);
+//    OpenSTA then updates timing incrementally from those nets.  Edited nets:
+//      bypass     : output net of the buffer (loses every load), input net
+//      sink move  : source net, destination net
+//      resize     : every net on a pin of the resized instance (the pin
+//                   positions move with the footprint / new location);
+//                   pin remap: the two nets of the replaced instance
+//    Nets up- and downstream are not re-estimated: their Steiner trees and
+//    pi/Elmore models depend only on their own pins; the load change reaches
+//    them through the delay calculation.
+//  * Fast read-out (same STA state): max-slew/cap/fanout violator counts are
+//    kept per net and recounted only for edited nets and nets with a pin whose
+//    slew changed (bitwise compare with a per-vertex snapshot); top-level ports
+//    are recounted every time.  Data-pin slacks of an endpoint without fan-out
+//    are read from the path requireds refreshed by the TNS query.
+// The final state check of the refinement always uses a whole-design
+// estimation and the full read-out.
+//
+// OpenSTA stops incremental propagation when a slew/arrival changes by less
+// than 1e-6 relative (fuzzyEqual), so an incremental and a whole-design
+// evaluation of the same circuit can differ in the last digits.
+///////////////////////////////////////////////////////////////////////////////
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <limits>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "db_sta/dbNetwork.hh"
+#include "db_sta/dbSta.hh"
+#include "est/EstimateParasitics.h"
+#include "odb/db.h"
+#include "sta/Corner.hh"
+#include "sta/Delay.hh"
+#include "sta/Fuzzy.hh"
+#include "sta/Graph.hh"
+#include "sta/Liberty.hh"
+#include "sta/MinMax.hh"
+#include "sta/Network.hh"
+#include "sta/Path.hh"
+#include "sta/Sdc.hh"
+#include "sta/Search.hh"
+#include "sta/SearchPred.hh"
+#include "sta/Transition.hh"
+#include "utl/Logger.h"
+
+namespace cts {
+namespace sel {
+
+using Clock = std::chrono::steady_clock;
+
+struct Timers
+{
+  double rcFull = 0, rcIncr = 0, staFirst = 0, staRest = 0, limits = 0;
+  double scanArr = 0, scanSlack = 0, reqOnce = 0;
+  int nFull = 0, nIncr = 0;
+  long touchedNets = 0, slewDirtyNets = 0, limitNets = 0;
+};
+
+class Eval
+{
+ public:
+  Eval(odb::dbDatabase* db,
+       sta::dbSta* sta,
+       sta::dbNetwork* network,
+       est::EstimateParasitics* est,
+       utl::Logger* logger,
+       const std::string& resultsDir,
+       const std::string& prefix)
+      : sta_(sta), network_(network), est_(est), logger_(logger)
+  {
+    block_ = db->getChip()->getBlock();
+    if (prefix.empty()) {  // no per-evaluation log (stage Q)
+      return;
+    }
+    evalCsv_.open(resultsDir + "/" + prefix + "_evals.csv");
+    evalCsv_ << "eval,label,rc_mode,touched_nets,slew_dirty_nets,limit_nets,"
+                "rc_s,sta_first_query_s,requireds_once_s,tns_wns_rest_s,"
+                "limits_s,scan_arrival_s,scan_slack_s\n";
+  }
+  static double since(Clock::time_point a)
+  {
+    return std::chrono::duration<double>(Clock::now() - a).count();
+  }
+
+  Timers t;
+
+  // ---------------- edit notifications ----------------
+  void touchNet(odb::dbNet* net)
+  {
+    if (net != nullptr) {
+      touched_.insert(net);
+      limDirty_.insert(net);
+    }
+  }
+  void touchInst(odb::dbInst* inst)  // master / location / orientation change
+  {
+    for (odb::dbITerm* it : inst->getITerms()) {
+      if (!it->getSigType().isSupply()) {
+        touchNet(it->getNet());
+      }
+    }
+  }
+
+  // ---------------- parasitics ----------------
+  void rc(bool forceFull)
+  {
+    const auto a = Clock::now();
+    if (!haveFull_ || forceFull) {
+      est_->estimateParasitics(est::ParasiticsSrc::placement);
+      haveFull_ = true;
+      if (!est_->isIncrementalParasiticsEnabled()) {
+        est_->setIncrementalParasiticsEnabled(true);
+        enabledHere_ = true;
+      }
+      t.rcFull += since(a);
+      ++t.nFull;
+      lastMode_ = "full";
+    } else {
+      // Explicit invalidation set (the ODB callbacks of est report the
+      // connect/disconnect/swapMaster nets; instance moves are only known
+      // here).
+      for (odb::dbNet* net : touched_) {
+        est_->parasiticsInvalid(net);
+      }
+      est_->updateParasitics();
+      t.rcIncr += since(a);
+      ++t.nIncr;
+      lastMode_ = "incr";
+    }
+    lastTouched_ = touched_.size();
+    t.touchedNets += lastTouched_;
+    touched_.clear();
+  }
+  void finish()
+  {
+    if (enabledHere_) {
+      est_->setIncrementalParasiticsEnabled(false);
+      enabledHere_ = false;
+    }
+  }
+
+  // ---------------- design metrics ----------------
+  // full = each query on its own; otherwise the required times are
+  // propagated once after the first TNS query.
+  void tnsWns(double& st, double& sw, double& ht, double& hw, bool full)
+  {
+    const double PS = 1e12;
+    auto a = Clock::now();
+    st = sta_->totalNegativeSlack(sta::MinMax::max()) * PS;
+    t.staFirst += since(a);
+    a = Clock::now();
+    if (!full) {
+      // Propagate the required times once for the whole design: the three
+      // remaining queries would otherwise re-scan the invalid-required set
+      // each, and Sta::pinSlack of a non-endpoint data pin would trigger the
+      // same back-propagation.
+      sta_->findRequireds();
+      t.reqOnce += since(a);
+      a = Clock::now();
+    }
+    ht = sta_->totalNegativeSlack(sta::MinMax::min()) * PS;
+    sw = sta_->worstSlack(sta::MinMax::max()) * PS;
+    hw = sta_->worstSlack(sta::MinMax::min()) * PS;
+    t.staRest += since(a);
+  }
+
+  // ---------------- violator counts ----------------
+  void limitsFull(int& slew, int& cap, int& fo)
+  {
+    const sta::Corner* corner = sta_->cmdCorner();
+    slew = static_cast<int>(
+        sta_->checkSlewLimits(nullptr, true, corner, sta::MinMax::max()).size());
+    cap = static_cast<int>(
+        sta_->checkCapacitanceLimits(nullptr, true, corner, sta::MinMax::max()).size());
+    fo = static_cast<int>(sta_->checkFanoutLimits(nullptr, true, sta::MinMax::max()).size());
+  }
+  void limits(int& slew, int& cap, int& fo, bool full)
+  {
+    const auto a = Clock::now();
+    if (full || limBroken_) {
+      limitsFull(slew, cap, fo);
+    } else if (!limInit_) {
+      limitsFull(slew, cap, fo);
+      initLimits(slew, cap, fo);
+    } else {
+      fastLimits(slew, cap, fo);
+    }
+    t.limits += since(a);
+  }
+
+  // ---------------- per-pin read-out ----------------
+  // Data-pin slacks (hold, setup) in ps; |slack| > 1 ms reads as 1e9.
+  void pinSlacks(sta::Pin* pin, bool full, double& hold, double& setup)
+  {
+    auto conv = [](float s) {
+      return (!std::isfinite(s) || std::abs(s) > 1e-3) ? 1e9 : static_cast<double>(s) * 1e12;
+    };
+    if (!full) {
+      sta::Vertex* v = nullptr;
+      sta::Vertex* bv = nullptr;
+      sta_->graph()->pinVertices(pin, v, bv);
+      sta::Search* search = sta_->search();
+      // Endpoint without fan-out: Sta::vertexSlack would re-seed the endpoint
+      // required times (already refreshed by the TNS query of this
+      // evaluation) and then take the minimum path slack per mode.
+      if (v != nullptr && bv == nullptr && search->isEndpoint(v)
+          && !sta::hasFanout(v, search->searchAdj(), sta_->graph())) {
+        sta::Slack smin = sta::MinMax::min()->initValue();
+        sta::Slack smax = sta::MinMax::min()->initValue();
+        sta::VertexPathIterator it(v, sta_);
+        while (it.hasNext()) {
+          sta::Path* p = it.next();
+          const sta::Slack s = p->slack(sta_);
+          if (p->minMax(sta_) == sta::MinMax::min()) {
+            if (sta::delayLess(s, smin, sta_)) {
+              smin = s;
+            }
+          } else if (sta::delayLess(s, smax, sta_)) {
+            smax = s;
+          }
+        }
+        hold = conv(sta::delayAsFloat(smin));
+        setup = conv(sta::delayAsFloat(smax));
+        return;
+      }
+    }
+    hold = conv(sta::delayAsFloat(sta_->pinSlack(pin, sta::MinMax::min())));
+    setup = conv(sta::delayAsFloat(sta_->pinSlack(pin, sta::MinMax::max())));
+  }
+  // ---------------- per-evaluation log ----------------
+  void beginEval(const std::string& label)
+  {
+    label_ = label;
+    t0_ = t;
+  }
+  void endEval()
+  {
+    ++evalId_;
+    if (evalCsv_.is_open()) {
+      evalCsv_ << evalId_ << ',' << label_ << ',' << lastMode_ << ',' << lastTouched_ << ','
+               << (t.slewDirtyNets - t0_.slewDirtyNets) << ','
+               << (t.limitNets - t0_.limitNets) << ','
+               << (t.rcFull + t.rcIncr - t0_.rcFull - t0_.rcIncr) << ','
+               << (t.staFirst - t0_.staFirst) << ',' << (t.reqOnce - t0_.reqOnce) << ','
+               << (t.staRest - t0_.staRest) << ',' << (t.limits - t0_.limits) << ',' << (t.scanArr - t0_.scanArr) << ','
+               << (t.scanSlack - t0_.scanSlack) << '\n';
+      evalCsv_.flush();
+    }
+  }
+  int evalId() const { return evalId_; }
+  size_t lastTouched() const { return lastTouched_; }
+
+ private:
+  // ----- fast violator counts -----
