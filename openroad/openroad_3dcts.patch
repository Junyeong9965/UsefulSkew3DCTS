+// Liberty stage delay of a buffer master at an arbitrary load, used by the
+// load-aware tap depth assignment (HTreeBuilder, CTS_LOAD_AWARE_TAPS=1).  Same
+// NLDM query as the charBuf delay above (command corner, max analysis point,
+// pocv off); returns the maximum over the buffer's rise/fall arcs in ps and the
+// matching output slew in seconds, or -1 when the master or its Liberty arcs
+// are not found.
+double TechChar::bufStageDelayPs(const std::string& master,
+                                 double loadF,
+                                 double slewInS,
+                                 double* slewOutS) const
+{
+  odb::dbMaster* m = db_->findMaster(master.c_str());
+  if (m == nullptr) {
+    return -1.0;
+  }
+  sta::LibertyCell* lc = db_network_->libertyCell(db_network_->dbToSta(m));
+  if (lc == nullptr) {
+    return -1.0;
+  }
+  sta::LibertyPort *in = nullptr, *out = nullptr;
+  lc->bufferPorts(in, out);
+  if (in == nullptr || out == nullptr) {
+    return -1.0;
+  }
+  sta::Corner* corner = openSta_->cmdCorner();
+  const sta::DcalcAnalysisPt* ap = corner->findDcalcAnalysisPt(sta::MinMax::max());
+  const sta::Pvt* pvt = ap->operatingConditions();
+  double best = -1.0, bestSlew = 0.0;
+  for (sta::TimingArcSet* arcSet : lc->timingArcSets(in, out)) {
+    for (sta::TimingArc* arc : arcSet->arcs()) {
+      auto* model = dynamic_cast<sta::GateTimingModel*>(arc->model());
+      if (model == nullptr) {
+        continue;
+      }
+      sta::ArcDelay ad;
+      sta::Slew sl;
+      model->gateDelay(pvt, static_cast<float>(slewInS), static_cast<float>(loadF), false, ad, sl);
+      const double d = static_cast<double>(ad);
+      if (d > best) {
+        best = d;
+        bestSlew = static_cast<double>(sl);
+      }
+    }
+  }
+  if (slewOutS != nullptr) {
+    *slewOutS = bestSlew;
+  }
+  return best < 0 ? -1.0 : best * 1e12;
+}
+
+double TechChar::bufInputCapF(const std::string& master) const
+{
+  odb::dbMaster* m = db_->findMaster(master.c_str());
+  if (m == nullptr) {
+    return 0.0;
+  }
+  sta::LibertyCell* lc = db_network_->libertyCell(db_network_->dbToSta(m));
+  if (lc == nullptr) {
+    return 0.0;
+  }
+  sta::LibertyPort *in = nullptr, *out = nullptr;
+  lc->bufferPorts(in, out);
+  return in != nullptr ? static_cast<double>(in->capacitance()) : 0.0;
+}
+
+// Wider buffers of the same family as 'base' for delay-chain stage sizing.  Same
+// admission rule as the clock refinement resize candidates: Liberty buffer,
+// same family (name with digit runs and a trailing drive 'f' removed), same tier
+// suffix, same signal pin names, width >= base, not matching a dont-use pattern
+// (CTS_REFINE_DONT_USE, else DONT_USE_CELLS).  Sorted by width; 'base' itself
+// is the first element.
+std::vector<std::string> TechChar::bufUpsizeMasters(const std::string& base) const
+{
+  std::vector<std::string> out;
+  odb::dbMaster* bm = db_->findMaster(base.c_str());
+  if (bm == nullptr) {
+    return out;
+  }
+  auto family = [](const std::string& m) {
+    std::string k;
+    for (size_t i = 0; i < m.size(); ++i) {
+      if (std::isdigit(static_cast<unsigned char>(m[i]))) {
+        while (i + 1 < m.size() && std::isdigit(static_cast<unsigned char>(m[i + 1]))) {
+          ++i;
+        }
+        if (i + 1 < m.size() && m[i + 1] == 'f') {
+          ++i;
+        }
+        continue;
+      }
+      k += m[i];
+    }
+    return k;
+  };
+  auto pinSig = [](odb::dbMaster* m) {
+    std::set<std::string> v;
+    for (odb::dbMTerm* t : m->getMTerms()) {
+      if (!t->getSigType().isSupply()) {
+        v.insert(t->getName() + (t->getIoType() == odb::dbIoType::OUTPUT ? ":o" : ":i"));
+      }
+    }
+    return v;
+  };
+  std::vector<std::string> dontUse;
+  {
+    const char* e = std::getenv("DONT_USE_CELLS");
+    std::istringstream du(e != nullptr ? e : "");
+    std::string tok;
+    while (du >> tok) {
+      dontUse.push_back(tok);
+    }
+  }
+  const std::string fam = family(base);
+  const auto sig = pinSig(bm);
+  std::vector<odb::dbMaster*> cand;
+  for (odb::dbLib* lib : db_->getLibs()) {
+    for (odb::dbMaster* m : lib->getMasters()) {
+      sta::LibertyCell* lc = db_network_->libertyCell(db_network_->dbToSta(m));
+      if (lc == nullptr || !lc->isBuffer() || family(m->getName()) != fam
+          || m->getWidth() < bm->getWidth() || m->getHeight() != bm->getHeight()
+          || pinSig(m) != sig) {
+        continue;
+      }
+      bool blocked = false;
+      for (const std::string& g : dontUse) {
+        if (fnmatch(g.c_str(), m->getName().c_str(), 0) == 0) {
+          blocked = true;
+          break;
+        }
+      }
+      if (!blocked || m == bm) {
+        cand.push_back(m);
+      }
+    }
+  }
+  std::sort(cand.begin(), cand.end(), [&](odb::dbMaster* a, odb::dbMaster* b) {
+    if (a == bm || b == bm) {
+      return a == bm && b != bm;
+    }
+    return a->getWidth() != b->getWidth() ? a->getWidth() < b->getWidth()
+                                          : a->getName() < b->getName();
+  });
+  for (odb::dbMaster* m : cand) {
+    out.push_back(m->getName());
+  }
+  return out;
+}
+
 }  // namespace cts
