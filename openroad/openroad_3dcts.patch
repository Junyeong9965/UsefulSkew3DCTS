+
+Replay load_replay(const std::string& ref, const std::string& plat, const std::string& des, const std::string& dump,
+                   const J& cal, const std::string& fixed_regs)
+{
+  Replay R;
+  std::string sub = sub_dir(plat, des);
+  Table lgt = read_table(join_path(ref, "P/" + sub + "/phase1_leaf_groups.csv"));
+  int c_level = lgt.col("level"), c_sink = lgt.col("sink"), c_x = lgt.col("x"), c_y = lgt.col("y"), c_tier = lgt.col("tier"),
+      c_cap = lgt.col("cap_ff"), c_clock = lgt.col("clock"), c_leaf = lgt.col("leaf"), c_chosen = lgt.col("chosen_tier");
+  std::vector<const std::vector<std::string>*> lg;
+  for (auto& r : lgt.rows) if (r[c_level] == "1") lg.push_back(&r);
+  std::stable_sort(lg.begin(), lg.end(), [&](auto* a, auto* b) { return (*a)[c_sink] < (*b)[c_sink]; });
+  R.tree = load_tree(dump, true);
+  R.sk = load_sinks(dump);
+  R.root = cal.get("root").s;
+  R.rx = R.tree.at(R.root).x; R.ry = R.tree.at(R.root).y;
+  R.rout = cal.get("root_out").num();
+  R.P = (int) lg.size();
+  std::unordered_map<std::string, std::string> stock;
+  for (int i = 0; i < R.P; ++i) {
+    auto& r = *lg[i];
+    R.pins.push_back(r[c_sink]); R.pid[r[c_sink]] = i;
+    R.reg.push_back(inst_of(r[c_sink]));
+    R.X.push_back((double) to_int(r[c_x])); R.Y.push_back((double) to_int(r[c_y]));
+    R.TI.push_back((int) to_int(r[c_tier])); R.CAP.push_back(to_double(r[c_cap])); R.DOM.push_back(r[c_clock]);
+    stock[r[c_sink]] = r[c_leaf];
+  }
+  for (int i = 0; i < R.P; ++i) R.rid[R.reg[i]] = i;   // duplicate register names: the last index wins
+  // group order = leaf order of the membership file (sorted by int)
+  {
+    std::set<std::string> leaves;
+    for (auto* r : lg) leaves.insert((*r)[c_leaf]);
+    R.gids.assign(leaves.begin(), leaves.end());
+    std::stable_sort(R.gids.begin(), R.gids.end(), [](const std::string& a, const std::string& b) { return to_int(a) < to_int(b); });
+  }
+  R.G = (int) R.gids.size();
+  std::unordered_map<std::string, int> gix;
+  for (int k = 0; k < R.G; ++k) gix[R.gids[k]] = k;
+  R.chosen.assign(R.G, 0);
+  for (auto* r : lg) R.chosen[gix[(*r)[c_leaf]]] = (int) to_int((*r)[c_chosen]);
+  R.memb0.resize(R.P);
+  for (int i = 0; i < R.P; ++i) R.memb0[i] = gix[stock[R.pins[i]]];
+  const J& bo = cal.get("branch_out");
+  for (auto& kv : bo.o) R.brs.push_back(kv.first);
+  std::sort(R.brs.begin(), R.brs.end());
+  std::unordered_map<std::string, int> bix;
+  for (size_t i = 0; i < R.brs.size(); ++i) { bix[R.brs[i]] = (int) i; R.BOUT.push_back(bo.get(R.brs[i]).num()); }
+  R.gbr.assign(R.G, -1);
+  for (int i = 0; i < R.P; ++i) {
+    int k = R.memb0[i];
+    if (R.gbr[k] < 0 && R.sk.has(R.pins[i])) {
+      const std::string& br = R.tree.at(R.sk.at(R.pins[i]).driver).driver;
+      auto it = bix.find(br);
+      if (it == bix.end()) fail("branch " + br + " not in the calibration");
+      R.gbr[k] = it->second;
+    }
+  }
+  for (int k = 0; k < R.G; ++k) if (R.gbr[k] < 0) fail("stock group without a branch");
+  for (int k = 0; k < R.G; ++k) R.gbt.push_back(R.tree.at(R.brs[R.gbr[k]]).tier);
+  R.sbr.resize(R.P);
+  for (int i = 0; i < R.P; ++i) R.sbr[i] = R.gbr[R.memb0[i]];
+  R.gdom.assign(R.G, "");
+  {
+    std::vector<bool> seen(R.G, false);
+    for (int i = 0; i < R.P; ++i) if (!seen[R.memb0[i]]) { seen[R.memb0[i]] = true; R.gdom[R.memb0[i]] = R.DOM[i]; }
+  }
+  std::vector<std::string> FIXED;
+  if (!fixed_regs.empty())
+    for (auto& l : read_lines(fixed_regs)) { std::string s = strip(l); if (!s.empty()) FIXED.push_back(s); }
+  R.F = (int) FIXED.size();
+  for (int j = 0; j < R.F; ++j) R.rid.emplace(FIXED[j], R.P + j);   // existing entries are kept
+  // every register named by a stored check stays in the replay
+  const Graph& g = *load_graph(join_path(ref, "G/results"));
+  {
+    std::set<std::string> un;
+    for (int a : g.ff_from) if (!R.rid.count(g.names[a])) un.insert(g.names[a]);
+    for (int b : g.ff_to) if (!R.rid.count(g.names[b])) un.insert(g.names[b]);
+    for (int f : g.io_ff) if (!R.rid.count(g.names[f])) un.insert(g.names[f]);
+    R.UNMAPPED.assign(un.begin(), un.end());
+  }
+  R.F_LIST = R.F;
+  R.F = R.F + (int) R.UNMAPPED.size();
+  for (size_t j = 0; j < R.UNMAPPED.size(); ++j) R.rid[R.UNMAPPED[j]] = R.P + R.F_LIST + (int) j;
+  R.tgt_all.assign(R.P + R.F, 0.0);
+  {
+    Table tg = read_table(join_path(ref, "D/" + sub + "/pre_cts_skew_targets.csv"));
+    int cn = tg.col("ff_name"), ct = tg.col("target_arrival_ns");
+    for (auto& r : tg.rows) {
+      auto it = R.rid.find(r[cn]);
+      if (it != R.rid.end()) R.tgt_all[it->second] = to_double(r[ct]) * 1e3;
+    }
+  }
+  R.tgt.assign(R.tgt_all.begin(), R.tgt_all.begin() + R.P);
+  // graph name -> rid
+  std::vector<int> nid(g.names.size());
+  for (size_t k = 0; k < g.names.size(); ++k) {
+    auto it = R.rid.find(g.names[k]);
+    if (it == R.rid.end()) fail("register not in rid: " + g.names[k]);
+    nid[k] = it->second;
+  }
+  std::vector<int64_t> L, C;
+  std::vector<double> S0, H0;
+  for (size_t k = 0; k < g.ff_from.size(); ++k) {
+    L.push_back(nid[g.ff_from[k]]); C.push_back(nid[g.ff_to[k]]);
+    S0.push_back(g.ff_smax[k] * 1e3); H0.push_back(g.ff_smin[k] * 1e3);
+  }
+  std::unordered_map<std::string, int> ports;
+  std::vector<int64_t> PIc, POl, POe;
+  std::vector<double> PIs, PIh, POs, POh;
+  for (size_t k = 0; k < g.io_ff.size(); ++k) {
+    int f = nid[g.io_ff[k]];
+    double s = g.io_ss[k] * 1e3, h = g.io_sh[k] * 1e3;
+    if (g.io_pi[k]) { PIc.push_back(f); PIs.push_back(s); PIh.push_back(h); }
+    else {
+      const std::string& pn = g.ports[g.io_port[k]];
+      auto it = ports.find(pn);
+      if (it == ports.end()) it = ports.emplace(pn, R.P + R.F + (int) ports.size()).first;
+      POl.push_back(f); POe.push_back(it->second); POs.push_back(s); POh.push_back(h);
+    }
+  }
+  R.N_FF_CHECKS = g.ff_from.size(); R.N_IO_ROWS = g.io_ff.size();
+  R.NE = R.P + R.F + (int) ports.size();
+  for (size_t k = 0; k < S0.size(); ++k) { S0[k] = S0[k] + R.tgt_all[C[k]] - R.tgt_all[L[k]]; H0[k] = H0[k] - R.tgt_all[C[k]] + R.tgt_all[L[k]]; }
+  for (size_t k = 0; k < PIc.size(); ++k) { PIs[k] = PIs[k] + R.tgt_all[PIc[k]]; PIh[k] = PIh[k] - R.tgt_all[PIc[k]]; }
+  for (size_t k = 0; k < POl.size(); ++k) { POs[k] = POs[k] - R.tgt_all[POl[k]]; POh[k] = POh[k] + R.tgt_all[POl[k]]; }
+  for (auto v : PIc) R.PIc.push_back((int) v);
+  for (auto v : POl) R.POl.push_back((int) v);
+  for (auto v : POe) R.POe.push_back((int) v);
+  R.PIs = PIs; R.PIh = PIh; R.POs = POs; R.POh = POh;
+  // unified check arrays sorted (stably) by endpoint; Z = "no register"
+  R.NR = R.P + R.F; R.Z = R.NR;
+  size_t n = L.size() + PIc.size() + POe.size();
+  std::vector<int64_t> ep0, cap0, lau0;
+  std::vector<double> bs0, bh0;
+  ep0.reserve(n); cap0.reserve(n); lau0.reserve(n); bs0.reserve(n); bh0.reserve(n);
+  for (size_t k = 0; k < L.size(); ++k) { ep0.push_back(C[k]); cap0.push_back(C[k]); lau0.push_back(L[k]); bs0.push_back(S0[k]); bh0.push_back(H0[k]); }
+  for (size_t k = 0; k < PIc.size(); ++k) { ep0.push_back(PIc[k]); cap0.push_back(PIc[k]); lau0.push_back(R.Z); bs0.push_back(PIs[k]); bh0.push_back(PIh[k]); }
+  for (size_t k = 0; k < POe.size(); ++k) { ep0.push_back(POe[k]); cap0.push_back(R.Z); lau0.push_back(POl[k]); bs0.push_back(POs[k]); bh0.push_back(POh[k]); }
+  std::vector<int64_t> ord(n);
+  std::iota(ord.begin(), ord.end(), 0);
+  std::stable_sort(ord.begin(), ord.end(), [&](int64_t a, int64_t b) { return ep0[a] < ep0[b]; });
+  R.ep.resize(n); R.cap.resize(n); R.lau.resize(n); R.bs.resize(n); R.bh.resize(n);
+  for (size_t k = 0; k < n; ++k) { R.ep[k] = ep0[ord[k]]; R.cap[k] = cap0[ord[k]]; R.lau[k] = lau0[ord[k]]; R.bs[k] = bs0[ord[k]]; R.bh[k] = bh0[ord[k]]; }
+  for (size_t k = 0; k < n; ++k)
+    if (k == 0 || R.ep[k] != R.ep[k - 1]) { R.seg_ep.push_back(R.ep[k]); R.seg_st.push_back((int64_t) k); }
+  for (size_t s = 0; s < R.seg_st.size(); ++s) R.seg_en.push_back(s + 1 < R.seg_st.size() ? R.seg_st[s + 1] : (int64_t) n);
+  R.ep_pos.assign(R.NE, -1);
+  for (size_t s = 0; s < R.seg_ep.size(); ++s) R.ep_pos[R.seg_ep[s]] = (int64_t) s;
+  csr(R.lau, R.NR + 1, R.byl, R.byl_p);
+  csr(R.cap, R.NR + 1, R.byc, R.byc_p);
+  std::vector<double> zero(R.P + R.F, 0.0);
+  R.full_replay(zero, R.su_b, R.ho_b);
+  R.summ(R.su_b, R.ho_b, R.b_st, R.b_sw, R.b_ht, R.b_hw);
+  return R;
+}
+
+void Replay::full_replay(const std::vector<double>& d, std::vector<double>& su, std::vector<double>& ho) const
+{
+  std::vector<double> dx(d);
+  dx.push_back(0.0);
+  su.assign(NE, INFINITY); ho.assign(NE, INFINITY);
+  for (size_t s = 0; s < seg_ep.size(); ++s) {
+    double ms = INFINITY, mh = INFINITY;
+    bool first = true;
+    for (int64_t g = seg_st[s]; g < seg_en[s]; ++g) {
+      double vs = bs[g] + dx[cap[g]] - dx[lau[g]];
+      double vh = bh[g] - dx[cap[g]] + dx[lau[g]];
+      if (first) { ms = vs; mh = vh; first = false; }
+      else { if (vs < ms) ms = vs; if (vh < mh) mh = vh; }
+    }
+    su[seg_ep[s]] = ms; ho[seg_ep[s]] = mh;
+  }
+}
+
+void Replay::summ(const std::vector<double>& su, const std::vector<double>& ho, double& st, double& sw, double& ht, double& hw) const
+{
+  std::vector<double> fs, fh;
+  for (double v : su) if (std::isfinite(v)) fs.push_back(v);
+  for (double v : ho) if (std::isfinite(v)) fh.push_back(v);
+  std::vector<double> ms(fs.size()), mh(fh.size());
+  for (size_t i = 0; i < fs.size(); ++i) ms[i] = std::min(fs[i], 0.0);
+  for (size_t i = 0; i < fh.size(); ++i) mh[i] = std::min(fh[i], 0.0);
+  st = np_sum(ms); sw = np_min(fs); ht = np_sum(mh); hw = np_min(fh);
+}
+
+std::pair<double, bool> Replay::cgain(const std::vector<int>& mem, const std::vector<double>& x)
+{
+  NCG++;
+  return cgain_quiet(mem, x);
+}
+
+std::pair<double, bool> Replay::cgain_quiet(const std::vector<int>& mem, const std::vector<double>& x) const
+{
+  std::vector<int64_t> eps;
+  for (int r : mem) {
+    for (int64_t k = byl_p[r]; k < byl_p[r + 1]; ++k) eps.push_back(ep[byl[k]]);
+    for (int64_t k = byc_p[r]; k < byc_p[r + 1]; ++k) eps.push_back(ep[byc[k]]);
+  }
+  if (eps.empty()) return {0.0, true};
+  std::sort(eps.begin(), eps.end());
+  eps.erase(std::unique(eps.begin(), eps.end()), eps.end());
+  std::unordered_map<int64_t, double> dxc;
+  for (size_t i = 0; i < mem.size(); ++i) dxc[mem[i]] = x[i];
+  auto dxof = [&](int64_t r) { auto it = dxc.find(r); return it == dxc.end() ? 0.0 : it->second; };
+  size_t m = eps.size();
+  std::vector<double> ds(m), dh(m);
+  double mins = INFINITY, minh = INFINITY;
+  for (size_t j = 0; j < m; ++j) {
+    int64_t k = ep_pos[eps[j]];
+    double ns = 0, nh = 0;
+    bool first = true;
+    for (int64_t g = seg_st[k]; g < seg_en[k]; ++g) {
+      double dc = dxof(cap[g]), dl = dxof(lau[g]);
+      double vs = bs[g] + dc - dl, vh = bh[g] - dc + dl;
+      if (first) { ns = vs; nh = vh; first = false; }
+      else { if (vs < ns) ns = vs; if (vh < nh) nh = vh; }
+    }
+    ds[j] = std::min(ns, 0.0) - std::min(su_b[eps[j]], 0.0);
+    dh[j] = std::min(nh, 0.0) - std::min(ho_b[eps[j]], 0.0);
+    if (ns < mins) mins = ns;
+    if (nh < minh) minh = nh;
+  }
+  double g = np_sum(ds) + np_sum(dh);
+  bool ok = mins >= b_sw - SETUP_TOL && minh >= b_hw - HOLD_TOL;
+  return {g, ok};
+}
