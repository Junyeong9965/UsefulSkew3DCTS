+    {
+      std::istringstream du(envS("CTS_REFINE_DONT_USE", envS("DONT_USE_CELLS", "")));
+      std::string tok;
+      while (du >> tok) dontUse.push_back(tok);
+    }
+    std::ofstream adm(rd + "/refine_resize_masters.csv");
+    adm << "master,family,width_dbu,tier,admitted,blocked_by\n";
+    int blocked = 0;
+    for (odb::dbLib* lib : db->getLibs()) {
+      for (odb::dbMaster* m : lib->getMasters()) {
+        sta::LibertyCell* lc = network->libertyCell(network->dbToSta(m));
+        if (!(lc && lc->isBuffer())) continue;
