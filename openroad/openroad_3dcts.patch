+              if (sf == famMasters.end()) continue;
+              odb::dbMaster* up = nullptr;
+              for (odb::dbMaster* m2 : sf->second) {  // family list is sorted by width
+                if (m2->getWidth() > sm->getWidth() && m2->getHeight() == sm->getHeight()
+                    && tierOf(m2->getName()) == tierOf(sm->getName()) && pinSig(m2) == pinSig(sm)) { up = m2; break; }
+              }
+              int sx, sy; odb::dbOrientType so = s2.inst->getOrient();
+              if (!up || !findSite(s2.inst, up->getWidth(), up->getHeight(), tierOf(up->getName()), sx, sy, so)) continue;
+              CoSib cs{static_cast<int>(j), sm, 0, 0, s2.inst->getOrient()};
+              s2.inst->getLocation(cs.x0, cs.y0);
+              occDel(s2.inst);
+              if (!s2.inst->swapMaster(up)) { occAdd(s2.inst); continue; }
+              s2.inst->setOrient(so);
+              s2.inst->setLocation(sx, sy);
+              occAdd(s2.inst);
+              ev.touchInst(s2.inst);
+              coSibs.push_back(cs);
+            }
+            occDel(n.inst);
+            if (coSibs.empty()) {  // nothing to step: identical to the plain twin, undo and skip
+              n.inst->swapMaster(oldMaster); n.inst->setOrient(oldOrient); n.inst->setLocation(oldX, oldY);
+              ev.touchInst(n.inst); occAdd(n.inst);
+              continue;
+            }
+          }
+        } else {  // pin-remap: new instance on the same nets, old one detached
+          rzInst = odb::dbInst::create(block, c.newMaster,
+                                       (n.inst->getName() + "_rz" + std::to_string(candId + 1)).c_str());
+          rzInst->setOrient(no);
+          rzInst->setLocation(nx, ny);
+          rzInst->setPlacementStatus(odb::dbPlacementStatus::PLACED);
+          for (odb::dbITerm* t : rzInst->getITerms()) {
+            if (t->getSigType().isSupply()) continue;
+            (t->getIoType() == odb::dbIoType::OUTPUT ? rzOut : rzIn) = t;
+          }
+          n.in->disconnect();
+          n.out->disconnect();
+          rzIn->connect(n.inNet);
+          rzOut->connect(n.outNet);
+          ev.touchNet(n.inNet);  // the two nets change a pin (position and cap)
+          ev.touchNet(n.outNet);
+        }
+      }
+      // apply: move every load of outNet (bypass) or only the listed sinks to inNet
+      std::vector<odb::dbITerm*> loads;
+      if (c.newMaster) {
+        // connectivity unchanged
+      } else if (c.sinkKind) {
+        for (int si : c.moveSinks) {
+          loads.push_back(sinks[si].clk);
+        }
+      } else {
+        for (odb::dbITerm* t : n.outNet->getITerms()) {
+          if (t != n.out) {
+            loads.push_back(t);
+          }
+        }
+      }
+      if (loads.empty() && !c.newMaster) {
+        bypassed.insert(c.node);  // already empty: nothing to do
+        continue;
+      }
+      const std::vector<Sink> before = sinks;
+      auto te0 = now();
+      for (odb::dbITerm* t : loads) {
+        t->disconnect();
+        t->connect(n.inNet);
+      }
+      if (!loads.empty()) {  // source and destination net of the moved loads
+        ev.touchNet(n.outNet);
+        ev.touchNet(n.inNet);
+      }
+      tEdit += secs(te0);
+      const Metrics m = measure("cand" + std::to_string(candId + 1));
+      ++candId;
+      double gmin = 1e9;
+      std::string reason;
+      for (const Guard& g : guards) {
+        const double s = slackPs(g.pin, g.mm);
+        gmin = std::min(gmin, s);
+        if (s < guardPs && s < g.parent - 0.02) {
+          reason = "guard " + g.name;
+        }
+      }
+      if (reason.empty() && m.ht - cur.ht <= minGain) reason = "hold TNS gain below threshold";
+      if (reason.empty() && m.hw < (wnsVsCurrent ? cur.hw : parent.hw) - hwTol) reason = "hold WNS below reference";
+      if (reason.empty() && m.sw < parent.sw - swTol) reason = "setup WNS below parent";
+      if (reason.empty() && parent.st - m.st > budget) reason = "cumulative setup TNS loss above budget";
+      if (reason.empty() && maxSetupPerHold > 0 && (cur.st - m.st) > maxSetupPerHold * (m.ht - cur.ht))
+        reason = "setup loss per hold gain above exchange rate";
+      if (reason.empty() && (m.slew > parent.slew || m.cap > parent.cap || m.fo > parent.fo))
+        reason = "electrical violators increased";
+      const bool keep = reason.empty();
+      cand << candId << ',' << (c.newMaster ? std::string(c.co ? "coresize" + std::to_string(coSibs.size()) + ":" : "resize:") + oldMaster->getName() + ">" + c.newMaster->getName() + "@" + std::to_string((rzInst ? rzInst : n.inst)->getBBox()->xMin() - oldX) + "/" + std::to_string((rzInst ? rzInst : n.inst)->getBBox()->yMin() - oldY) : std::string(c.sinkKind ? "sink" : (c.leaf ? "leaf" : "internal"))) << ',' << n.inst->getName() << ','
+           << n.outNet->getName() << ',' << n.inNet->getName() << ',' << n.subtreeSinks.size()
+           << ',' << loads.size() << ',' << c.loss << ',' << m.st << ',' << m.sw << ',' << m.ht
+           << ',' << m.hw << ',' << m.slew << ',' << m.cap << ',' << m.fo << ',' << gmin << ','
+           << (keep ? "KEEP" : "ROLLBACK") << ',' << (keep ? "accepted" : reason) << ','
+           << secs(tSel) << '\n';
+      cand.flush();
+      logger->info(CTS, 992,
+                   "Clock refinement cand {} {} {} ({} sinks, loss {:.1f}): setup {:.1f}/{:.2f} hold "
+                   "{:.1f}/{:.2f} slew/cap/fo {}/{}/{} -> {}",
+                   candId, c.newMaster ? "resize" : (c.sinkKind ? "sink" : (c.leaf ? "leaf" : "internal")), n.inst->getName(),
+                   n.subtreeSinks.size(), c.loss, m.st, m.sw, m.ht, m.hw, m.slew, m.cap, m.fo,
+                   keep ? "KEEP" : "ROLLBACK (" + reason + ")");
+      if (keep) {
+        // audit: subtree sinks + one-level siblings (sinks under the parent net's other children)
+        std::set<int> affected(n.subtreeSinks.begin(), n.subtreeSinks.end());
+        if (c.sinkKind) {
+          affected = std::set<int>(c.moveSinks.begin(), c.moveSinks.end());
+        }
+        std::set<int> sib;
+        if (c.sinkKind) {  // true siblings: the sinks left on the same net
+          for (int si : n.subtreeSinks) {
+            if (!affected.count(si)) {
+              sib.insert(si);
+            }
+          }
+        } else if (n.parent >= 0) {
+          for (int si : nodes[n.parent].subtreeSinks) {
+            if (!affected.count(si)) {
+              sib.insert(si);
+            }
+          }
+        }
+        auto row = [&](const char* role, int si) {
+          const Sink &a = before[si], &b = sinks[si];
+          sk << candId << ',' << role << ',' << a.inst->getName() << ',' << a.arrE << ',' << b.arrE
+             << ',' << a.arrL << ',' << b.arrL << ',' << a.hold << ',' << b.hold << ',' << a.setup
+             << ',' << b.setup << '\n';
+        };
+        for (int si : affected) row("bypassed", si);
+        for (int si : sib) row("sibling", si);
+        sk.flush();
+        // the bypassed buffer's subtree is now attached one level up
+        cur = m;
+        ++kept;
+        if (c.newMaster) {  // structure unchanged; the new span is now occupied
+          if (rzInst) {
+            odb::dbInst::destroy(n.inst);
+            n.inst = rzInst;
+            n.in = rzIn;
+            n.out = rzOut;
+          }
+          occAdd(n.inst);
+          triedSink.clear();  // a stronger driver may make rejected sink bundles pass
+          progress = true;
+          break;
+        }
+        if (c.sinkKind) {  // moved sinks now hang on the parent's net
+          triedSink.clear();  // the hold WNS reference moved: rejected bundles may pass now
+          auto gone = [&](int si) { return affected.count(si) > 0; };
+          n.sinks.erase(std::remove_if(n.sinks.begin(), n.sinks.end(), gone), n.sinks.end());
+          n.subtreeSinks.erase(std::remove_if(n.subtreeSinks.begin(), n.subtreeSinks.end(), gone),
+                               n.subtreeSinks.end());
+          if (n.parent >= 0) {
+            nodes[n.parent].sinks.insert(nodes[n.parent].sinks.end(), c.moveSinks.begin(),
+                                         c.moveSinks.end());
+          }
+          progress = true;
+          break;
+        }
+        bypassed.insert(c.node);
+        if (n.parent >= 0) {
+          Node& p = nodes[n.parent];
+          for (int cb : n.childBufs) {
+            nodes[cb].parent = n.parent;
+            p.childBufs.push_back(cb);
+          }
+          p.sinks.insert(p.sinks.end(), n.sinks.begin(), n.sinks.end());
+          p.childBufs.erase(std::remove(p.childBufs.begin(), p.childBufs.end(), c.node), p.childBufs.end());
+        }
+        n.childBufs.clear();
+        n.sinks.clear();
+        n.subtreeSinks.clear();
+        progress = true;
+        break;  // re-rank with the new structure
+      }
+      // rollback
+      auto tb0 = now();
+      struct RollTimer { double& acc; std::chrono::steady_clock::time_point t; ~RollTimer() { acc += std::chrono::duration<double>(std::chrono::steady_clock::now() - t).count(); } } rollTimer{tRoll, tb0};
+      if (c.newMaster) {
+        if (rzInst) {
+          rzIn->disconnect();
+          rzOut->disconnect();
+          odb::dbInst::destroy(rzInst);
+          n.in->connect(n.inNet);
+          n.out->connect(n.outNet);
+        } else {
+          n.inst->swapMaster(oldMaster);
+          n.inst->setOrient(oldOrient);
+          n.inst->setLocation(oldX, oldY);
+          ev.touchInst(n.inst);
+        }
+        for (const CoSib& cs : coSibs) {  // early drivers back to their master and place
+          Node& s2 = nodes[cs.node];
+          occDel(s2.inst);
+          s2.inst->swapMaster(cs.m0);
+          s2.inst->setOrient(cs.o0);
+          s2.inst->setLocation(cs.x0, cs.y0);
+          occAdd(s2.inst);
+          ev.touchInst(s2.inst);
+        }
+        ev.touchNet(n.inNet);
+        ev.touchNet(n.outNet);
+        occAdd(n.inst);
+        sinks = before;
+        continue;
+      }
+      for (odb::dbITerm* t : loads) {
+        t->disconnect();
+        t->connect(n.outNet);
+      }
+      ev.touchNet(n.outNet);
+      ev.touchNet(n.inNet);
+      sinks = before;
+      if (c.sinkKind) {
+        triedSink.insert(sinkSig(c.node, c.moveSinks));
+      } else {
+        triedBypass.insert(c.node);  // do not retry the same single action
+      }
+    }
+  }
+  const double selSec = secs(tSel);
+  {
+    std::ofstream tf(rd + "/refine_timing.csv");
+    tf << "measure_calls,rc_estimate_s,sta_first_query_s,sta_other_queries_s,sink_scan_s,rank_s,edit_s,rollback_edit_s,baseline_s,selector_s\n"
+       << staRuns << ',' << ev.t.rcFull + ev.t.rcIncr << ',' << ev.t.staFirst << ','
+       << ev.t.staRest + ev.t.limits + ev.t.reqOnce << ',' << ev.t.scanArr + ev.t.scanSlack << ',' << tRank << ','
+       << tEdit << ',' << tRoll << ',' << baseSec << ',' << selSec << '\n';
+  }
+  // Final state check (after a rollback the timer is stale): whole-design
+  // estimation and full read-out.  The TNS terms use a relative tolerance:
+  // OpenSTA returns TNS as a float (Search::totalNegativeSlack), and the kept
+  // (incremental) and final (whole-design) sums differ in summation order, so
+  // they may differ by whole float32 rounding steps on large designs.
+  // Tolerance = max(0.01 ps, 4 float32 ULPs at the larger |TNS|); WNS (a single
+  // path sum) keeps 0.01 ps.
+  const sel::Timers selT = ev.t;
+  const auto tFin = now();
+  const Metrics fin = measure("final", true);
+  const double finSec = secs(tFin);
+  auto f32UlpPs = [](double ps) {
+    const double s = std::abs(ps) * 1e-12;
+    return s > 0.0 ? std::ldexp(1.0, std::ilogb(s) - 23) * 1e12 : 0.0;
+  };
+  auto tnsTol = [&](double a, double b) { return std::max(0.01, 4.0 * f32UlpPs(std::max(std::abs(a), std::abs(b)))); };
+  const double d = std::max({std::abs(fin.st - cur.st), std::abs(fin.sw - cur.sw),
+                             std::abs(fin.ht - cur.ht), std::abs(fin.hw - cur.hw)});
+  const bool bad = std::abs(fin.st - cur.st) > tnsTol(fin.st, cur.st) || std::abs(fin.ht - cur.ht) > tnsTol(fin.ht, cur.ht)
+                   || std::abs(fin.sw - cur.sw) > 0.01 || std::abs(fin.hw - cur.hw) > 0.01;
+  if (bad) {
+    logger->error(CTS, 993, "Clock refinement: final state differs from the kept state by {:.4f} ps", d);
+  } else if (d > 0.01) {
+    logger->info(CTS, 2095, "Clock refinement: final state within the relative TNS tolerance of the kept state "
+                 "(max difference {:.4f} ps; setup TNS {:.1f} / {:.1f}, hold TNS {:.1f} / {:.1f} ps)",
+                 d, fin.st, cur.st, fin.ht, cur.ht);
+  }
+  if (fin.slew != cur.slew || fin.cap != cur.cap || fin.fo != cur.fo) {
+    logger->error(CTS,
+                  998,
+                  "Clock refinement: final violator counts {}/{}/{} differ from the kept state "
+                  "{}/{}/{}",
+                  fin.slew, fin.cap, fin.fo, cur.slew, cur.cap, cur.fo);
+  }
+  logger->info(CTS,
+               997,
+               "Clock refinement evaluations full/incremental {}/{}; final whole-design check "
+               "differs from the kept state by {:.6f} ps (counts equal); selector {:.1f} s, "
+               "final check {:.1f} s",
+               selT.nFull, selT.nIncr, d, selSec, finSec);
+  {
+    std::ofstream tf(rd + "/refine_eval_stats.csv");
+    tf.precision(9);
+    tf << "evals_full,evals_incr,rc_full_s,rc_incr_s,sta_first_query_s,tns_wns_rest_s,"
+          "limits_s,scan_arrival_s,scan_slack_s,rank_s,edit_s,rollback_edit_s,"
+          "requireds_once_s,baseline_s,selector_s,final_check_s,touched_nets,"
+          "slew_dirty_nets,limit_recount_nets,final_vs_kept_max_abs_diff_ps\n"
+       << selT.nFull << ',' << selT.nIncr << ',' << selT.rcFull << ',' << selT.rcIncr << ','
+       << selT.staFirst << ',' << selT.staRest << ',' << selT.limits << ',' << selT.scanArr
+       << ',' << selT.scanSlack << ',' << tRank << ',' << tEdit << ',' << tRoll << ','
+       << selT.reqOnce << ',' << baseSec << ',' << selSec << ',' << finSec << ','
+       << selT.touchedNets << ',' << selT.slewDirtyNets << ',' << selT.limitNets << ','
+       << d << '\n';
+  }
+  ev.finish();
+  {
+    std::ofstream out(rd + "/refine_summary.csv");
+    out.precision(9);
+    out << "candidates,kept,sta_runs,baseline_s,selector_s,total_s,parent_setup_tns,parent_setup_wns,"
+           "parent_hold_tns,parent_hold_wns,final_setup_tns,final_setup_wns,final_hold_tns,"
+           "final_hold_wns,parent_slew,parent_cap,parent_fo,final_slew,final_cap,final_fo,"
+           "setup_tns_budget_ps\n";
+    out << candId << ',' << kept << ',' << staRuns << ',' << baseSec << ',' << selSec << ','
+        << secs(t0) << ',' << parent.st << ',' << parent.sw << ',' << parent.ht << ',' << parent.hw
+        << ',' << fin.st << ',' << fin.sw << ',' << fin.ht << ',' << fin.hw << ',' << parent.slew
+        << ',' << parent.cap << ',' << parent.fo << ',' << fin.slew << ',' << fin.cap << ','
+        << fin.fo << ',' << budget << '\n';
+  }
+  logger->info(CTS, 994,
+               "Clock refinement done: {} candidates, {} kept; setup {:.1f}/{:.2f} hold {:.1f}/{:.2f} "
+               "ps; slew/cap/fo {}/{}/{}; selector {:.1f} s",
+               candId, kept, fin.st, fin.sw, fin.ht, fin.hw, fin.slew, fin.cap, fin.fo, selSec);
+}
+
+// Stage Q (buffer_relocation.tcl): whole-design setup/hold TNS/WNS (ps) after instance moves, with the incremental
+// placement parasitics of the refinement (sel::Eval).  moved = names of the instances moved (or moved back) since the
+// previous call, separated by blanks.  mode 0: whole-design estimation (first call), 1: re-estimate only the nets
+// on a pin of a moved instance, 2: end (disable incremental parasitics, returns "").  Returns "st sw ht hw".
+static std::unique_ptr<sel::Eval> g_relocEval;
+std::string relocEvalMetrics(odb::dbDatabase* db,
+                             sta::dbSta* sta,
+                             sta::dbNetwork* network,
+                             est::EstimateParasitics* est,
+                             utl::Logger* logger,
+                             const std::string& moved,
+                             int mode)
+{
+  if (mode == 2) {
+    if (g_relocEval) {
+      g_relocEval->finish();
+      g_relocEval.reset();
+    }
+    return "";
+  }
+  if (!g_relocEval) {
+    g_relocEval = std::make_unique<sel::Eval>(db, sta, network, est, logger, "", "");
+  }
+  odb::dbBlock* block = db->getChip()->getBlock();
+  std::istringstream ss(moved);
+  std::string name;
+  while (ss >> name) {
+    odb::dbInst* inst = block->findInst(name.c_str());
+    if (inst == nullptr) {
+      logger->error(utl::CTS, 2130, "relocEvalMetrics: instance {} not found", name);
+    }
+    g_relocEval->touchInst(inst);
+  }
+  g_relocEval->rc(mode == 0);
+  double st, sw, ht, hw;
+  g_relocEval->tnsWns(st, sw, ht, hw, false);
+  return fmt::format("{:.17g} {:.17g} {:.17g} {:.17g}", st, sw, ht, hw);
+}
+
+}  // namespace cts
