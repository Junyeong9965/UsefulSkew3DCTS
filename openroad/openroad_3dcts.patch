+        for (const std::string& g : dontUse) {
+          if (fnmatch(g.c_str(), m->getName().c_str(), 0) == 0) { by = g; break; }
+        }
+        adm << m->getName() << ',' << family(m->getName()) << ',' << m->getWidth() << ','
