+    for (auto it = std::lower_bound(rowYs.begin(), rowYs.end(), yl - rowH + 1); it != rowYs.end() && *it < yh; ++it) f(*it);
+  };
+  auto occAdd = [&](odb::dbInst* inst) {
+    odb::Rect b = inst->getBBox()->getBox();
+    const int t = tierOf(inst->getMaster()->getName());
+    forRows(b.yMin(), b.yMax(), [&](int y) { occ[y].push_back({b.xMin(), b.xMax(), t, inst}); });
+  };
+  auto occDel = [&](odb::dbInst* inst) {
+    odb::Rect b = inst->getBBox()->getBox();
+    forRows(b.yMin(), b.yMax(), [&](int y) {
+      auto& v = occ[y];
+      v.erase(std::remove_if(v.begin(), v.end(), [&](const Seg& s) { return s.inst == inst; }), v.end());
+    });
+  };
