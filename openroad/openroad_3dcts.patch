+std::shared_ptr<const Graph> load_graph(const std::string& gdir)
+{
+  static std::mutex mu;
+  static std::map<std::string, std::pair<std::string, std::shared_ptr<const Graph>>> cache;
+  std::string dir = file_exists(join_path(gdir, "pre_cts_ff_timing_graph.csv")) ? dirname_of(join_path(gdir, "pre_cts_ff_timing_graph.csv")) : gdir;
+  std::string key = file_key(join_path(gdir, "pre_cts_ff_timing_graph.csv")) + "|" + file_key(join_path(gdir, "pre_cts_io_timing_edges.csv"));
+  std::string canon = realpath_exists(gdir);
+  std::lock_guard<std::mutex> lock(mu);
+  auto it = cache.find(canon);
+  if (it != cache.end() && it->second.first == key) return it->second.second;
+  auto g = std::make_shared<const Graph>(parse_graph(gdir));
+  cache[canon] = {key, g};
+  return g;
+}
