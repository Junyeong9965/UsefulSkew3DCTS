+// Register -> register timing graph (native constrained PathEnds of OpenSTA).
+void TritonCTS::extractFFGraphFromODB(const std::string& output_file)
+{
+  logger_->report("Register timing graph extraction -> {}", output_file);
+
+  TimingGraphExtractor extractor(getBlock(), openSta_, network_, logger_);
+  if (cts3dDb_) {
+    extractor.setCts3DDatabase(cts3dDb_.get());
+  }
+
+  extractor.collectRegisters();
+
+  auto edges = extractor.extractRegisterEdges();
+  extractor.writeCSV(edges, output_file);
+
+  logger_->report("Register timing graph written to {}", output_file);
+}
+
+// IO edges (input port -> register, register -> output port).  When it runs
+// right after extract_ff_timing_graph_odb with EXTRACT_REUSE_FF_PO=1, the
+// register -> output-port ends stashed by that command are replayed.
+void TritonCTS::extractIOTimingEdgesFromODB(const std::string& output_file)
+{
+  logger_->report("IO timing edge extraction -> {}", output_file);
+
+  TimingGraphExtractor extractor(getBlock(), openSta_, network_, logger_);
+  if (cts3dDb_) {
+    extractor.setCts3DDatabase(cts3dDb_.get());
+  }
+
+  extractor.collectRegisters();
+  auto io_edges = extractor.extractIOEdges();
+  extractor.writeIOCSV(io_edges, output_file);
+
+  logger_->report("IO timing edges written to {}", output_file);
+}
+
+// Skew-scheduling LP.  Graph inputs: $RESULTS_DIR/pre_cts_ff_timing_graph.csv
+// and $RESULTS_DIR/pre_cts_io_timing_edges.csv.  The targets are stored in the
+// tier database (used by the next clock_tree_synthesis) and written to
+// $RESULTS_DIR/pre_cts_skew_targets.csv.
+void TritonCTS::solveSkewLp(float sigma_local,
+                            float sigma_pi,
+                            float lambda_reg,
+                            float hold_margin,
+                            float gamma_wns,
+                            float weight_io,
+                            float max_skew)
+{
+  if (!cts3dDb_) {
+    cts3dDb_ = std::make_unique<Cts3DDatabase>(db_, logger_);
+    cts3dDb_->populate();
+  }
+
+  auto* block = db_->getChip()->getBlock();
+
+  CtsSkewLpSolver lp_solver(block, openSta_, network_, logger_, cts3dDb_.get());
+
+  LpParams params;
+  params.sigma_local = sigma_local;
+  params.sigma_pi = sigma_pi;
+  params.lambda_reg = lambda_reg;
+  params.hold_margin = hold_margin;
+  params.gamma_wns = gamma_wns;
+  params.weight_io = weight_io;
+  params.max_skew = max_skew;
+  lp_solver.setParams(params);
+
+  const char* results_dir = std::getenv("RESULTS_DIR");
+  const std::string res_base = results_dir ? std::string(results_dir) : ".";
+  const std::string graph_csv = res_base + "/pre_cts_ff_timing_graph.csv";
+  const std::string io_csv = res_base + "/pre_cts_io_timing_edges.csv";
+  const std::string targets_csv = res_base + "/pre_cts_skew_targets.csv";
+
+  // One LP over all registers of all clock nets: CTS may split one SDC clock
+  // into several clock nets (macro / register trees), and their paths share
+  // the same constraints.
+  lp_solver.readTimingGraphCSV(graph_csv);
+  lp_solver.readIOEdgesCSV(io_csv);
+  lp_solver.computeBounds();
+  lp_solver.applyPiHoldClip();
+
+  LpResult result = lp_solver.solveTns();
+
+  cts3dDb_->clearSkewTargets();
+  for (const auto& [ff_name, arrival_ns] : result.arrivals) {
+    cts3dDb_->setSkewTarget(ff_name, arrival_ns);
+  }
+
+  logger_->info(utl::CTS,
+                609,
+                "Skew LP: stored {} skew targets ({} non-zero)",
+                result.n_ffs,
+                result.n_nonzero_targets);
+
+  lp_solver.writeTargetsCSV(targets_csv);
+}
+
+// Per-register physical latency bounds from the hybrid-bond via parasitics
+// (t_via = 0.693 R_HB C_HB): bottom tier t_max = max_skew, upper tier
+// t_max = max_skew + t_via.
+void TritonCTS::estimateLeafLatencies(const std::string& output_csv,
+                                      double max_skew_ns)
+{
+  if (!cts3dDb_) {
+    cts3dDb_ = std::make_unique<Cts3DDatabase>(db_, logger_);
+    cts3dDb_->populate();
+  }
+
+  cts3dDb_->loadHybridBondParasitics();
+
+  ClockLatencyEstimator estimator(cts3dDb_.get());
+  estimator.estimateAndWrite(output_csv, max_skew_ns);
+
+  const double t_via_ps = estimator.getViaDelayNs() * 1.0e3;
+  logger_->report(
+      "estimate_leaf_latencies: t_via = {:.2f} ps, max_skew = {:.0f} ps, "
+      "written to {}",
+      t_via_ps,
+      max_skew_ns * 1.0e3,
+      output_csv);
+}
+
+void TritonCTS::runClockRefinement()
+{
+  cts::runClockRefinement(
+      db_, openSta_, network_, estimate_parasitics_, logger_);
+}
+
+std::string TritonCTS::relocEvalMetrics(const std::string& moved, int mode)
+{
+  return cts::relocEvalMetrics(
+      db_, openSta_, network_, estimate_parasitics_, logger_, moved, mode);
+}
+
+void TritonCTS::predictClockArrivals(const char* output_csv)
+{
+  runStagePredictor(db_, openSta_, logger_, output_csv);
+}
+
 }  // namespace cts
