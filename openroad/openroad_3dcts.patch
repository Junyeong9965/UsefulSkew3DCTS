+      std::sort(v.begin(), v.end(), [](odb::dbMaster* a, odb::dbMaster* b) {
+        return a->getWidth() != b->getWidth() ? a->getWidth() < b->getWidth() : a->getName() < b->getName(); });
+    }
+    std::set<int> ys;
+    for (odb::dbRow* r : block->getRows()) {
+      odb::Rect b = r->getBBox();
+      rows.push_back({b.xMin(), b.yMin(), b.xMax(), b.yMax(), static_cast<int>(r->getSite()->getWidth()), r->getOrient()});
+      ys.insert(b.yMin());
+      rowH = std::max(rowH, static_cast<int>(b.dy()));
+    }
+    rowYs.assign(ys.begin(), ys.end());
+    for (odb::dbInst* inst : block->getInsts()) {
