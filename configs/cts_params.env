# Settings shared by every OpenROAD session of the flow (sourced by flow/*.sh after orfs/env.sh).
# Stage-specific settings are set by flow/stage.sh, per-case settings come from configs/cases.tsv.
# The fixed configuration of the flow is part of the scripts.

# platform configuration (orfs/platforms/*/config.mk selects the 2A6M technology files for USE_FLOW=openroad)
export USE_FLOW=openroad
export FLOW_VARIANT=openroad
export HETEROGENEOUS_3D="${HETEROGENEOUS_3D:-0}"   # 1 for asap7_nangate45_3D (set by flow/common.sh)

# graph files read by the hold-budget loader of the CTS engine (cts_3d.tcl points them at the stage-G graph)
export CTS_TIMING_GRAPH_CSV="${RESULTS_DIR}/pre_cts_ff_timing_graph.csv"
export CTS_IO_TIMING_CSV="${RESULTS_DIR}/pre_cts_io_timing_edges.csv"
